#compdef wavreverse
_arguments \
  '(-m --mp3)'{-m,--mp3}'[output as MP3 instead of WAV]' \
  '--format[output format (wav or mp3)]:format:(wav mp3)' \
  '(-b --bitrate)'{-b,--bitrate}'[MP3 bitrate in kbps]:kbps' \
  '(-o --output-dir)'{-o,--output-dir}'[output directory]:directory:_files -/' \
  '(-f --force)'{-f,--force}'[overwrite existing output]' '(-n --dry-run)'{-n,--dry-run}'[show planned output]' \
  '*:WAV file:_files -g "*.wav(-.)"'
