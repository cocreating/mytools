#compdef wavtrim
_arguments \
  '(-t --threshold)'{-t,--threshold}'[silence threshold in dB]:dB' \
  '(-s --start-only)'{-s,--start-only}'[trim leading silence only]' \
  '(-e --end-only)'{-e,--end-only}'[trim trailing silence only]' \
  '(-o --output-dir)'{-o,--output-dir}'[output directory]:directory:_files -/' \
  '(-f --force)'{-f,--force}'[overwrite existing output]' '(-n --dry-run)'{-n,--dry-run}'[show planned output]' \
  '*:WAV file:_files -g "*.wav(-.)"'
