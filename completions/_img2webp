#compdef img2webp

_arguments \
  '(-q --quality)'{-q,--quality}'[Quality 0-100 (default: 85)]:quality' \
  '(-w --width)'{-w,--width}'[Resize width (keeps aspect ratio)]:width (px)' \
  '(-H --height)'{-H,--height}'[Resize height (keeps aspect ratio)]:height (px)' \
  '(-r --resize)'{-r,--resize}'[Exact resize dimensions (WxH)]:dimensions' \
  '(-l --lossless)'{-l,--lossless}'[Lossless encoding (ignores quality)]' \
  '(-o --output-dir)'{-o,--output-dir}'[Write output to this directory]:output directory:_files -/' \
  '(-R --recursive)'{-R,--recursive}'[Recursively process directories]' \
  '(-j --jobs)'{-j,--jobs}'[Parallel jobs]:number of jobs' \
  '(-f --force)'{-f,--force}'[Overwrite existing output files]' \
  '(-n --dry-run)'{-n,--dry-run}'[Show what would be done without converting]' \
  '(-d --delete-original)'{-d,--delete-original}'[Remove original files after successful conversion]' \
  '(-v --verbose)'{-v,--verbose}'[Show detailed cwebp output]' \
  '(-h --help)'{-h,--help}'[Show help]' \
  '*:image file:_files -g "*.(jpg|jpeg|png|gif|bmp|tiff|tif|heic|heif|webp)(-.)"'
