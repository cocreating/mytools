#compdef ytdl

# ytdl is fully interactive, no complex arguments needed, but we can support URL autocomplete or help
_arguments \
  '(-f --format)'{-f,--format}'[output format]:format:(mp4 webm mp3 wav)' \
  '(-o --output-dir)'{-o,--output-dir}'[output directory]:directory:_files -/' \
  '--playlist[download a playlist]' '--subtitles[download subtitles]' \
  '(-h --help)'{-h,--help}'[Show help]' '1:URL:_urls'
