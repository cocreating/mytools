#compdef wavfade
_arguments \
  '(-i --in)'{-i,--in}'[fade-in duration in seconds]:seconds' \
  '(-o --out)'{-o,--out}'[fade-out duration in seconds]:seconds' \
  '(-c --curve)'{-c,--curve}'[fade curve type]:curve:(tri qsin esin hsin log exp)' \
  '(-m --mp3)'{-m,--mp3}'[output as MP3 instead of WAV]' \
  '--format[output format (wav or mp3)]:format:(wav mp3)' \
  '(-b --bitrate)'{-b,--bitrate}'[MP3 bitrate in kbps]:kbps' \
  '(-d --output-dir)'{-d,--output-dir}'[output directory]:directory:_files -/' \
  '(-f --force)'{-f,--force}'[overwrite existing output]' '(-n --dry-run)'{-n,--dry-run}'[show planned output]' \
  '*:WAV file:_files -g "*.wav(-.)"'
