#!/usr/bin/env bash
set -euo pipefail

usage() { cat <<'EOF'
Usage: mytools [command]

Open the interactive launcher, or run one of:
  help [tool]  Print overview or detailed guide for a tool
  guide        Interactive help browser & cheat-sheets
  doctor       Check dependencies
  config       Show/create the presets configuration

Tools: img2webp, ytdl, vidglue, vid2webm, vid2gif, videoWithoutAudio, vidoptim, vidglitch, vidcuts,
vid2audio, wav2mp3, wav2tempo, wavreverse, wavpitch, wavnorm, wavfade, wavtrim, wavfx,
media-info, thumloc, webloc2md.
EOF
}
SOURCE_PATH="${BASH_SOURCE[0]}"; while [ -h "$SOURCE_PATH" ]; do SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; SOURCE_LINK="$(readlink "$SOURCE_PATH")"; case "$SOURCE_LINK" in /*) SOURCE_PATH="$SOURCE_LINK";; *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_LINK";; esac; done; SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
case "${1:-}" in
  -h|--help|help|h) exec "$SCRIPT_DIR/mytools-guide" "${2:-}";;
  guide|g) exec "$SCRIPT_DIR/mytools-guide" --interactive;;
  doctor) exec "$SCRIPT_DIR/mytools-doctor" "${@:2}";;
  config) exec "$SCRIPT_DIR/mytools-config" "${@:2}";;
  "") ;;
  *) echo "Unknown mytools command: $1" >&2; exec "$SCRIPT_DIR/mytools-guide";;
esac
command -v fzf >/dev/null 2>&1 || { "$SCRIPT_DIR/mytools-guide"; echo "💡 Install fzf for the interactive launcher: brew install fzf"; exit 0; }
if [ -t 1 ]; then
  CURRENT_LINES=$(tput lines 2>/dev/null || echo 0)
  CURRENT_COLS=$(tput cols 2>/dev/null || echo 80)
  if [ "$CURRENT_LINES" -gt 0 ] && [ "$CURRENT_LINES" -lt 30 ]; then
    printf '\e[8;%d;%dt' 30 "$CURRENT_COLS"
    sleep 0.05 2>/dev/null || true
  fi
fi
OPTION=$(printf '%s\n' \
  'img2webp — 📸 Image to WebP' \
  'ytdl — 📥 Download web media' \
  'vidglue — 🎞️ Glue MP4 videos' 'vid2webm — 🌐 Video to WebM' 'vid2gif — 👾 Video to GIF' 'videoWithoutAudio — 🔇 Remove video audio (optional preserve tracks)' 'vidoptim — 🚀 Optimize video (web/social/archive)' 'vidglitch — ⚡ Glitch & retro visual FX' 'vidcuts — ✂️ Erase random frames / cut film' \
  'vid2audio — 🔊 Extract video audio' 'wav2mp3 — 🎧 Audio to MP3' 'wav2tempo — 🥁 Retime WAV by BPM' 'wavreverse — 🔄 Reverse WAV audio' 'wavpitch — 🎼 Shift WAV pitch' 'wavnorm — 🎚️ Normalize WAV volume' 'wavfade — 📈 Apply fade in/out' 'wavtrim — ✂️ Strip WAV silence' 'wavfx — 🎛️ WAV audio effects' \
  'media-info — 🕵️ Inspect media file' \
  'thumloc — 🖼️ Finder bookmark thumbnails' 'webloc2md — 📑 Bookmark index' \
  'guide — 📖 Interactive guide & cheat-sheets' 'doctor — 🩺 Dependency health check' 'config — ⚙️ User presets & config' | fzf --prompt='mytools > ' --height=~100% --layout=reverse --border)
[ -n "$OPTION" ] || exit 0
TOOL="${OPTION%% *}"
case "$TOOL" in
  guide) exec "$SCRIPT_DIR/mytools-guide" --interactive;; doctor) exec "$SCRIPT_DIR/mytools-doctor";; config) exec "$SCRIPT_DIR/mytools-config";;
  thumloc|webloc2md|ytdl) exec "$SCRIPT_DIR/$TOOL";;
esac
FILES=$(find . -maxdepth 1 -type f -print | sed 's#^./##' | fzf -m --prompt="${TOOL} files > " --header='💡 Press [Tab] to mark multiple files, then press [Enter] to confirm' --height=60% --layout=reverse --border)
[ -n "$FILES" ] || { echo 'Canceled.'; exit 0; }
FILE_ARRAY=(); while IFS= read -r file; do FILE_ARRAY+=("$file"); done <<< "$FILES"
if [ "$TOOL" = "vidglitch" ]; then
  PRESET_CHOICE=$(printf '%s\n' \
    'rgb-split — 🌈 Chromatic aberration (default)' \
    'vhs — 📼 Analog tape noise & vignette' \
    'crt — 📺 Arcade scanlines & RGB offset' \
    '8bit — 🕹️ Retro pixelated gaming blocks' \
    'cyberpunk — 🌆 Neon RGB split & tearing' \
    'badsignal — 📡 Heavy static & signal loss' \
    'tear — ⚡ Digital data block displacement' | fzf --prompt='vidglitch preset > ' --height=50% --layout=reverse --border || true)
  if [ -n "$PRESET_CHOICE" ]; then
    PRESET="${PRESET_CHOICE%% *}"
    TIMING_CHOICE=$(printf '%s\n' \
      'constant — 🌊 Continuous glitch (always on)' \
      'burst — 💓 Intermittent pulse/burst mode (every 2s)' | fzf --prompt='vidglitch timing > ' --height=40% --layout=reverse --border || true)
    EXTRA_FLAGS=()
    [ "${TIMING_CHOICE%% *}" = "burst" ] && EXTRA_FLAGS+=("--burst")
    exec "$SCRIPT_DIR/vidglitch" --preset "$PRESET" "${EXTRA_FLAGS[@]}" "${FILE_ARRAY[@]}"
  fi
fi
if [ "$TOOL" = "vidcuts" ]; then
  CUT_CHOICE=$(printf '%s\n' \
    '20% — ✂️ Balanced cut film (20% shorter, default)' \
    '10% — 🎞️ Subtle missing frames (10% shorter)' \
    '30% — 🎬 Energetic jump cuts (30% shorter)' \
    '50% — ⚡ Frantic staccato cuts (50% shorter)' | fzf --prompt='vidcuts percentage > ' --height=40% --layout=reverse --border || true)
  if [ -n "$CUT_CHOICE" ]; then
    PCT="${CUT_CHOICE%% *}"
    PCT="${PCT%\%}"
    exec "$SCRIPT_DIR/vidcuts" --percent "$PCT" "${FILE_ARRAY[@]}"
  fi
fi
exec "$SCRIPT_DIR/$TOOL" "${FILE_ARRAY[@]}"
