#!/bin/bash

show_help_menu() {
    echo "🧰 Jasubal's Custom Terminal Tools:"
    echo "-----------------------------------"
    echo "🎵 wav2mp3   - Convert WAV files to MP3 format."
    echo "🖼️  img2webp  - Convert and resize images to WebP format."
    echo "🎬 vid2webm  - Compress and convert MP4 video to WebM."
    echo "🌐 thumloc   - Add Finder thumbnails to .webloc files recursively."
    echo "🔊 vid2audio - Extract audio tracks from video files."
    echo "👾 vid2gif   - Convert video to optimized animated GIF."
    echo "📝 webloc2md - Compile recursive .webloc bookmarks into a Markdown index."
    echo "📥 ytdl      - Interactive media downloader (yt-dlp)."
    echo ""
}

if ! command -v fzf &> /dev/null; then
    show_help_menu
    echo "💡 Install fzf to enable interactive menus: brew install fzf"
    exit 0
fi

# Print interactive fzf menu
TOOL_OPTION=$(printf "vid2webm (MP4/MOV -> WebM)\nwav2mp3 (WAV -> MP3)\nimg2webp (JPG/PNG -> WebP)\nthumloc (.webloc thumbnails in current folder)\nvid2audio (Extract audio track from video)\nvid2gif (Convert video to optimized GIF)\nwebloc2md (Index .webloc files to Markdown)\nytdl (Interactive YouTube/Media downloader)" | fzf --prompt="Select tool > " --height=50% --layout=reverse --border)

if [ -z "$TOOL_OPTION" ]; then
    exit 0
fi

# Extract the command prefix
TOOL=$(echo "$TOOL_OPTION" | awk '{print $1}')

# Handle commands that run without picking specific files first
if [ "$TOOL" = "thumloc" ]; then
    echo "Executing: thumloc on current folder: $PWD"
    "$TOOL"
    exit $?
fi

if [ "$TOOL" = "webloc2md" ]; then
    echo "Executing: webloc2md on current folder..."
    "$TOOL"
    exit $?
fi

if [ "$TOOL" = "ytdl" ]; then
    "$TOOL"
    exit $?
fi

# Prompt for file selection using fzf for the rest of the file-processing tools
echo "You selected $TOOL. Select file(s) (Tab to multi-select, Enter to confirm):"
FILES=$(fzf -m --prompt="Select files > " --height=60% --layout=reverse --border)

if [ -z "$FILES" ]; then
    echo "Canceled."
    exit 0
fi

# Read multiline fzf output into array safely
IFS=$'\n' read -r -d '' -a FILE_ARRAY <<< "$FILES"$'\0'

echo "Executing: $TOOL on ${#FILE_ARRAY[@]} file(s)..."
"$TOOL" "${FILE_ARRAY[@]}"
