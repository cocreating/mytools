#!/usr/bin/env bash
set -euo pipefail

usage() { cat <<'EOF'
Usage: mytools [command]

Open the interactive launcher, or run one of:
  doctor       Check dependencies
  config       Show/create the presets configuration
  help         Print this help

Tools: img2webp, vid2webm, wav2mp3, vid2audio, vid2gif, media-info,
media-optimize, thumloc, webloc2md, ytdl.
EOF
}
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "${1:-}" in
  -h|--help|help) usage; exit 0;;
  doctor) exec "$SCRIPT_DIR/mytools-doctor" "${@:2}";;
  config) exec "$SCRIPT_DIR/mytools-config" "${@:2}";;
  "") ;;
  *) echo "Unknown mytools command: $1" >&2; usage >&2; exit 1;;
esac
command -v fzf >/dev/null 2>&1 || { usage; echo "💡 Install fzf for the interactive launcher: brew install fzf"; exit 0; }
OPTION=$(printf '%s\n' \
  'img2webp — image to WebP' 'vid2webm — video to WebM' 'wav2mp3 — audio to MP3' 'wav2tempo — retime a WAV by BPM' \
  'vid2audio — extract video audio' 'vid2gif — video to GIF' 'media-info — inspect a file' \
  'media-optimize — web/social/archive video' 'thumloc — Finder bookmark thumbnails' \
  'webloc2md — bookmark index' 'ytdl — download media' 'doctor — dependency check' 'config — presets' | fzf --prompt='mytools > ' --height=60% --layout=reverse --border)
[ -n "$OPTION" ] || exit 0
TOOL="${OPTION%% *}"
case "$TOOL" in
  doctor) exec "$SCRIPT_DIR/mytools-doctor";; config) exec "$SCRIPT_DIR/mytools-config";;
  thumloc|webloc2md|ytdl) exec "$SCRIPT_DIR/$TOOL";;
esac
FILES=$(find . -maxdepth 1 -type f -print | sed 's#^./##' | fzf -m --prompt="${TOOL} files > " --height=60% --layout=reverse --border)
[ -n "$FILES" ] || { echo 'Canceled.'; exit 0; }
FILE_ARRAY=(); while IFS= read -r file; do FILE_ARRAY+=("$file"); done <<< "$FILES"
exec "$SCRIPT_DIR/$TOOL" "${FILE_ARRAY[@]}"
