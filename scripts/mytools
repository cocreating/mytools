#!/usr/bin/env bash
set -euo pipefail

usage() { cat <<'EOF'
Usage:
  mytools                     Open the interactive fzf launcher menu (with live preview)
  <tool> [options] [files]    Run any tool directly with custom flags (recommended)
  <tool> -i                   Launch interactive guided wizard for a tool
  mytools <tool> [options]    Convenience wrapper that forwards to <tool>

Built-in commands:
  help [tool]       Print overview or detailed guide for a tool
  guide             Interactive help browser, recipe copier & cheat-sheets
  cs [topic]        Print short code sheets (all | video | audio | image | recipes)
  doctor            Check & auto-install dependencies
  config            Show/create the presets configuration

Step-by-Step Custom Command Usage:
  1. Go to your files folder:   cd ~/Pictures/MyPhotos
  2. Run the tool directly:     img2webp --width 1200 -q 90 -a
     (Note: no 'mytools' prefix is required, and image tool is 'img2webp' with a 'p')
  3. Or use interactive wizard: img2webp -i | vidglue -i | vidglitch -i | vidcuts -i | videoeffects -i | videorandfram -i

Tools: img2webp, ytdl, vidglue (videoglue), vid2webm, vid2gif, videoWithoutAudio, vidoptim,
vidglitch (videoglitch), vidcuts (videocuts), videoeffects (vidfx), videorandfram (vidrandfram),
vid2audio, wav2mp3, wav2tempo, wavreverse, wavpitch, wavnorm, wavfade, wavtrim, wavfx,
media-info, thumloc, webloc2md.
EOF
}
SOURCE_PATH="${BASH_SOURCE[0]}"; while [ -h "$SOURCE_PATH" ]; do SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; SOURCE_LINK="$(readlink "$SOURCE_PATH")"; case "$SOURCE_LINK" in /*) SOURCE_PATH="$SOURCE_LINK";; *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_LINK";; esac; done; SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
case "${1:-}" in
  -h|--help|help|h) exec "$SCRIPT_DIR/mytools-guide" "${2:-}";;
  guide|g) exec "$SCRIPT_DIR/mytools-guide" --interactive;;
  cheatsheet|cs|sheets) exec "$SCRIPT_DIR/mytools-guide" cheatsheet "${2:-all}";;
  recipes|pipelines) exec "$SCRIPT_DIR/mytools-guide" cheatsheet recipes;;
  doctor) exec "$SCRIPT_DIR/mytools-doctor" "${@:2}";;
  config) exec "$SCRIPT_DIR/mytools-config" "${@:2}";;
  img2web)
    echo "💡 Note: The image tool is named 'img2webp' (with a 'p'). You can also run it directly without 'mytools': img2webp ${*:2}" >&2
    exec "$SCRIPT_DIR/img2webp" "${@:2}"
    ;;
  videoglue) exec "$SCRIPT_DIR/vidglue" "${@:2}" ;;
  videoglitch) exec "$SCRIPT_DIR/vidglitch" "${@:2}" ;;
  videocuts) exec "$SCRIPT_DIR/vidcuts" "${@:2}" ;;
  vidfx) exec "$SCRIPT_DIR/videoeffects" "${@:2}" ;;
  vidrandfram) exec "$SCRIPT_DIR/videorandfram" "${@:2}" ;;
  "") ;;
  *)
    if [ -x "$SCRIPT_DIR/$1" ] && [ "$1" != "mytools" ]; then
      echo "💡 Tip: Each tool is a standalone command — you can run '$1 ${*:2}' directly without 'mytools' in front." >&2
      exec "$SCRIPT_DIR/$1" "${@:2}"
    fi
    echo "Unknown mytools command: $1" >&2
    echo "💡 Tip: Run tools directly by name (e.g. 'img2webp -a', 'vidglue a.mp4 b.mp4') or run 'mytools' for the interactive menu." >&2
    exec "$SCRIPT_DIR/mytools-guide"
    ;;
esac
command -v fzf >/dev/null 2>&1 || { "$SCRIPT_DIR/mytools-guide"; echo "💡 Install fzf for the interactive launcher: brew install fzf"; exit 0; }
if [ -t 1 ]; then
  CURRENT_LINES=$(tput lines 2>/dev/null || echo 0)
  CURRENT_COLS=$(tput cols 2>/dev/null || echo 80)
  if [ "$CURRENT_LINES" -gt 0 ] && [ "$CURRENT_LINES" -lt 32 ]; then
    printf '\e[8;%d;%dt' 32 "$CURRENT_COLS"
    sleep 0.05 2>/dev/null || true
  fi
fi
OPTION=$(printf '%s\n' \
  'img2webp — 📸 Image to WebP (wizard & batch converter)' \
  'ytdl — 📥 Download web media (yt-dlp + clipboard)' \
  'vidglue — 🎞️ Glue, crossfade & collage MP4 videos (videoglue)' \
  'vidglitch — ⚡ Glitch, VHS & retro visual/audio FX (videoglitch)' \
  'vidcuts — ✂️ Cut film, BPM beat cuts & silence remover (videocuts)' \
  'videoeffects — 🎬 Cinematic color grading, speed & optical FX (vidfx)' \
  'videorandfram — 🎲 Randomize frame order & temporal glitch (vidrandfram)' \
  'vidoptim — 🚀 Optimize video (web / social / archive presets)' \
  'vid2webm — 🌐 Video to VP9/Opus WebM' \
  'vid2gif — 👾 Video to palette-optimized GIF' \
  'videoWithoutAudio — 🔇 Remove video audio (optional preserve tracks)' \
  'vid2audio — 🔊 Extract video audio to WAV / MP3' \
  'wav2mp3 — 🎧 Convert WAV audio to MP3' \
  'wav2tempo — 🥁 Retime WAV by BPM (outputs WAV or MP3)' \
  'wavreverse — 🔄 Reverse WAV audio (outputs WAV or MP3)' \
  'wavpitch — 🎼 Shift WAV pitch / varispeed (outputs WAV or MP3)' \
  'wavnorm — 🎚️ Normalize WAV loudness (outputs WAV or MP3)' \
  'wavfade — 📈 Apply smooth fade envelopes (outputs WAV or MP3)' \
  'wavtrim — ✂️ Strip leading & trailing silence (outputs WAV or MP3)' \
  'wavfx — 🎛️ WAV audio DSP effects (outputs WAV or MP3)' \
  'media-info — 🕵️ Inspect media file codecs & metadata' \
  'thumloc — 🖼️ Finder bookmark thumbnails' \
  'webloc2md — 📑 Bookmark Markdown index' \
  'cheatsheet — ⚡ Short Code Sheets & One-Liner Recipes' \
  'guide — 📖 Interactive guide, recipe copier & cheat-sheets' \
  'doctor — 🩺 Dependency health check & auto-installer' \
  'config — ⚙️ User presets & configuration' | fzf \
  --prompt='mytools > ' \
  --header='🎯 Select a tool ([Enter] launch wizard / file picker • [Esc] exit)' \
  --height=~100% \
  --layout=reverse \
  --border \
  --preview="bash \"$SCRIPT_DIR/mytools-guide\" preview {1}" \
  --preview-window=right:54%:wrap)
[ -n "$OPTION" ] || exit 0
TOOL="${OPTION%% *}"
case "$TOOL" in
  cheatsheet) exec "$SCRIPT_DIR/mytools-guide" --interactive;;
  guide) exec "$SCRIPT_DIR/mytools-guide" --interactive;;
  doctor) exec "$SCRIPT_DIR/mytools-doctor";;
  config) exec "$SCRIPT_DIR/mytools-config";;
  thumloc|webloc2md|ytdl) exec "$SCRIPT_DIR/$TOOL";;
  img2webp|vidglue|vidglitch|vidcuts|videoeffects|videorandfram|vidrandfram)
    # Delegate directly to each tool's full interactive wizard (-i)
    exec "$SCRIPT_DIR/$TOOL" -i
    ;;
esac

# Filter candidate files by tool category with fallback to all files
EXT_FILTER='.'
case "$TOOL" in
  vid2webm|vid2gif|videoWithoutAudio|vidoptim|vid2audio|videorandfram|vidrandfram)
    EXT_FILTER='\.(mp4|mov|avi|mkv|webm|m4v)$'
    ;;
  wav2mp3|wav2tempo|wavreverse|wavpitch|wavnorm|wavfade|wavtrim|wavfx)
    EXT_FILTER='\.(wav)$'
    ;;
esac

CAND_FILES=$(find . -maxdepth 1 -type f 2>/dev/null | sed 's#^./##' | grep -Ei "$EXT_FILTER" | sort || true)
if [ -z "$CAND_FILES" ]; then
  CAND_FILES=$(find . -maxdepth 2 -type f 2>/dev/null | sed 's#^./##' | grep -Ei "$EXT_FILTER" | sort || true)
fi
if [ -z "$CAND_FILES" ]; then
  CAND_FILES=$(find . -maxdepth 1 -type f 2>/dev/null | sed 's#^./##' | sort || true)
fi

FILES=$(printf '%s\n' "$CAND_FILES" | fzf -m \
  --prompt="${TOOL} files > " \
  --header='💡 Press [Tab] to mark multiple files, then press [Enter] to confirm' \
  --height=65% \
  --layout=reverse \
  --border \
  --preview="bash \"$SCRIPT_DIR/lib/common.sh\" --preview {}" \
  --preview-window=right:48%:wrap)
[ -n "$FILES" ] || { echo 'Canceled.'; exit 0; }
FILE_ARRAY=(); while IFS= read -r file; do [ -n "$file" ] && FILE_ARRAY+=("$file"); done <<< "$FILES"

AUDIO_FMT_FLAGS=()
case "$TOOL" in
  wav2tempo|wavreverse|wavpitch|wavnorm|wavfade|wavtrim|wavfx)
    FMT_CHOICE=$(printf '%s\n' \
      'wav — 🎵 Lossless 16-bit PCM WAV (default)' \
      'mp3 — 🎧 MP3 192kbps (-m)' \
      'mp3-320 — 💎 MP3 320kbps (-m -b 320)' | fzf --prompt="${TOOL} output format > " --height=30% --layout=reverse --border || true)
    case "${FMT_CHOICE%% *}" in
      mp3) AUDIO_FMT_FLAGS=(-m) ;;
      mp3-320) AUDIO_FMT_FLAGS=(-m -b 320) ;;
    esac
    ;;
esac

case "$TOOL" in
  vidoptim)
    P_CHOICE=$(printf '%s\n' \
      'web — 🌐 H.264, CRF 23, max 1080p (default)' \
      'social — 📱 H.264, CRF 25, max 720p' \
      'archive — 📦 H.265/HEVC, CRF 26, native resolution' | fzf --prompt='vidoptim preset > ' --height=35% --layout=reverse --border || true)
    [ -n "$P_CHOICE" ] && exec "$SCRIPT_DIR/vidoptim" --preset "${P_CHOICE%% *}" "${FILE_ARRAY[@]}"
    ;;
  wavfx)
    FX_CHOICE=$(printf '%s\n' \
      'room — 🏠 Warm studio room reverb' \
      'hall — 🏛️ Spacious concert hall reverb' \
      'space — 🌌 Deep cosmic space reverb' \
      'delay-250 — 🔁 250ms slapback echo delay' \
      'lofi-800 — 📻 Warm 800Hz low-pass filter' | fzf --prompt='wavfx preset > ' --height=40% --layout=reverse --border || true)
    case "${FX_CHOICE%% *}" in
      room|hall|space) exec "$SCRIPT_DIR/wavfx" "${AUDIO_FMT_FLAGS[@]}" --reverb "${FX_CHOICE%% *}" "${FILE_ARRAY[@]}" ;;
      delay-250) exec "$SCRIPT_DIR/wavfx" "${AUDIO_FMT_FLAGS[@]}" --delay 250 "${FILE_ARRAY[@]}" ;;
      lofi-800) exec "$SCRIPT_DIR/wavfx" "${AUDIO_FMT_FLAGS[@]}" --lowpass 800 "${FILE_ARRAY[@]}" ;;
    esac
    ;;
  wavpitch)
    SEMI_CHOICE=$(printf '%s\n' \
      '+2 — ⬆️ Up 2 semitones (tempo preserved)' \
      '+5 — ⬆️ Up 5 semitones (fourth up)' \
      '-2 — ⬇️ Down 2 semitones (tempo preserved)' \
      '-5 — ⬇️ Down 5 semitones (deep vocal)' \
      'tape — 📼 -4 semitones Varispeed (slow tape drop)' | fzf --prompt='wavpitch shift > ' --height=40% --layout=reverse --border || true)
    case "${SEMI_CHOICE%% *}" in
      tape) exec "$SCRIPT_DIR/wavpitch" "${AUDIO_FMT_FLAGS[@]}" --varispeed -s -4 "${FILE_ARRAY[@]}" ;;
      +2|+5|-2|-5) exec "$SCRIPT_DIR/wavpitch" "${AUDIO_FMT_FLAGS[@]}" -s "${SEMI_CHOICE%% *}" "${FILE_ARRAY[@]}" ;;
    esac
    ;;
  wavfade)
    FADE_CHOICE=$(printf '%s\n' \
      'micro — ⚡ 0.1s in / 0.2s out (de-click sample boundaries)' \
      'smooth — 🌊 0.5s in / 1.0s out (musical pad envelope)' \
      'long — 🌅 1.5s in / 2.0s out (cinematic swell)' | fzf --prompt='wavfade envelope > ' --height=35% --layout=reverse --border || true)
    case "${FADE_CHOICE%% *}" in
      smooth) exec "$SCRIPT_DIR/wavfade" "${AUDIO_FMT_FLAGS[@]}" -i 0.5 -o 1.0 "${FILE_ARRAY[@]}" ;;
      long) exec "$SCRIPT_DIR/wavfade" "${AUDIO_FMT_FLAGS[@]}" -i 1.5 -o 2.0 "${FILE_ARRAY[@]}" ;;
      *) exec "$SCRIPT_DIR/wavfade" "${AUDIO_FMT_FLAGS[@]}" -i 0.1 -o 0.2 "${FILE_ARRAY[@]}" ;;
    esac
    ;;
esac

exec "$SCRIPT_DIR/$TOOL" "${AUDIO_FMT_FLAGS[@]}" "${FILE_ARRAY[@]}"
