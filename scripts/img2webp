#!/bin/bash
set -euo pipefail

# ───────────────────────────────────────────────
# img2webp — Convert images to WebP format
# ───────────────────────────────────────────────

CONFIG_DIR="${HOME}/.config/mytools"
CONFIG_FILE="${CONFIG_DIR}/config"

# Defaults
QUALITY=85
WIDTH=0
HEIGHT=0
LOSSLESS=0
FORCE=0
OUTPUT_DIR=""
RECURSIVE=0
DRY_RUN=0
JOBS=1
DELETE_ORIGINAL=0
VERBOSE=0

IMAGE_EXTENSIONS=(jpg jpeg png gif bmp tiff tif heic heif webp)

load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        while IFS='=' read -r key value || [[ -n "$key" ]]; do
            [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
            [[ "$value" =~ ^[0-9]+$ ]] || continue
            case "$key" in
                default_quality) QUALITY="$value" ;;
                default_width) WIDTH="$value" ;;
                default_height) HEIGHT="$value" ;;
                default_jobs) JOBS="$value" ;;
            esac
        done < <(grep -E '^[A-Za-z_][A-Za-z0-9_]*=[0-9]+$' "$CONFIG_FILE" 2>/dev/null || true)
    fi
}

usage() {
    cat <<EOF
Usage: img2webp [options] [file1.jpg file2.png ... or directory]

Options:
  -i, --interactive     Interactive wizard mode (prompts for settings & files)
  -a, --all             Process all images in the current directory
  -q, --quality <n>     Quality 0-100 (default: $QUALITY)
  -w, --width <px>      Resize width (keeps aspect ratio)
  -H, --height <px>     Resize height (keeps aspect ratio)
  -r, --resize WxH      Exact resize dimensions
  -l, --lossless        Lossless encoding (ignores quality)
  -o, --output-dir <d>  Write output to this directory
  -R, --recursive       Recursively process directories
  -j, --jobs <n>        Parallel jobs (default: $JOBS)
  -f, --force           Overwrite existing output files
  -n, --dry-run         Show what would be done without converting
  -d, --delete-original Remove original files after successful conversion
  -v, --verbose         Show detailed cwebp output
  -h, --help            Show this help

Examples:
  img2webp -i                               # Interactive wizard
  img2webp --width 1200 -q 90 -a            # Convert all images in current folder
  img2webp -width 1200 -q 90 .              # Single-dash flags supported
  img2webp -q 80 photo.jpg
  img2webp --width 1200 --output-dir ./out/ *.png
  img2webp -R -j 4 -f ~/Pictures/Vacation/
  img2webp -q 90 -d -o ./webp/ photo.heic

Config file: ~/.config/mytools/config
EOF
}

check_dependencies() {
    local missing=()
    if ! command -v cwebp &>/dev/null; then
        missing+=("cwebp (libwebp)")
    fi
    if [ ${#missing[@]} -gt 0 ]; then
        echo "❌ Missing dependencies:" >&2
        for dep in "${missing[@]}"; do echo "   - $dep" >&2; done
        echo "" >&2
        echo "💡 Install with: brew install webp" >&2
        exit 1
    fi
}

validate_numeric() {
    local val="$1" name="$2"
    if ! [[ "$val" =~ ^[0-9]+$ ]]; then
        echo "❌ Error: $name must be a positive number" >&2
        exit 1
    fi
}

interactive_wizard() {
    echo "🧙 Welcome to the img2webp interactive wizard!"
    echo "───────────────────────────────────────────────"

    # Step 1: Input files / folder selection
    if [ "${#FILES[@]}" -eq 0 ]; then
        echo "📂 Step 1: Select images to convert"
        echo "  [1] All images in current directory ($(pwd)) [Default]"
        echo "  [2] All images in current directory and subdirectories (recursive)"
        if command -v fzf &>/dev/null; then
            echo "  [3] Select files interactively with fzf"
        fi
        echo "  [4] Specify custom path, directory, or files"
        printf "Choose an option [1]: "
        read -r file_choice
        file_choice="${file_choice:-1}"

        case "$file_choice" in
            1)
                FILES+=(".")
                ;;
            2)
                RECURSIVE=1
                FILES+=(".")
                ;;
            3)
                if command -v fzf &>/dev/null; then
                    echo "💡 Tip: Press [Tab] to mark multiple files, then [Enter] to confirm."
                    local cand_files=""
                    cand_files=$(find . -maxdepth 1 -type f 2>/dev/null | grep -Ei '\.(jpe?g|png|gif|bmp|tiff?|heic|heif|webp)$' | sed 's#^./##' || true)
                    if [ -z "$cand_files" ]; then
                        cand_files=$(find . -type f 2>/dev/null | grep -Ei '\.(jpe?g|png|gif|bmp|tiff?|heic|heif|webp)$' | sed 's#^./##' || true)
                    fi
                    local selected=""
                    if [ -n "$cand_files" ]; then
                        selected=$(printf '%s\n' "$cand_files" | fzf -m --prompt="img2webp files > " --height=50% --layout=reverse --border || true)
                    fi
                    if [ -z "$selected" ]; then
                        echo "No files selected. Defaulting to all images in current directory."
                        FILES+=(".")
                    else
                        while IFS= read -r f; do
                            [ -n "$f" ] && FILES+=("$f")
                        done <<< "$selected"
                    fi
                else
                    FILES+=(".")
                fi
                ;;
            4)
                printf "Enter path or directory [default: .]: "
                read -r custom_path
                custom_path="${custom_path:-.}"
                FILES+=("$custom_path")
                ;;
            *)
                FILES+=(".")
                ;;
        esac
        echo ""
    else
        echo "📂 Files: ${#FILES[@]} item(s) specified on command line."
        echo ""
    fi

    # Step 2: Quality
    echo "🎨 Step 2: Quality (0-100)"
    printf "Enter quality [default: %s]: " "$QUALITY"
    read -r input_quality
    if [ -n "$input_quality" ]; then
        if [[ "$input_quality" =~ ^[0-9]+$ ]] && [ "$input_quality" -ge 0 ] && [ "$input_quality" -le 100 ]; then
            QUALITY="$input_quality"
        else
            echo "⚠️  Invalid quality '$input_quality', keeping default: $QUALITY"
        fi
    fi
    echo ""

    # Step 3: Resize (Width / Height)
    echo "📐 Step 3: Resize (keeps aspect ratio unless both width and height are given)"
    local cur_w="none"
    [ "$WIDTH" -gt 0 ] && cur_w="$WIDTH"
    printf "Max width in pixels (e.g. 1200, 1920, or Enter to keep original) [%s]: " "$cur_w"
    read -r input_width
    if [ -n "$input_width" ]; then
        if [[ "$input_width" =~ ^[0-9]+$ ]]; then
            WIDTH="$input_width"
        else
            echo "⚠️  Invalid width '$input_width', keeping original width"
        fi
    fi

    local cur_h="none"
    [ "$HEIGHT" -gt 0 ] && cur_h="$HEIGHT"
    printf "Max height in pixels (e.g. 800, or Enter to keep original) [%s]: " "$cur_h"
    read -r input_height
    if [ -n "$input_height" ]; then
        if [[ "$input_height" =~ ^[0-9]+$ ]]; then
            HEIGHT="$input_height"
        else
            echo "⚠️  Invalid height '$input_height', keeping original height"
        fi
    fi
    echo ""

    # Step 4: Lossless
    echo "💎 Step 4: Compression mode"
    printf "Lossless encoding? (ignores quality setting) [y/N]: "
    read -r input_lossless
    if [[ "$input_lossless" =~ ^[Yy]$ ]]; then
        LOSSLESS=1
    fi
    echo ""

    # Step 5: Output directory
    echo "📂 Step 5: Output directory"
    printf "Output directory (Enter for same folder as input)%s: " "$([ -n "$OUTPUT_DIR" ] && echo " [$OUTPUT_DIR]" || echo "")"
    read -r input_outdir
    if [ -n "$input_outdir" ]; then
        OUTPUT_DIR="$input_outdir"
    fi
    echo ""

    # Step 6: Additional options
    echo "⚙️  Step 6: Additional options"
    printf "Overwrite existing .webp files? [y/N]: "
    read -r input_force
    [[ "$input_force" =~ ^[Yy]$ ]] && FORCE=1

    printf "Delete original files after successful conversion? [y/N]: "
    read -r input_del
    [[ "$input_del" =~ ^[Yy]$ ]] && DELETE_ORIGINAL=1
    echo ""

    # Step 7: Summary & Confirmation
    local eq_cmd="img2webp"
    [ "$QUALITY" -ne 85 ] && eq_cmd+=" -q $QUALITY"
    [ "$WIDTH" -gt 0 ] && eq_cmd+=" --width $WIDTH"
    [ "$HEIGHT" -gt 0 ] && eq_cmd+=" --height $HEIGHT"
    [ "$LOSSLESS" -eq 1 ] && eq_cmd+=" --lossless"
    [ -n "$OUTPUT_DIR" ] && eq_cmd+=" --output-dir \"$OUTPUT_DIR\""
    [ "$RECURSIVE" -eq 1 ] && eq_cmd+=" --recursive"
    [ "$FORCE" -eq 1 ] && eq_cmd+=" --force"
    [ "$DELETE_ORIGINAL" -eq 1 ] && eq_cmd+=" --delete-original"
    if [ "${#FILES[@]}" -eq 1 ] && [ "${FILES[0]}" = "." ]; then
        eq_cmd+=" -a"
    else
        for f in "${FILES[@]}"; do
            eq_cmd+=" \"$f\""
        done
    fi

    echo "══════════════════════════════════════════════════"
    echo "📋 Planned Configuration:"
    echo "  Quality        : $([ "$LOSSLESS" -eq 1 ] && echo "Lossless" || echo "$QUALITY")"
    if [ "$WIDTH" -gt 0 ] && [ "$HEIGHT" -gt 0 ]; then
        echo "  Resize         : ${WIDTH}x${HEIGHT}px"
    elif [ "$WIDTH" -gt 0 ]; then
        echo "  Resize width   : ${WIDTH}px (maintains aspect ratio)"
    elif [ "$HEIGHT" -gt 0 ]; then
        echo "  Resize height  : ${HEIGHT}px (maintains aspect ratio)"
    else
        echo "  Resize         : None (original dimensions)"
    fi
    echo "  Output dir     : ${OUTPUT_DIR:-"Same as source file"}"
    echo "  Overwrite      : $([ "$FORCE" -eq 1 ] && echo "Yes" || echo "No")"
    echo "  Delete source  : $([ "$DELETE_ORIGINAL" -eq 1 ] && echo "Yes" || echo "No")"
    echo ""
    echo "💡 Equivalent command:"
    echo "   $eq_cmd"
    echo "══════════════════════════════════════════════════"
    printf "Proceed with conversion? [Y/n]: "
    read -r confirm
    confirm="${confirm:-y}"
    if ! [[ "$confirm" =~ ^[Yy]$ ]]; then
        echo "❌ Conversion canceled."
        exit 0
    fi
    echo ""
}

load_config

# ─── Parse arguments ───────────────────────────
FILES=()
INTERACTIVE=0
ALL_IN_DIR=0
CLI_OPTIONS_PASSED=0

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        -i|--interactive|-interactive) INTERACTIVE=1; shift ;;
        -a|--all|-all) ALL_IN_DIR=1; shift ;;
        -q|--quality|-quality)  [[ -n "${2:-}" ]] || { echo "❌ Error: $1 requires a value" >&2; exit 1; }; QUALITY="$2"; CLI_OPTIONS_PASSED=1; shift 2 ;;
        -w|--width|-width)    [[ -n "${2:-}" ]] || { echo "❌ Error: $1 requires a value" >&2; exit 1; }; WIDTH="$2"; CLI_OPTIONS_PASSED=1; shift 2 ;;
        -H|--height|-height)   [[ -n "${2:-}" ]] || { echo "❌ Error: $1 requires a value" >&2; exit 1; }; HEIGHT="$2"; CLI_OPTIONS_PASSED=1; shift 2 ;;
        -r|--resize|-resize)
            [[ -n "${2:-}" ]] || { echo "❌ Error: $1 requires WIDTHxHEIGHT" >&2; exit 1; }
            if [[ "$2" =~ ^([0-9]+)x([0-9]+)$ ]]; then
                WIDTH="${BASH_REMATCH[1]}"; HEIGHT="${BASH_REMATCH[2]}"
            else
                echo "❌ Error: resize must use WIDTHxHEIGHT, e.g. 1200x800" >&2; exit 1
            fi
            CLI_OPTIONS_PASSED=1
            shift 2 ;;
        -l|--lossless|-lossless) LOSSLESS=1; CLI_OPTIONS_PASSED=1; shift ;;
        -o|--output-dir|-output-dir)
            [[ -n "${2:-}" ]] || { echo "❌ Error: $1 requires a directory" >&2; exit 1; }
            OUTPUT_DIR="$2"; CLI_OPTIONS_PASSED=1; shift 2 ;;
        -R|--recursive|-recursive) RECURSIVE=1; CLI_OPTIONS_PASSED=1; shift ;;
        -j|--jobs|-jobs)
            [[ -n "${2:-}" ]] || { echo "❌ Error: $1 requires a number" >&2; exit 1; }
            JOBS="$2"; CLI_OPTIONS_PASSED=1; shift 2 ;;
        -f|--force|-force) FORCE=1; CLI_OPTIONS_PASSED=1; shift ;;
        -n|--dry-run|-dry-run) DRY_RUN=1; CLI_OPTIONS_PASSED=1; shift ;;
        -d|--delete-original|-delete-original) DELETE_ORIGINAL=1; CLI_OPTIONS_PASSED=1; shift ;;
        -v|--verbose|-verbose) VERBOSE=1; CLI_OPTIONS_PASSED=1; shift ;;
        -h|--help|-help) usage; exit 0 ;;
        -*)
            echo "❌ Error: unknown option $1" >&2
            usage >&2; exit 1 ;;
        *) FILES+=("$1"); shift ;;
    esac
done

if [ "$ALL_IN_DIR" -eq 1 ]; then
    FILES+=(".")
fi

if [ "$INTERACTIVE" -eq 1 ]; then
    interactive_wizard
elif [ "${#FILES[@]}" -eq 0 ]; then
    if [ -t 0 ]; then
        if [ "$CLI_OPTIONS_PASSED" -eq 0 ]; then
            interactive_wizard
        else
            printf "📁 No files specified. Convert all images in current directory (%s)? [Y/n]: " "$(pwd)"
            read -r reply
            reply="${reply:-y}"
            if [[ "$reply" =~ ^[Yy]$ ]]; then
                FILES+=(".")
            else
                echo "💡 Run 'img2webp --help' for usage or 'img2webp -i' for interactive wizard."
                exit 0
            fi
        fi
    else
        usage >&2
        exit 1
    fi
fi

if ! [[ "$QUALITY" =~ ^[0-9]+$ ]] || [ "$QUALITY" -lt 0 ] || [ "$QUALITY" -gt 100 ]; then
    echo "❌ Error: quality must be a number from 0 to 100" >&2; exit 1
fi
validate_numeric "$WIDTH" width
validate_numeric "$HEIGHT" height
validate_numeric "$JOBS" jobs

# ─── Resolve output dir ────────────────────────
if [[ -n "$OUTPUT_DIR" ]]; then
    OUTPUT_DIR="$(cd "$(dirname "$OUTPUT_DIR")" 2>/dev/null && pwd)/$(basename "$OUTPUT_DIR")"
    if [ "$DRY_RUN" -eq 0 ] && [ ! -d "$OUTPUT_DIR" ]; then
        echo "📁 Creating output directory: $OUTPUT_DIR"
        mkdir -p "$OUTPUT_DIR"
    fi
fi

# ─── Collect all input files ───────────────────
ALL_INPUTS=()
for item in "${FILES[@]}"; do
    if [ -d "$item" ]; then
        depth_args=()
        if [ "$RECURSIVE" -eq 0 ]; then
            depth_args=(-maxdepth 1)
        fi
        for ext in "${IMAGE_EXTENSIONS[@]}"; do
            while IFS= read -r -d '' file; do
                # Avoid re-encoding webp in place unless output dir is specified
                if [[ "$ext" == "webp" && -z "$OUTPUT_DIR" ]]; then
                    continue
                fi
                ALL_INPUTS+=("$file")
            done < <(find "$item" "${depth_args[@]}" -type f -iname "*.${ext}" -print0 2>/dev/null || true)
        done
    elif [ -f "$item" ]; then
        ALL_INPUTS+=("$item")
    else
        echo "⚠️  File not found: $item" >&2
    fi
done

# De-duplicate files while preserving order
if [ "${#ALL_INPUTS[@]}" -gt 0 ]; then
    DEDUP_INPUTS=()
    while IFS= read -r file; do
        [ -n "$file" ] && DEDUP_INPUTS+=("$file")
    done < <(printf '%s\n' "${ALL_INPUTS[@]}" | awk '!seen[$0]++')
    ALL_INPUTS=("${DEDUP_INPUTS[@]}")
fi

if [ "${#ALL_INPUTS[@]}" -eq 0 ]; then
    echo "❌ No valid image files found." >&2; exit 1
fi

check_dependencies

# ─── Build cwebp args ──────────────────────────
if [ "$WIDTH" -eq 0 ] && [ "$HEIGHT" -eq 0 ]; then
    RESIZE_ARGS=(); RESIZE_LABEL=""
elif [ "$WIDTH" -gt 0 ] && [ "$HEIGHT" -gt 0 ]; then
    RESIZE_ARGS=(-resize "$WIDTH" "$HEIGHT" -resize_mode down_only)
    RESIZE_LABEL=" | Resize: ${WIDTH}x${HEIGHT}"
elif [ "$WIDTH" -gt 0 ]; then
    RESIZE_ARGS=(-resize "$WIDTH" 0 -resize_mode down_only)
    RESIZE_LABEL=" | Resize: width ${WIDTH}px"
else
    RESIZE_ARGS=(-resize 0 "$HEIGHT" -resize_mode down_only)
    RESIZE_LABEL=" | Resize: height ${HEIGHT}px"
fi

if [ "$LOSSLESS" -eq 1 ]; then
    QUALITY_ARGS=(-lossless); QUALITY_LABEL="lossless"
else
    QUALITY_ARGS=(-q "$QUALITY"); QUALITY_LABEL="quality $QUALITY"
fi

[ "$VERBOSE" -eq 0 ] && QUIET_ARGS=(-quiet) || QUIET_ARGS=()

# ─── Helper functions ──────────────────────────
get_output_path() {
    local input="$1"
    local bn="$(basename "${input%.*}")"
    if [[ -n "$OUTPUT_DIR" ]]; then
        echo "${OUTPUT_DIR}/${bn}.webp"
    else
        echo "$(dirname "$input")/${bn}.webp"
    fi
}

convert_heic() {
    local input="$1"
    local ext="${input##*.}"
    ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
    if [[ "$ext" =~ ^(heic|heif)$ ]]; then
        local tmpfile="$(mktemp -t img2webp_heic_XXXXXX).png"
        if command -v heif-convert &>/dev/null; then
            heif-convert "$input" "$tmpfile" >/dev/null 2>&1 || { rm -f "$tmpfile"; return 1; }
        elif command -v sips &>/dev/null; then
            sips -s format png "$input" --out "$tmpfile" >/dev/null 2>&1 || { rm -f "$tmpfile"; return 1; }
        else
            return 1
        fi
        echo "$tmpfile"
        return 0
    fi
    echo "$input"
    return 0
}

process_file_job() {
    local INPUT_FILE="$1"
    local CURRENT="$2"
    local TOTAL="$3"
    local RESULT_DIR="$4"
    local OUTPUT_FILE
    OUTPUT_FILE="$(get_output_path "$INPUT_FILE")"

    # Check if input and output are the exact same file
    if [ -f "$OUTPUT_FILE" ] && [ -f "$INPUT_FILE" ]; then
        local in_real out_real
        in_real="$(cd "$(dirname "$INPUT_FILE")" 2>/dev/null && pwd)/$(basename "$INPUT_FILE")"
        out_real="$(cd "$(dirname "$OUTPUT_FILE")" 2>/dev/null && pwd)/$(basename "$OUTPUT_FILE")"
        if [ "$in_real" = "$out_real" ]; then
            echo "   ⚠️  [$CURRENT/$TOTAL] Skipped (source and output are the same file): $OUTPUT_FILE"
            echo "skipped" > "${RESULT_DIR}/${CURRENT}"
            return 0
        fi
    fi

    # Overwrite check
    if [ -f "$OUTPUT_FILE" ] && [ "$FORCE" -eq 0 ] && [ "$DRY_RUN" -eq 0 ]; then
        echo "   ⚠️  [$CURRENT/$TOTAL] Skipped (exists): $OUTPUT_FILE"
        echo "skipped" > "${RESULT_DIR}/${CURRENT}"
        return 0
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
        echo "   📝 [$CURRENT/$TOTAL] Would convert: $INPUT_FILE → $OUTPUT_FILE"
        echo "success" > "${RESULT_DIR}/${CURRENT}"
        return 0
    fi

    # Handle HEIC
    local TMPFILE=""
    local ACTUAL_INPUT
    ACTUAL_INPUT="$(convert_heic "$INPUT_FILE")"
    if [ "$ACTUAL_INPUT" != "$INPUT_FILE" ]; then
        TMPFILE="$ACTUAL_INPUT"
    fi

    CONVERT_OK=0
    if [ "$WIDTH" -eq 0 ] && [ "$HEIGHT" -eq 0 ]; then
        if cwebp "${QUALITY_ARGS[@]}" "${QUIET_ARGS[@]}" "$ACTUAL_INPUT" -o "$OUTPUT_FILE" 2>/dev/null; then CONVERT_OK=1; fi
    else
        if cwebp "${QUALITY_ARGS[@]}" "${RESIZE_ARGS[@]}" "${QUIET_ARGS[@]}" "$ACTUAL_INPUT" -o "$OUTPUT_FILE" 2>/dev/null; then CONVERT_OK=1; fi
    fi
    if [ "$CONVERT_OK" -eq 1 ]; then
        echo "   ✅ [$CURRENT/$TOTAL] $OUTPUT_FILE"
        [[ -n "$TMPFILE" && -f "$TMPFILE" ]] && rm -f "$TMPFILE"
        if [ "$DELETE_ORIGINAL" -eq 1 ]; then
            rm -f "$INPUT_FILE"
            echo "      🗑️  Original deleted: $INPUT_FILE"
        fi
        echo "success" > "${RESULT_DIR}/${CURRENT}"
    else
        echo "   ❌ [$CURRENT/$TOTAL] Failed: $INPUT_FILE"
        [[ -n "$TMPFILE" && -f "$TMPFILE" ]] && rm -f "$TMPFILE"
        echo "failed" > "${RESULT_DIR}/${CURRENT}"
    fi
}

# ─── Process files ─────────────────────────────
TOTAL="${#ALL_INPUTS[@]}"

echo "🖼️  img2webp — $TOTAL file(s) | $QUALITY_LABEL$RESIZE_LABEL | Jobs: $JOBS"
[[ -n "$OUTPUT_DIR" ]] && echo "   Output dir: $OUTPUT_DIR"
[ "$DRY_RUN" -eq 1 ] && echo "   ⚠️  DRY RUN — no files will be modified"
echo ""

# Create temp dir for tracking results in subshells
RESULT_DIR="$(mktemp -d -t img2webp_results_XXXXXX)"
trap 'rm -rf "$RESULT_DIR"' EXIT

CURRENT=1
for INPUT_FILE in "${ALL_INPUTS[@]}"; do
    if [ "$JOBS" -gt 1 ]; then
        # Limit running background jobs (Bash 3.2 compatible)
        while [ "$(jobs -p | wc -l)" -ge "$JOBS" ]; do
            sleep 0.1
        done
        process_file_job "$INPUT_FILE" "$CURRENT" "$TOTAL" "$RESULT_DIR" &
    else
        process_file_job "$INPUT_FILE" "$CURRENT" "$TOTAL" "$RESULT_DIR"
    fi
    CURRENT=$((CURRENT + 1))
done

# Wait for all background tasks
wait

# Read results
SUCCESS_COUNT=0
FAILED_COUNT=0
SKIPPED_COUNT=0

if [ -d "$RESULT_DIR" ]; then
    SUCCESS_COUNT=$( (find "$RESULT_DIR" -type f -exec grep -l '^success$' {} + 2>/dev/null || true) | wc -l | xargs)
    FAILED_COUNT=$( (find "$RESULT_DIR" -type f -exec grep -l '^failed$' {} + 2>/dev/null || true) | wc -l | xargs)
    SKIPPED_COUNT=$( (find "$RESULT_DIR" -type f -exec grep -l '^skipped$' {} + 2>/dev/null || true) | wc -l | xargs)
fi

# ─── Summary ───────────────────────────────────
echo ""
if [ "$DRY_RUN" -eq 1 ]; then
    echo "📝 Dry run complete. $TOTAL file(s) would be processed."
else
    echo "✅ Done: $SUCCESS_COUNT converted, $FAILED_COUNT failed, $SKIPPED_COUNT skipped"
    osascript -e "display notification \"Converted $SUCCESS_COUNT image(s) to WebP.\" with title \"img2webp Complete\"" 2>/dev/null || true
fi

exit "$FAILED_COUNT"
