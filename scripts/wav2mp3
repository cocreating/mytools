#!/usr/bin/env bash
set -euo pipefail
SOURCE_PATH="${BASH_SOURCE[0]}"; while [ -h "$SOURCE_PATH" ]; do SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; SOURCE_LINK="$(readlink "$SOURCE_PATH")"; case "$SOURCE_LINK" in /*) SOURCE_PATH="$SOURCE_LINK";; *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_LINK";; esac; done; SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; source "$SCRIPT_DIR/lib/common.sh"
BITRATE=192; OUTPUT_DIR=""; FORCE=0; DRY_RUN=0; FILES=()
usage() { cat <<EOF
Usage: wav2mp3 [options] <audio...>
  -b, --bitrate <kbps>  MP3 bitrate (default: $BITRATE)
  -o, --output-dir <d>  Write files here
  -f, --force           Overwrite existing files
  -n, --dry-run         Show planned outputs only
EOF
}
while [ "$#" -gt 0 ]; do case "$1" in -b|--bitrate) BITRATE="${2:?$1 requires a value}"; shift 2;; -o|--output-dir) OUTPUT_DIR="${2:?$1 requires a value}"; shift 2;; -f|--force) FORCE=1; shift;; -n|--dry-run) DRY_RUN=1; shift;; -h|--help) usage; exit 0;; -*) echo "Unknown option: $1" >&2; exit 1;; *) FILES+=("$1"); shift;; esac; done
[ "${#FILES[@]}" -gt 0 ] || { usage >&2; exit 1; }; [[ "$BITRATE" =~ ^[0-9]+$ ]] || { echo "Bitrate must be numeric." >&2; exit 1; }; require_commands ffmpeg
[ -z "$OUTPUT_DIR" ] || OUTPUT_DIR="$(ensure_output_dir "$OUTPUT_DIR")"
for input in "${FILES[@]}"; do [ -f "$input" ] || { echo "⚠️  Not a file: $input" >&2; continue; }; out="${OUTPUT_DIR:-$(dirname "$input")}/$(basename "${input%.*}").mp3"; [ "$DRY_RUN" -eq 1 ] && { echo "📝 Would create: $out"; continue; }; output_is_safe "$out" "$FORCE" || continue; echo "▶️  $input → $out"; ffmpeg -hide_banner -loglevel error -stats -i "$input" -c:a libmp3lame -b:a "${BITRATE}k" "$out"; done
notify "MP3 conversion complete." "wav2mp3"
