#!/usr/bin/env bash
set -euo pipefail
SOURCE_PATH="${BASH_SOURCE[0]}"; while [ -h "$SOURCE_PATH" ]; do SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; SOURCE_LINK="$(readlink "$SOURCE_PATH")"; case "$SOURCE_LINK" in /*) SOURCE_PATH="$SOURCE_LINK";; *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_LINK";; esac; done; SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; source "$SCRIPT_DIR/lib/common.sh"

PRESET="rgb-split"; CUSTOM_RGB=""; SCANLINES=0; NOISE=0; PIXELATE=0; TEAR=0; BURST=0; BURST_ORGANIC=0; MUTE=0
INTENSITY="med"; AUDIO_GLITCH=0; TRACKING=0; OSD=0
OUTPUT_DIR=""; FORCE=0; DRY_RUN=0; START=""; END=""; FILES=(); HAS_CUSTOM=0; INTERACTIVE=0

usage() { cat <<'EOF'
Usage: vidglitch [options] <video...>

Apply glitch, analog tape, and retro visual/audio effects to video files.

Options:
  -i, --interactive           Interactive wizard (prompts for presets & files) 🧙

Presets:
  -p, --preset <name>         Preset effect (default: rgb-split)
                              Available:
                                • rgb-split   🌈 Chromatic aberration (red/blue channel shift)
                                • vhs         📼 Analog VHS tape noise, tracking bar & color bleed
                                • crt         📺 Arcade CRT scanlines & phosphor contrast
                                • 8bit        🕹️ Retro pixelated gaming blocks
                                • cyberpunk   🌆 Neon RGB split, scanlines & data tearing
                                • badsignal   📡 Heavy static, signal loss & frame displacement
                                • tear        ⚡ Horizontal digital block displacement
                                • datamosh    🌊 Motion pixel smear & frame ghosting trails
                                • nightvision 🟢 Tactical green phosphor, high-ISO grain & vignette
                                • gameboy     🟩 4-shade handheld LCD pixel matrix
                                • matrix      💻 Digital green code phosphor & vertical glitch

Effect Modifiers & Audio:
  -I, --intensity <level>     Effect strength: low, med, high, or 1-100 (default: med / 50)
  --burst                     Trigger glitch intermittently (every ~2s pulse)
  --organic-burst             Trigger glitch in erratic, organic hardware fault bursts
  -A, --audio-glitch          Corrupt audio stream in sync with visual preset (bitcrush/tape flutter)
  --tracking                  Add scrolling VHS tracking distortion bar
  --osd                       Add retro camcorder viewfinder HUD & blinking REC indicator
  --mute                      Discard audio from the output video

Custom Effect Building Blocks:
  --rgb-split <px>            Shift red and blue color channels (e.g. 12)
  --scanlines                 Add CRT scanline overlay
  --noise <level>             Add analog video noise (1-100, e.g. 15)
  --pixelate <factor>         Pixelate video into blocks (e.g. 10)
  --tear                      Add horizontal data glitch tearing

Trimming & Output:
  --from <time>               Start timestamp (e.g. 00:00:02)
  --to <time>                 End timestamp (e.g. 00:00:10)
  -o, --output-dir <dir>      Write output files to this directory
  -f, --force                 Overwrite existing output files
  -n, --dry-run               Show planned output files only
  -h, --help                  Show help

Examples:
  vidglitch -i                                                # interactive guided wizard
  vidglitch clip.mp4                                          # default chromatic aberration
  vidglitch --preset vhs --audio-glitch --osd recording.mov   # full VHS tape + camcorder HUD + tape audio
  vidglitch --preset cyberpunk --organic-burst promo.mp4      # erratic neon glitches
  vidglitch --preset datamosh -I high dance.mp4               # intense motion trails & pixel smear
  vidglitch --preset 8bit -A -o ./glitched *.mp4              # 8-bit video + bitcrushed chiptune audio
EOF
}

interactive_wizard() {
  echo "🧙 Welcome to the vidglitch interactive wizard!"
  echo "───────────────────────────────────────────────"

  # Step 1: Input files with live ffprobe preview
  wizard_select_files "vidglitch" '\.(mp4|mov|avi|mkv|webm|m4v)$' "💡 [Tab] mark multiple video files • [Enter] confirm"

  # Step 2: Glitch Preset (or Custom Builder)
  if command -v fzf &>/dev/null; then
    local p_choice
    p_choice=$(printf '%s\n' \
      'rgb-split — 🌈 Chromatic aberration (red/blue channel shift, default)' \
      'vhs — 📼 Analog VHS tape noise, scrolling tracking bar & vignette' \
      'crt — 📺 Arcade CRT scanlines & phosphor contrast' \
      '8bit — 🕹️ Retro pixelated gaming blocks' \
      'cyberpunk — 🌆 Neon RGB split, scanlines & data tearing' \
      'badsignal — 📡 Heavy static, signal loss & frame displacement' \
      'tear — ⚡ Horizontal digital block displacement' \
      'datamosh — 🌊 Motion pixel smear & frame ghosting trails' \
      'nightvision — 🟢 Tactical green phosphor, high-ISO grain & scanlines' \
      'gameboy — 🟩 4-shade handheld LCD green pixel matrix' \
      'matrix — 💻 Digital green code phosphor & vertical glitch' \
      'custom — 🛠️ Build custom glitch combination (RGB + scanlines + noise + pixelate + tear)' | fzf --prompt="Select glitch preset > " --height=60% --layout=reverse --border || true)
    local p_key="${p_choice%% *}"
    if [ "$p_key" = "custom" ]; then
      HAS_CUSTOM=1
      local c_blocks
      c_blocks=$(printf '%s\n' \
        'rgb-12 — 🌈 RGB channel shift (12px)' \
        'rgb-24 — 🌈 Heavy RGB channel shift (24px)' \
        'scanlines — 📺 CRT scanline raster overlay' \
        'noise-18 — 📻 Analog tape static noise (18)' \
        'pixelate-10 — 🕹️ Mosaic block pixelation (10px)' \
        'tear — ⚡ Horizontal pixel block tearing' | fzf -m --prompt="Custom blocks ([Tab] multi-select) > " --height=45% --layout=reverse --border || true)
      if [ -n "$c_blocks" ]; then
        while IFS= read -r cb; do
          case "${cb%% *}" in
            rgb-12) CUSTOM_RGB="12" ;;
            rgb-24) CUSTOM_RGB="24" ;;
            scanlines) SCANLINES=1 ;;
            noise-18) NOISE="18" ;;
            pixelate-10) PIXELATE="10" ;;
            tear) TEAR=1 ;;
          esac
        done <<< "$c_blocks"
      else
        CUSTOM_RGB="12"; SCANLINES=1
      fi
    elif [ -n "$p_key" ]; then
      PRESET="$p_key"
    fi
  else
    echo "Glitch presets:"
    echo "  [1] rgb-split (default)  [5] cyberpunk    [9] nightvision"
    echo "  [2] vhs                  [6] badsignal    [10] gameboy"
    echo "  [3] crt                  [7] tear         [11] matrix"
    echo "  [4] 8bit                 [8] datamosh"
    printf "Choose a preset [1]: "
    read -r p_num
    case "${p_num:-1}" in
      1) PRESET="rgb-split";; 2) PRESET="vhs";; 3) PRESET="crt";;
      4) PRESET="8bit";; 5) PRESET="cyberpunk";; 6) PRESET="badsignal";;
      7) PRESET="tear";; 8) PRESET="datamosh";; 9) PRESET="nightvision";;
      10) PRESET="gameboy";; 11) PRESET="matrix";;
    esac
  fi

  # Step 3: Intensity
  if command -v fzf &>/dev/null; then
    local i_choice
    i_choice=$(printf '%s\n' \
      'med — ⚖️ Medium balanced intensity (50%, default)' \
      'low — 🌱 Subtle analog/digital touch (30%)' \
      'high — 🔥 Extreme hardware corruption (85%)' \
      'custom — 🔢 Enter custom numeric intensity (1-100)' | fzf --prompt="Select glitch intensity > " --height=35% --layout=reverse --border || true)
    case "${i_choice%% *}" in
      low|med|high) INTENSITY="${i_choice%% *}" ;;
      custom)
        printf "Enter intensity (1-100) [50]: "
        read -r int_in
        [[ "$int_in" =~ ^[0-9]+$ ]] && INTENSITY="$int_in"
        ;;
    esac
  fi

  # Step 4: Timing mode
  if command -v fzf &>/dev/null; then
    local b_choice
    b_choice=$(printf '%s\n' \
      'constant — 🌊 Continuous effect (always on)' \
      'organic-burst — ⚡ Erratic organic glitch bursts (recommended for realism)' \
      'burst — 💓 Periodic pulse every 2 seconds' | fzf --prompt="Select glitch timing > " --height=35% --layout=reverse --border || true)
    case "${b_choice%% *}" in
      burst) BURST=1 ;;
      organic-burst) BURST=1; BURST_ORGANIC=1 ;;
    esac
  fi

  # Step 5: Audio Glitch, HUD & Output Modifiers via fzf multi-select
  if command -v fzf &>/dev/null; then
    local ex_choice
    ex_choice=$(printf '%s\n' \
      'none — ✅ No extra modifiers (continue)' \
      'audio-glitch — 🔊 Corrupt audio in sync with visual preset (bitcrush / tape flutter)' \
      'osd — 🔴 Retro camcorder viewfinder HUD & blinking REC indicator' \
      'tracking — 📼 Scrolling VHS tracking distortion bar' \
      'mute — 🔇 Discard audio track (--mute)' \
      'trim — ✂️ Trim start/end timestamps (--from / --to)' \
      'force — ⚡ Overwrite existing output (--force)' | fzf -m --prompt="Extra modifiers ([Tab] multi-select) > " --height=45% --layout=reverse --border || true)
    if [ -n "$ex_choice" ]; then
      while IFS= read -r line; do
        case "${line%% *}" in
          audio-glitch) AUDIO_GLITCH=1 ;;
          osd) OSD=1 ;;
          tracking) TRACKING=1 ;;
          mute) MUTE=1 ;;
          force) FORCE=1 ;;
          trim)
            printf "Start time (e.g. 00:00:02, or Enter for start): "
            read -r st_in; [ -n "$st_in" ] && START="$st_in"
            printf "End time (e.g. 00:00:10, or Enter for end): "
            read -r et_in; [ -n "$et_in" ] && END="$et_in"
            ;;
        esac
      done <<< "$ex_choice"
    fi
  fi

  local eq_cmd="vidglitch"
  if [ "$HAS_CUSTOM" -eq 1 ]; then
    [ -n "$CUSTOM_RGB" ] && eq_cmd+=" --rgb-split $CUSTOM_RGB"
    [ "$SCANLINES" -eq 1 ] && eq_cmd+=" --scanlines"
    [ "$NOISE" -gt 0 ] && eq_cmd+=" --noise $NOISE"
    [ "$PIXELATE" -gt 0 ] && eq_cmd+=" --pixelate $PIXELATE"
    [ "$TEAR" -eq 1 ] && eq_cmd+=" --tear"
  else
    eq_cmd+=" --preset $PRESET"
  fi
  [ "$INTENSITY" != "med" ] && [ "$INTENSITY" != "50" ] && eq_cmd+=" --intensity $INTENSITY"
  if [ "$BURST" -eq 1 ]; then
    if [ "$BURST_ORGANIC" -eq 1 ]; then eq_cmd+=" --organic-burst"; else eq_cmd+=" --burst"; fi
  fi
  [ "$AUDIO_GLITCH" -eq 1 ] && eq_cmd+=" --audio-glitch"
  [ "$TRACKING" -eq 1 ] && eq_cmd+=" --tracking"
  [ "$OSD" -eq 1 ] && eq_cmd+=" --osd"
  [ "$MUTE" -eq 1 ] && eq_cmd+=" --mute"
  [ -n "$START" ] && eq_cmd+=" --from $START"
  [ -n "$END" ] && eq_cmd+=" --to $END"
  [ "$FORCE" -eq 1 ] && eq_cmd+=" --force"
  [ -n "$OUTPUT_DIR" ] && eq_cmd+=" -o \"$OUTPUT_DIR\""
  for f in "${FILES[@]}"; do eq_cmd+=" \"$f\""; done

  local timing_desc="Continuous (always on)"
  [ "$BURST" -eq 1 ] && timing_desc="Periodic pulse (2s)"
  [ "$BURST_ORGANIC" -eq 1 ] && timing_desc="Organic erratic bursts"

  wizard_confirm_and_run "vidglitch" "$eq_cmd" \
    "Files (${#FILES[@]})   : ${FILES[*]}" \
    "Preset / Mode : $([ "$HAS_CUSTOM" -eq 1 ] && echo "Custom stack" || echo "$PRESET") (intensity: $INTENSITY)" \
    "Timing        : $timing_desc" \
    "Extras        : audio-glitch=$([ "$AUDIO_GLITCH" -eq 1 ] && echo "on" || echo "off"), osd=$([ "$OSD" -eq 1 ] && echo "on" || echo "off"), tracking=$([ "$TRACKING" -eq 1 ] && echo "on" || echo "off")"
}

while [ "$#" -gt 0 ]; do case "$1" in
  -i|--interactive) INTERACTIVE=1; shift;;
  -p|--preset) PRESET="${2:?$1 requires a value}"; shift 2;;
  -I|--intensity) INTENSITY="${2:?$1 requires a value}"; shift 2;;
  --rgb-split) CUSTOM_RGB="${2:?$1 requires a value}"; HAS_CUSTOM=1; shift 2;;
  --scanlines) SCANLINES=1; HAS_CUSTOM=1; shift;;
  --noise) NOISE="${2:?$1 requires a value}"; HAS_CUSTOM=1; shift 2;;
  --pixelate) PIXELATE="${2:?$1 requires a value}"; HAS_CUSTOM=1; shift 2;;
  --tear) TEAR=1; HAS_CUSTOM=1; shift;;
  --burst) BURST=1; shift;;
  --organic-burst) BURST=1; BURST_ORGANIC=1; shift;;
  -A|--audio-glitch) AUDIO_GLITCH=1; shift;;
  --tracking) TRACKING=1; shift;;
  --osd|--hud) OSD=1; shift;;
  --mute) MUTE=1; shift;;
  --from) START="${2:?$1 requires a value}"; shift 2;;
  --to) END="${2:?$1 requires a value}"; shift 2;;
  -o|--output-dir) OUTPUT_DIR="${2:?$1 requires a value}"; shift 2;;
  -f|--force) FORCE=1; shift;;
  -n|--dry-run) DRY_RUN=1; shift;;
  -h|--help) usage; exit 0;;
  -*) echo "Unknown option: $1" >&2; usage >&2; exit 1;;
  *) FILES+=("$1"); shift;;
esac; done

if [ "$INTERACTIVE" -eq 1 ] || { [ "${#FILES[@]}" -eq 0 ] && [ -t 0 ]; }; then
  interactive_wizard
fi

[ "${#FILES[@]}" -gt 0 ] || { usage >&2; exit 1; }
require_commands ffmpeg ffprobe

# Convert intensity into numeric percentage (10..200, where 50 is 1.0x)
INT_NUM=50
case "$INTENSITY" in
  low)  INT_NUM=30 ;;
  med|medium) INT_NUM=50 ;;
  high|max) INT_NUM=85 ;;
  *)
    if [[ "$INTENSITY" =~ ^[0-9]+$ ]] && [ "$INTENSITY" -ge 1 ] && [ "$INTENSITY" -le 100 ]; then
      INT_NUM="$INTENSITY"
    else
      echo "❌ Error: --intensity must be low, med, high, or 1-100." >&2
      exit 1
    fi
    ;;
esac

scale_param() {
  local base="$1" min_val="${2:-1}"
  local scaled=$(( (base * INT_NUM + 25) / 50 ))
  [ "$scaled" -lt "$min_val" ] && scaled="$min_val"
  echo "$scaled"
}

BURST_EXPR=""
if [ "$BURST" -eq 1 ]; then
  if [ "$BURST_ORGANIC" -eq 1 ]; then
    BURST_EXPR="gt(sin(t*3.7)+cos(t*7.3)\\,1.10)"
  else
    BURST_EXPR="lt(mod(t\\,2)\\,0.35)"
  fi
fi

ENABLE_BURST=""
[ -n "$BURST_EXPR" ] && ENABLE_BURST=":enable='${BURST_EXPR}'"

if [ "$HAS_CUSTOM" -eq 1 ]; then
  VF=""
  if [ -n "$CUSTOM_RGB" ]; then
    [[ "$CUSTOM_RGB" =~ ^[0-9]+$ ]] || { echo "RGB split offset must be a positive integer." >&2; exit 1; }
    S_RGB=$(scale_param "$CUSTOM_RGB" 1)
    VF="${VF:+$VF,}rgbashift=rh=${S_RGB}:bh=-${S_RGB}:gv=2${ENABLE_BURST}"
  fi
  if [ "$SCANLINES" -eq 1 ]; then
    VF="${VF:+$VF,}drawgrid=w=iw:h=4:t=2:c=black@0.45${ENABLE_BURST}"
  fi
  if [ "$NOISE" -gt 0 ]; then
    S_NOISE=$(scale_param "$NOISE" 1)
    [ "$S_NOISE" -gt 100 ] && S_NOISE=100
    VF="${VF:+$VF,}noise=alls=${S_NOISE}:allf=t+u${ENABLE_BURST}"
  fi
  if [ "$PIXELATE" -gt 0 ]; then
    S_PIX=$(scale_param "$PIXELATE" 2)
    VF="${VF:+$VF,}pixelize=w=${S_PIX}:h=${S_PIX}${ENABLE_BURST}"
  fi
  if [ "$TEAR" -eq 1 ]; then
    S_TEAR=$(scale_param 48 8)
    VF="${VF:+$VF,}shufflepixels=w=${S_TEAR}:h=6:d=0:m=0${ENABLE_BURST}"
  fi
  TAG="glitch"
else
  case "$PRESET" in
    rgb-split)
      S_RGB=$(scale_param 10 2)
      S_GV=$(scale_param 2 1)
      VF="rgbashift=rh=${S_RGB}:bh=-${S_RGB}:gv=${S_GV}${ENABLE_BURST}"
      TAG="rgb-split"
      ;;
    vhs)
      S_NOISE=$(scale_param 15 4)
      S_RGB=$(scale_param 6 2)
      VF="noise=alls=${S_NOISE}:allf=t+u,eq=contrast=1.15:saturation=1.35:gamma=0.95,rgbashift=rh=${S_RGB}:bh=-${S_RGB}:gv=1${ENABLE_BURST},drawbox=x=0:y=mod(t*95\\,ih):w=iw:h=14:c=white@0.18:t=fill,vignette=PI/4"
      TAG="vhs"
      ;;
    crt)
      S_RGB=$(scale_param 6 2)
      VF="drawgrid=w=iw:h=4:t=2:c=black@0.45,rgbashift=rh=${S_RGB}:bh=-${S_RGB}${ENABLE_BURST},eq=contrast=1.2:saturation=1.2,vignette=PI/5"
      TAG="crt"
      ;;
    8bit)
      S_PIX=$(scale_param 12 4)
      VF="pixelize=w=${S_PIX}:h=${S_PIX}${ENABLE_BURST},eq=contrast=1.3:saturation=1.5"
      TAG="8bit"
      ;;
    cyberpunk)
      S_RGB=$(scale_param 16 4)
      S_TEAR=$(scale_param 40 12)
      if [ -n "$BURST_EXPR" ]; then
        VF="rgbashift=rh=${S_RGB}:bh=-${S_RGB}:gv=6${ENABLE_BURST},drawgrid=w=iw:h=6:t=2:c=black@0.3,eq=contrast=1.3:saturation=1.65,shufflepixels=w=${S_TEAR}:h=4:d=0:m=0${ENABLE_BURST}"
      else
        VF="rgbashift=rh=${S_RGB}:bh=-${S_RGB}:gv=6,drawgrid=w=iw:h=6:t=2:c=black@0.3,eq=contrast=1.3:saturation=1.65,shufflepixels=w=${S_TEAR}:h=4:d=0:m=0:enable='lt(mod(t\\,1.5)\\,0.2)'"
      fi
      TAG="cyberpunk"
      ;;
    badsignal)
      S_NOISE=$(scale_param 22 6)
      S_RGB=$(scale_param 22 6)
      S_TEAR=$(scale_param 60 16)
      VF="noise=alls=${S_NOISE}:allf=t+u,rgbashift=rh=${S_RGB}:bh=-${S_RGB}:bv=-6${ENABLE_BURST},shufflepixels=w=${S_TEAR}:h=8:d=0:m=0${ENABLE_BURST},drawgrid=w=iw:h=8:t=3:c=black@0.4"
      TAG="badsignal"
      ;;
    tear)
      S_TEAR=$(scale_param 48 12)
      S_RGB=$(scale_param 8 2)
      VF="shufflepixels=w=${S_TEAR}:h=6:d=0:m=0${ENABLE_BURST},rgbashift=rh=${S_RGB}:bh=-${S_RGB}${ENABLE_BURST}"
      TAG="tear"
      ;;
    datamosh)
      S_RGB=$(scale_param 10 2)
      VF="tblend=all_mode=difference128:all_opacity=0.35${ENABLE_BURST},tmix=frames=4:weights='4 2 1 1',rgbashift=rh=${S_RGB}:bh=-${S_RGB}${ENABLE_BURST},eq=contrast=1.25:saturation=1.4"
      TAG="datamosh"
      ;;
    nightvision)
      S_NOISE=$(scale_param 24 8)
      VF="hue=s=0,colorbalance=gm=0.65:gh=0.8:rm=-0.4:bm=-0.5,noise=alls=${S_NOISE}:allf=t+u,drawgrid=w=iw:h=4:t=1:c=black@0.35,vignette=PI/3.5"
      TAG="nightvision"
      ;;
    gameboy)
      S_PIX=$(scale_param 8 4)
      VF="pixelize=w=${S_PIX}:h=${S_PIX}${ENABLE_BURST},hue=s=0,eq=contrast=1.6:brightness=0.05,colorbalance=gm=0.45:gh=0.4:rm=-0.2:bm=-0.4,drawgrid=w=8:h=8:t=1:c=black@0.25"
      TAG="gameboy"
      ;;
    matrix)
      S_TEAR=$(scale_param 28 8)
      VF="hue=s=0,colorbalance=gm=0.75:gh=0.65:rm=-0.5:bm=-0.5,eq=contrast=1.35,shufflepixels=w=12:h=${S_TEAR}:d=0:m=0${ENABLE_BURST},drawgrid=w=iw:h=4:t=2:c=black@0.4"
      TAG="matrix"
      ;;
    *)
      echo "Unknown preset '$PRESET'. Choose from: rgb-split, vhs, crt, 8bit, cyberpunk, badsignal, tear, datamosh, nightvision, gameboy, matrix" >&2
      exit 1
      ;;
  esac
fi

if [ "$TRACKING" -eq 1 ] && [ "$PRESET" != "vhs" ]; then
  VF="${VF},drawbox=x=0:y=mod(t*95\\,ih):w=iw:h=16:c=white@0.22:t=fill"
fi

if [ "$OSD" -eq 1 ]; then
  # Viewfinder outer frame + blinking red REC indicator
  VF="${VF},drawbox=x=iw*0.04:y=ih*0.04:w=iw*0.92:h=ih*0.92:c=white@0.35:t=2,drawbox=x=iw*0.07:y=ih*0.07:w=16:h=16:c=red@0.85:t=fill:enable='lt(mod(t\\,1.2)\\,0.7)'"
fi

VF="${VF},format=yuv420p"

# Build optional audio glitch filter chain
AF=""
if [ "$AUDIO_GLITCH" -eq 1 ] && [ "$MUTE" -eq 0 ]; then
  case "$PRESET" in
    8bit|gameboy)
      AF="acrusher=level_in=1:level_out=1:bits=4:mode=log:aa=1${ENABLE_BURST},aresample=11025,aresample=44100"
      ;;
    vhs|crt)
      AF="highpass=f=120,lowpass=f=4200,vibrato=f=3.5:d=0.35${ENABLE_BURST},aecho=0.8:0.7:45:0.2"
      ;;
    *)
      AF="acrusher=bits=5:mix=0.65${ENABLE_BURST},vibrato=f=9:d=0.5${ENABLE_BURST},aecho=0.8:0.85:35|70:0.4|0.25"
      ;;
  esac
fi

[ -z "$OUTPUT_DIR" ] || OUTPUT_DIR="$(ensure_output_dir "$OUTPUT_DIR")"

SUCCESS=0; FAILED=0; SKIPPED=0
for input in "${FILES[@]}"; do
  if [ ! -f "$input" ]; then
    echo "⚠️  Not a file: $input" >&2
    FAILED=$((FAILED + 1))
    continue
  fi

  base="$(basename "${input%.*}")"
  out="${OUTPUT_DIR:-$(dirname "$input")}/${base}-${TAG}.mp4"

  if [ "$DRY_RUN" -eq 1 ]; then
    echo "📝 Would create: $out (preset: $TAG, intensity: $INTENSITY$([ "$AUDIO_GLITCH" -eq 1 ] && echo ", audio-glitch"))"
    continue
  fi

  if ! output_is_safe "$out" "$FORCE"; then
    SKIPPED=$((SKIPPED + 1))
    continue
  fi

  args=(-hide_banner -loglevel error -stats)
  [ -n "$START" ] && args+=(-ss "$START")
  args+=(-i "$input")
  [ -n "$END" ] && args+=(-to "$END")
  args+=(-vf "$VF" -c:v libx264 -crf 20 -preset medium)

  if [ "$MUTE" -eq 1 ]; then
    args+=(-an)
  else
    HAS_AUDIO=0
    AUDIO_STREAM=$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_type -of default=nw=1:nk=1 "$input" 2>/dev/null | head -n1 || true)
    [ "$AUDIO_STREAM" = "audio" ] && HAS_AUDIO=1
    if [ "$HAS_AUDIO" -eq 1 ]; then
      [ -n "$AF" ] && args+=(-af "$AF")
      args+=(-c:a aac -b:a 192k)
    else
      args+=(-an)
    fi
  fi
  args+=("$out")

  echo "▶️  $input → $out ($TAG, intensity: $INTENSITY)"
  if ffmpeg "${args[@]}"; then
    SUCCESS=$((SUCCESS + 1))
  else
    FAILED=$((FAILED + 1))
  fi
done

if [ "$DRY_RUN" -eq 0 ]; then
  echo "✅ Done: $SUCCESS video(s) glitched, $FAILED failed, $SKIPPED skipped"
  [ "$SUCCESS" -eq 0 ] || notify "Glitched $SUCCESS video(s)." "vidglitch"
fi
exit "$FAILED"
