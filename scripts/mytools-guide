#!/usr/bin/env bash
set -euo pipefail
SOURCE_PATH="${BASH_SOURCE[0]}"; while [ -h "$SOURCE_PATH" ]; do SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; SOURCE_LINK="$(readlink "$SOURCE_PATH")"; case "$SOURCE_LINK" in /*) SOURCE_PATH="$SOURCE_LINK";; *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_LINK";; esac; done; SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; source "$SCRIPT_DIR/lib/common.sh"

show_overview() {
  cat <<'EOF'
🧰 MYTOOLS - YOUR TERMINAL MEDIA SWISS ARMY KNIFE 🛠️

📸 IMAGE TOOLS 🪄
  img2webp       Convert JPEG, PNG, GIF, HEIC to WebP (shrink size without losing quality) ⚡

📥 WEB DOWNLOADS 🌐
  ytdl           Grab video/audio from web URLs via yt-dlp 🌐

🎞️ VIDEO TOOLS 🎬
  vidglue        Glue, crossfade & collage MP4 files (copy, normalize, xfade, 🪃 --bounce, --layout)
  vid2webm       Convert video to modern VP9/Opus WebM 🌐
  vid2gif        Convert video clips to high-quality animated GIFs 👾
  videoWithoutAudio  Create a muted video (optionally preserve audio tracks) 🔇
  vidoptim       Re-encode videos for web, social, or archive presets 🚀
  vidglitch      Apply glitch, CRT, VHS, datamosh, nightvision & audio glitch FX ⚡
  vidcuts        Cut film, BPM beat cuts, freeze-cuts & auto-silence jump-cuts ✂️
  videoeffects   Cinematic color grading, speed/slow-mo, optics, mirror & framing FX (alias: vidfx) 🎬
  videorandfram  Randomize frame order, temporal stutter & micro-jitter (alias: vidrandfram) 🎲

🎵 AUDIO TOOLS 🎧
  vid2audio      Extract crisp audio streams from video (WAV / MP3) 🔊
  wav2mp3        Convert heavy WAV audio to lightweight MP3 🎶
  wav2tempo      Retime WAV tempo to a target BPM using aubio 🥁
  wavreverse     Reverse WAV audio sample-accurately 🔄
  wavpitch       Shift WAV pitch by semitones (preserve tempo or varispeed) 🎼
  wavnorm        Normalize WAV volume (EBU R128 LUFS or Peak dBFS) 🎚️
  wavfade        Apply smooth fade-in and fade-out volume envelopes 📈
  wavtrim        Strip leading and trailing silence from WAV audio ✂️
  wavfx          Apply DSP audio effects (reverb, delay, low/high pass filters) 🎛️

🕵️ MEDIA INSPECTION 🔍
  media-info     Inspect video/audio codecs, duration, bitrate, resolution 🔍

📂 FINDER & BOOKMARKS 📑
  thumloc        Generate Finder thumbnail previews for .webloc files 🖼️
  webloc2md      Create a structured Markdown index of bookmark URLs 📝

⚙️ HEALTH & CONFIGURATION 🩺
  doctor         Check & auto-install missing dependencies (ffmpeg, webp, aubio...) 🩺
  config         Show/edit user configuration presets (~/.config/mytools/config) 🛠️
  guide          Interactive help browser & cheat-sheets 📖

🧭 STEP-BY-STEP: HOW TO USE TOOLS WITH CUSTOM COMMANDS
  ⚠️  Two Common Gotchas:
      1. No 'mytools' prefix needed — each tool is a standalone command (run 'img2webp -a',
         not 'mytools img2web -a'; though 'mytools <tool> [args]' also forwards for convenience).
      2. Watch the exact tool name — the image tool ends with a 'p': 'img2webp' (not 'img2web').

  Step 1: Go to the folder with your files in Terminal
          cd ~/Pictures/MyPhotos   (Tip: type 'cd ' and drag-and-drop a folder from Finder)
  Step 2: Run the tool directly with custom flags
          img2webp -a                              # all images in current folder
          img2webp --width 1200 -q 90 -a           # resize to 1200px & 90% quality
          img2webp -q 80 photo.jpg                 # single file
          img2webp --width 1200 -q 90 -a -n        # preview safely first (-n / --dry-run)
  Step 3: Or use Interactive Wizard Mode (-i) to build commands step-by-step
          img2webp -i   |   vidglitch -i   |   vidcuts -i
          (Walks you through every option and prints the exact custom command for next time!)

💡 PRO TIPS 🚀
  • Run 'mytools' for the interactive launcher menu 🎯
  • In launcher file selection: Press [Tab] to mark multiple files, then [Enter] to confirm! 📌
  • Run 'mytools help <tool>' (e.g., 'mytools help img2webp') for a detailed guide 📖
  • Run 'mytools guide' (or 'mytools g') to interactively browse help & cheat-sheets 🔍
EOF
}

show_tool_help() {
  local tool="$1"
  case "$tool" in
    vidglue|videoglue|mp4glue)
      cat <<'EOF'
🎞️ vidglue — Glue, Crossfade & Collage MP4 Video Files 🧲

Usage:
  vidglue [options] <video1> <video2...>
  vidglue --bounce [options] <video>

Description:
  Fuses multiple video files into a single seamless MP4 output file! 🎬
  Uses lightning-fast stream copy (-c copy) by default, or auto-normalizes mixed
  resolutions/aspect ratios (--fit pad|crop|blur) and missing audio tracks.
  Supports smooth xfade transitions (-t), spatial split-screen collages (--layout),
  and instant Boomerang forward-and-rewind loops (--bounce / --loop)! 🪃

Options:
  -i, --interactive            Interactive guided wizard 🧙
  -o, --output <file>          Output MP4 file path (default: <first-video>-glued.mp4) 💾
  -b, --bounce                 Play 1st video forward and 2nd reversed (or forward + reversed for 1 video) 🪃
  -r, --reencode               Force stream re-encoding & smart resolution/audio normalization ⚙️
  --fit <pad|crop|blur>        How to fit mixed aspect ratios (pad, crop, or blurred background) 🖼️
  --resolution <res>           Target resolution (auto, 1080p, 720p, vertical, square, or WxH) 📐
  -t, --transition <type>      Crossfade transition (fade, fadeblack, fadewhite, dissolve, wipeleft, pixelize, radial...) ✨
  --transition-duration <sec>  Transition duration in seconds (default: 0.5) ⏱️
  --layout, --grid <mode>      Spatial collage layout: hstack (side-by-side), vstack (top/bottom), 2x2 (quad) ◫
  -l, --loop <N>               Repeat the glued sequence N times 🔁
  --mute                       Discard audio from the output video 🔇
  -f, --force                  Overwrite existing output file ⚡
  -n, --dry-run                Preview planned output without running FFmpeg 📝

Examples:
  vidglue -i                                         # launch interactive wizard
  vidglue clip1.mp4 clip2.mp4                        # fast stream copy
  vidglue --bounce -l 3 clip.mp4                     # 🪃 bounce loop repeated 3x
  vidglue --reencode --fit blur horiz.mp4 vert.mp4   # mix horizontal & vertical with blurred background
  vidglue -t fade --transition-duration 0.8 a.mp4 b.mp4
  vidglue --layout hstack left.mp4 right.mp4         # side-by-side split screen
EOF
      ;;
    img2webp|img2web)
      cat <<'EOF'
📸 img2webp — Image to WebP Converter 🪄

Usage:
  img2webp [options] [image... or directory]

Description:
  Converts JPEG, PNG, GIF, TIFF, HEIC to lightweight, ultra-optimized WebP images! ⚡
  ⚠️ Note: Run 'img2webp' directly (no 'mytools' prefix needed, and note the 'p' at the end — not 'img2web').

Options:
  -i, --interactive      Interactive wizard (prompts for settings & files) 🧙
  -a, --all              Process all images in current directory 📂
  -q, --quality <0-100>  Quality factor (default: 85) 🎯
  -w, --width <px>       Downscale image to maximum width 📐
  -H, --height <px>      Downscale image to maximum height 📐
  -r, --resize <WxH>     Exact resize dimensions 📐
  -l, --lossless         Lossless encoding 💎
  -R, --recursive        Search directories recursively 📁
  -j, --jobs <N>         Number of parallel conversion jobs 🚀
  -o, --output-dir <d>   Write output files to directory 📂
  -f, --force            Overwrite existing output ⚡
  -d, --delete-original  Delete original after conversion 🗑️
  -n, --dry-run          Preview conversions without running 📝

Step-by-Step How to Apply:
  1. Move to your images folder:  cd ~/Pictures/MyPhotos
  2. Run with custom flags:       img2webp --width 1200 -q 90 -a
  3. Or launch guided wizard:     img2webp -i  (prints equivalent command at the end!)

Examples:
  img2webp -i                             # launch interactive wizard
  img2webp -a                             # convert all images in current folder
  img2webp --width 1200 -q 90 -a          # convert all images in current folder (1200px, q90)
  img2webp -width 1200 -q 90 .            # single-dash flags supported
  img2webp photo.jpg
  img2webp -q 80 --width 1200 photo.png
  img2webp -R -j 4 -o ./webp ~/Pictures
EOF
      ;;
    vid2webm)
      cat <<'EOF'
🌐 vid2webm — Video to WebM Transcoder 🎬

Usage:
  vid2webm [options] <video...>

Description:
  Converts video clips to modern WebM format powered by VP9 video & Opus audio codecs. 🚀

Options:
  -q, --quality <0-63>  VP9 CRF quality (default: 30; lower is higher quality) 🎯
  -w, --width <px>      Downscale to maximum width 📐
  -o, --output-dir <d>  Output directory 📂
  --from <time>         Trim start time (HH:MM:SS or seconds) ✂️
  --to <time>           Trim end time (HH:MM:SS or seconds) ✂️
  -f, --force           Overwrite existing file ⚡
  -n, --dry-run         Preview output path 📝

Examples:
  vid2webm clip.mov
  vid2webm -q 25 -w 1280 --from 00:00:10 --to 00:00:25 recording.mp4
EOF
      ;;
    vid2gif)
      cat <<'EOF'
👾 vid2gif — Video to Animated GIF Generator 🎨

Usage:
  vid2gif [options] <video...>

Description:
  Transforms video clips into buttery smooth, palette-optimized animated GIFs! ✨

Options:
  -w, --width <px>      GIF max width (default: 480) 📐
  -r, --fps <N>         Frames per second (default: 12) ⏱️
  --from <time>         Start time ✂️
  --to <time>           End time ✂️
  -o, --output-dir <d>  Output directory 📂

Examples:
  vid2gif demo.mov
  vid2gif -w 600 -r 15 --from 00:00:02 --to 00:00:06 demo.mp4
EOF
      ;;
    vidoptim|media-optimize)
      cat <<'EOF'
🚀 vidoptim — Optimize Video for Web/Social/Archive 🎬

Usage:
  vidoptim [options] <video...>

Description:
  Re-encodes videos using tailored quality presets defined in ~/.config/mytools/config. ⚡

Presets:
  🌐 web       H.264, CRF 23, max 1080p width (default)
  📱 social    H.264, CRF 25, max 720p width
  📦 archive   H.265, CRF 26, source dimensions

Options:
  -p, --preset <name>  Preset section name (web|social|archive) ⚙️
  -o, --output-dir <d> Output directory 📂
  -f, --force          Overwrite existing output ⚡
  -n, --dry-run        Preview output path 📝

Examples:
  vidoptim video.mov
  vidoptim --preset social -o ./social *.mov
EOF
      ;;
    vidglitch|videoglitch)
      cat <<'EOF'
⚡ vidglitch — Glitch, VHS & Retro Visual/Audio Effects Generator 👾

Usage:
  vidglitch [options] <video...>

Description:
  Applies stylish digital and analog glitch effects directly to video files! 🎨
  Includes 11 presets, adjustable intensity, organic hardware bursts, camcorder HUD (--osd),
  and synchronized audio bitcrushing/tape-flutter corruption (--audio-glitch).

Presets:
  🌈 rgb-split    Chromatic aberration (red/blue channel shift) (default)
  📼 vhs          Analog tape noise, scrolling tracking bar, color bleed & vignette
  📺 crt          Retro arcade scanlines with subtle chromatic shift
  🕹️ 8bit         Pixelated block retro gaming aesthetic
  🌆 cyberpunk    Neon chromatic aberration, scanlines, and intermittent tearing
  📡 badsignal    Heavy static noise, extreme channel shifts, and data distortion
  ⚡ tear         Horizontal data glitch displacement
  🌊 datamosh     Motion pixel smear & frame persistence ghosting trails
  🟢 nightvision  Tactical green phosphor monochrome, high-ISO grain & scanlines
  🟩 gameboy      4-shade retro handheld LCD green pixel matrix
  💻 matrix       Digital green code phosphor & vertical block displacement

Options:
  -i, --interactive       Interactive guided wizard 🧙
  -p, --preset <name>     Select glitch preset (default: rgb-split) ⚙️
  -I, --intensity <level> Strength: low, med, high, or 1-100 (default: med) 🔥
  --burst                 Pulse glitch periodically every ~2s 💓
  --organic-burst         Trigger glitch in erratic, organic hardware bursts ⚡
  -A, --audio-glitch      Corrupt audio in sync with visual preset (bitcrush / tape flutter) 🔊
  --tracking              Add scrolling VHS tracking distortion bar 📼
  --osd                   Add retro camcorder viewfinder HUD & blinking REC indicator 🔴
  --rgb-split <px>        Shift red/blue color channels (e.g. 15) 🌈
  --scanlines             Add CRT scanline overlay 📺
  --noise <level>         Add analog video noise (1-100, e.g. 15) 📻
  --pixelate <factor>     Pixelate video into blocks (e.g. 10) 🕹️
  --tear                  Add horizontal data glitch tearing ⚡
  --mute                  Discard audio track from output video 🔇
  --from / --to <time>    Start/end timestamps ✂️
  -o, --output-dir <d>    Write output files to directory 📂
  -f, --force             Overwrite existing output ⚡
  -n, --dry-run           Preview output without running FFmpeg 📝

Examples:
  vidglitch -i                                              # interactive guided wizard
  vidglitch clip.mp4
  vidglitch --preset vhs --audio-glitch --osd recording.mov # VHS + tape flutter + camcorder HUD
  vidglitch --preset cyberpunk --organic-burst promo.mp4
  vidglitch --preset datamosh -I high dance.mp4
  vidglitch --preset 8bit -A -o ./glitched *.mp4
EOF
      ;;
    vidcuts|videocuts|filmcut)
      cat <<'EOF'
✂️ vidcuts — Cut Film, Jump-Cuts, Beat Cuts & Silence Remover 🎞️

Usage:
  vidcuts [options] <video...>

Description:
  Erases a chosen percentage of random frames, rhythmic BPM beats, or silent pauses!
  Supports shorter jump-cut timelines, constant-duration freeze-cuts (--mode freeze),
  BPM-synced music cuts (--mode beat), and automatic vlog silence stripping (--mode silence).

Options:
  -p, --percent <N>    Percentage of frames to cut out (1-90, default: 20) 🎯
  -m, --mode <mode>    Cut style (default: frames) 🎬
                       • frames:  Erase random single frames (missing celluloid)
                       • jumps:   Excise micro-chunks (~0.2s jump cuts)
                       • stutter: Rapid 2-frame skips (projector chatter)
                       • freeze:  Drop frames & freeze-hold survivors (keeps original duration & audio!)
                       • beat:    Cut rhythmically in sync with BPM (--bpm or aubio auto-detect)
                       • silence: Auto-strip silent pauses (vlogger / podcast jump-cut editor)
  -i, --interactive    Interactive wizard (prompts for settings & files) 🧙
  --bpm <N>            Target BPM for '--mode beat' 🥁
  --threshold <dB>     Silence threshold in dB for '--mode silence' (default: -38) 🎙️
  --keep-audio         Keep continuous original audio without cutting it 🎵
  --seed <int>         Seed for random cut pattern (reproducible cuts) 🎲
  --jitter             Add mechanical film projector gate weave/jitter 📽️
  --grain              Add analog 16mm/35mm film grain 🎞️
  --flash              Add occasional white splice tape flashes ⚡
  --film-burn          Add warm orange/amber celluloid light-leak burn flashes 🔥
  --scratches          Add vertical 16mm film scratches 🎞️
  --super8             Add dark Super-8 film gate border & optical vignette 🎥
  --mute               Discard audio track from output 🔇
  --from / --to <time> Start/end timestamps ✂️
  -o, --output-dir <d> Write output files to directory 📂
  -f, --force          Overwrite existing output ⚡
  -n, --dry-run        Preview output without running FFmpeg 📝

Examples:
  vidcuts clip.mp4                                         # 20% random frame drops
  vidcuts -p 35 --mode jumps recording.mov                 # 35% shorter with chunk jump cuts
  vidcuts -p 40 --mode freeze --film-burn musicvideo.mp4   # freeze-cuts keeping original song intact
  vidcuts --mode beat --bpm 128 --flash dance.mp4          # rhythmic cuts synced to 128 BPM
  vidcuts --mode silence interview.mp4                     # auto-remove dead air from talking head video
  vidcuts -p 20 --jitter --grain --scratches --super8 v.mp4 # full 16mm/Super-8 damaged film look
EOF
      ;;
    videoeffects|vidfx)
      cat <<'EOF'
🎬 videoeffects (vidfx) — Cinematic Color Grading, Speed, Optics & Spatial FX ✨

Usage:
  videoeffects [options] <video...>
  vidfx [options] <video...>

Description:
  Modular video effects suite for color grading looks, speed/slow-motion, reverse playback,
  optical bloom/tilt-shift, kaleidoscope mirrors, Ken Burns zoom, and cinema letterboxing!
  Combine multiple flags in a single pass.

Presets (-p, --preset):
  🎬 cinema       Blockbuster teal & orange color grade
  🕵️ noir         High-contrast silver-halide B&W + grain + vignette
  🎞️ vintage      Warm 1970s faded Kodachrome film
  ☀️ kodak        Golden-hour 35mm analog film stock
  ✨ dream        Ethereal soft highlight bloom & pastel warmth
  🌆 synthwave    Neon magenta/cyan split-toning
  🌡️ thermal      Infrared false-color heat vision
  ⚔️ bleach       Gritty desaturated bleach bypass
  📜 sepia        Classic archival warm sepia tone

Time, Optics & Framing Options:
  -i, --interactive           Interactive guided multi-effect wizard 🧙
  --speed <0.25..4.0>         Playback speed multiplier (e.g. 0.5 slow-mo, 2.0 fast) ⏱️
  --smooth-slowmo             Optical-flow motion interpolation (minterpolate) 🌊
  --reverse                   Reverse video and audio streams backward 🔄
  --stopmotion <fps>          Claymation / anime frame-step look (e.g. 8 or 12 fps) 🧱
  --trails <1-10>             Motion ghosting / phosphor trails ☄️
  --vignette                  Optical lens vignette darkening 🌑
  --bloom, --glow             Soft highlight halation glow 🌟
  --blur <sigma>              Gaussian blur strength 🌫️
  --tilt-shift                Miniature toy-world focus band 🏙️
  --sharpen                   Crisp unsharp mask edge enhancement 🔪
  --mirror <h|v|quad>         Kaleidoscope symmetry (horizontal, vertical, or 4-way quad) 🪞
  --zoom <in|out>             Smooth Ken Burns push-in or pull-out 🔍
  --letterbox <2.35|1.85|4:3> CinemaScope widescreen bars or 4:3 pillarbox 🖼️
  --fade-in / --fade-out <s>  Smooth video & audio fade from/to black 🌅
  --rotate <90|180|270>       Rotate clockwise in degrees 🔄
  --flip <h|v>                Flip horizontally or vertically 🔃

Examples:
  videoeffects -i                                           # interactive guided wizard
  videoeffects --preset cinema --letterbox 2.35 clip.mp4    # widescreen blockbuster look
  videoeffects --speed 0.5 --smooth-slowmo action.mp4       # silky 2x slow-motion
  videoeffects --mirror quad --preset synthwave dance.mp4   # 4-way neon kaleidoscope
  vidfx --reverse --bloom --trails 6 dream.mov              # reversed ethereal motion trails
EOF
      ;;
    videorandfram|vidrandfram)
      cat <<'EOF'
🎲 videorandfram (vidrandfram) — Randomize Frame Order & Temporal Glitch ⚡

Usage:
  videorandfram [options] <video...>
  vidrandfram [options] <video...>

Description:
  Randomizes and scrambles video frame order in time to produce kinetic stutter,
  shutter tremor, stop-motion breakbeat skips, surreal time-warp loops,
  and full non-linear temporal chaos!

Presets (-p, --preset):
  🎲 shuffle     Balanced temporal scramble (cache window: 30 frames ~1s, default)
  ⚡ jitter      Micro-window tremor / anxiety-shutter jitter (cache: 4 frames)
  📽️ stutter     Rhythmic stop-motion chatter / breakbeat skip (cache: 14 frames)
  🌀 vortex      Deep surreal time-warp loop (cache: 120 frames ~4s)
  💥 chaos       Maximum non-linear temporal collision (cache: 300+ frames)
  👁️ flicker     Alternating adjacent frame swaps (50/60fps kinetic cinema flicker)
  ⏪ reverse     Periodic reversed 8-frame chunks (rewind glitch pulses)
  ⚡ burst       Intermittent frame scramble bursts during normal playback

Options:
  -w, --window <N>            Custom frame cache window size (2 to 512) 🪟
  -s, --seed <int>            Deterministic random seed (100% reproducible cuts) 🎲
  --fps <N>                   Target output frame rate (e.g. 12 or 15 for stop-motion) ⏱️
  --trails, --blend [factor]  Motion ghosting trails between randomized frames (1-10) 🌌
  --audio <mode>              Audio handling: keep (default), mute, stutter, crush 🎵
  --flash                     Add random white splice tape flashes ⚡
  --rgb-split [px]            Add chromatic aberration channel shift (default: 8px) 🌈
  --grain                     Add analog 16mm/35mm film grain 🎞️
  --super8                    Add dark vintage Super-8 frame border & vignette 🎥
  --mute                      Discard audio track from output 🔇
  --from / --to <time>        Start/end trim timestamps ✂️
  -o, --output-dir <dir>      Write output files to directory 📂
  -f, --force                 Overwrite existing output ⚡
  -n, --dry-run               Preview output without running FFmpeg 📝
  -i, --interactive           Interactive wizard (prompts for settings & files) 🧙

Examples:
  videorandfram clip.mp4                                         # 30-frame temporal shuffle
  videorandfram -p jitter recording.mov                          # high-speed micro-jitter shutter
  videorandfram -p stutter --fps 12 dance.mp4                    # stop-motion 12fps breakbeat stutter
  videorandfram -p vortex --trails 5 --audio keep promo.mp4      # dreamlike surreal time warp + trails
  videorandfram -p chaos -w 450 -s 42 visual.mp4                 # reproducible deep temporal explosion
  videorandfram -p flicker --rgb-split 12 music.mp4              # kinetic 60fps frame alternation + chromatic shift
  videorandfram -p burst --audio stutter action.mp4              # periodic frantic scramble bursts + choppy audio
  videorandfram -i                                               # interactive guided wizard
EOF
      ;;
    vid2audio|videoWithoutAudio|wav2mp3|wav2tempo|wavreverse|wavpitch|wavnorm|wavfade|wavtrim|wavfx)
      case "$tool" in
        vid2audio)
          cat <<'EOF'
🔊 vid2audio — Extract Video Audio 🎧

Usage:
  vid2audio [--format wav|mp3] [--bitrate <kbps>] <video...>

Description:
  Rips crystal-clear audio streams out of video files into WAV or MP3! 🎶
EOF
          ;;
        videoWithoutAudio)
          cat <<'EOF'
🔇 videoWithoutAudio — Create a Video Without Audio 🎬

Usage:
  videoWithoutAudio [options] <video...>

Description:
  Creates a video copy with no audio and discards the source audio by default.
  Pass --extract-audio to preserve every original audio stream as its own
  lossless-copy .mka file. The source video is never modified.

Examples:
  videoWithoutAudio interview.mp4
  videoWithoutAudio --extract-audio -o ./separated recording.mov
  videoWithoutAudio --dry-run *.mp4
EOF
          ;;
        wav2mp3)
          cat <<'EOF'
🎧 wav2mp3 — WAV to MP3 Shrinker 🎶

Usage:
  wav2mp3 [--bitrate <kbps>] <wav...>

Description:
  Converts heavy uncompressed WAV audio into compact, high-quality MP3 files! 📦
EOF
          ;;
        wav2tempo)
          cat <<'EOF'
🥁 wav2tempo — Retime WAV Audio by BPM ⏱️

Usage:
  wav2tempo [--target-bpm <BPM>] [--bpm <sourceBPM>] <wav...>

Description:
  Detects audio BPM using aubio, then retimes audio pitch-preservingly via FFmpeg magic! 🪄
EOF
          ;;
        wavreverse)
          cat <<'EOF'
🔄 wavreverse — Reverse WAV Audio 🪃

Usage:
  wavreverse <wav...>

Description:
  Reverses sample audio upside down to create <name>-reversed.wav! 🎶
EOF
          ;;
        wavpitch)
          cat <<'EOF'
🎼 wavpitch — WAV Pitch Shifter 🎵

Usage:
  wavpitch [--semitones <n>] [--varispeed] <wav...>

Description:
  Shifts WAV audio pitch by semitones while preserving tempo!
  Pass --varispeed to link pitch and playback speed (tape/vinyl speed drop effect).
EOF
          ;;
        wavnorm)
          cat <<'EOF'
🎚️ wavnorm — Volume Normalizer 🔊

Usage:
  wavnorm [--lufs <n>] [--peak <dB>] <wav...>

Description:
  Normalizes audio volume to target integrated LUFS (EBU R128 standard)
  or sample-accurate peak dBFS level!
EOF
          ;;
        wavfade)
          cat <<'EOF'
📈 wavfade — Fade In/Out Envelopes 🎶

Usage:
  wavfade [--in <sec>] [--out <sec>] [--curve <type>] <wav...>

Description:
  Applies smooth volume fade-in and fade-out curves to eliminate pops and clicks!
EOF
          ;;
        wavtrim)
          cat <<'EOF'
✂️ wavtrim — Silence Stripper 🔇

Usage:
  wavtrim [--threshold <dB>] [--start-only] [--end-only] <wav...>

Description:
  Automatically detects and strips silence from the start and end of WAV audio!
EOF
          ;;
        wavfx)
          cat <<'EOF'
🎛️ wavfx — Audio DSP Effects 🌌

Usage:
  wavfx [--reverb room|hall|space] [--delay <ms>] [--lowpass <Hz>] [--highpass <Hz>] <wav...>

Description:
  Applies DSP audio effects: room/hall/space reverb presets, echo delays, low-pass and high-pass filters!
EOF
          ;;
      esac
      ;;
    media-info)
      cat <<'EOF'
🕵️ media-info — Inspect Media File Metadata 🔍

Usage:
  media-info <file...>

Description:
  Inspects video/audio codecs, resolution, duration, bitrate, and size down to the byte! 📊
EOF
      ;;
    ytdl)
      cat <<'EOF'
📥 ytdl — Media Grabber 🌐

Usage:
  ytdl [--format mp4|mp3] [--playlist] [URL]

Description:
  Downloads media from web links using yt-dlp. Automatically checks your clipboard for URLs! 📋
EOF
      ;;
    thumloc|webloc2md)
      cat <<'EOF'
📂 Finder & Bookmarks Tools 📑

Commands:
  🖼️ thumloc    Generate Finder thumbnail previews for .webloc bookmark files
  📝 webloc2md  Create a structured Markdown index of bookmark URLs
EOF
      ;;
    doctor|config)
      case "$tool" in
        doctor)
          cat <<'EOF'
🩺 doctor — Dependency Check & Auto-Install 🛠️

Usage:
  mytools doctor [--install]

Description:
  Checks required Homebrew packages (ffmpeg, webp, aubio, yt-dlp, fzf...).
  Pass --install to automatically prescribe and install missing packages! 💊
EOF
          ;;
        config)
          cat <<'EOF'
⚙️ config — Presets Configuration Lab 🛠️

Usage:
  mytools config [--init|--path|--list]

Description:
  Manages your editable configuration file (~/.config/mytools/config). 📝
EOF
          ;;
      esac
      ;;
    custom-commands|how-to-apply|launcher-tips)
      cat <<'EOF'
🧭 Step-by-Step: Custom Commands & Launcher Tips 🎯

⚠️ Two Important Observations When Running Custom Commands:
  1. You do NOT need 'mytools' in front of individual tool commands!
     • 'mytools' is the interactive menu launcher.
     • Each tool ('img2webp', 'vidglue', 'vid2webm', 'wav2mp3', etc.) is run directly by its own name.
       (Though 'mytools <tool> [options]' also works and forwards automatically.)
  2. Watch the exact tool name:
     • The image converter ends with a 'p': 'img2webp' (not 'img2web').

Step-by-Step Workflow in Terminal:
  Step 1: Go to the folder where your files are
          cd ~/Pictures/MyPhotos
          (Tip: Type 'cd ' with a space, drag-and-drop your folder from Finder into Terminal, and press Enter.)

  Step 2: Run the tool directly with your flags
          img2webp -a                                # convert all images in current folder
          img2webp --width 1200 -q 90 -a             # resize to 1200px wide at 90% quality
          img2webp -q 80 photo.jpg                   # convert one specific file
          img2webp -q 90 -o ./webp-output -a         # save into a separate subfolder
          img2webp --width 1200 -q 90 -a -n          # preview safely first (-n / --dry-run)

  Step 3: Easiest Way to Learn Custom Commands — Use Wizard Mode (-i)
          img2webp -i   |   vidglitch -i   |   vidcuts -i
          Walks you through every setting step by step and prints the exact 'Equivalent command'
          before running so you can copy it for next time!

Multi-file Selection in 'mytools' Interactive Launcher:
  1. Run 'mytools' and pick a tool.
  2. Use ↑ / ↓ arrow keys to navigate your files. 🎯
  3. Press [Tab] to mark each file you want to include (a '>' indicator appears). 📌
  4. Press [Enter] to confirm and execute! 🚀
EOF
      ;;
    *)
      if [ -f "$SCRIPT_DIR/$tool" ]; then
        bash "$SCRIPT_DIR/$tool" --help
      else
        echo "❓ Unknown tool: $tool" >&2
        echo "💡 Run 'mytools help' for a list of available commands." >&2
        exit 1
      fi
      ;;
  esac
}

interactive_guide() {
  command -v fzf >/dev/null 2>&1 || {
    show_overview
    exit 0
  }
  
  local topics
  topics=$(printf '%s\n' \
    'custom-commands — 🧭 Step-by-step: How to apply tools with custom flags' \
    'img2webp — 📸 Convert images to WebP (wizard: img2webp -i)' \
    'ytdl — 📥 Download web media' \
    'vidglue — 🎞️ Glue, crossfade & collage MP4 videos (wizard: vidglue -i)' \
    'vidglitch — ⚡ Glitch, CRT, VHS, datamosh & retro FX (wizard: vidglitch -i)' \
    'vidcuts — ✂️ Cut film, BPM beat cuts & silence remover (wizard: vidcuts -i)' \
    'videoeffects — 🎬 Cinematic color grading, speed & optical FX (wizard: videoeffects -i)' \
    'videorandfram — 🎲 Randomize frame order & temporal glitch (wizard: videorandfram -i)' \
    'vidoptim — 🚀 Web/social/archive video optimization' \
    'vid2webm — 🌐 Convert videos to WebM' \
    'vid2gif — 👾 Create animated GIFs' \
    'videoWithoutAudio — 🔇 Remove audio (optionally preserve tracks)' \
    'vid2audio — 🔊 Extract audio from video' \
    'wav2mp3 — 🎧 Convert WAV to MP3' \
    'wav2tempo — 🥁 Retime WAV by BPM' \
    'wavreverse — 🔄 Reverse WAV audio' \
    'wavpitch — 🎼 Shift WAV pitch by semitones' \
    'wavnorm — 🎚️ Normalize WAV loudness or peak volume' \
    'wavfade — 📈 Apply fade in and fade out envelopes' \
    'wavtrim — ✂️ Strip leading and trailing silence' \
    'wavfx — 🎛️ Apply reverb, delay, and EQ filters' \
    'media-info — 🕵️ Inspect media codec & details' \
    'thumloc — 🖼️ Finder bookmark thumbnails' \
    'webloc2md — 📑 Bookmark markdown index' \
    'doctor — 🩺 Dependency check & installer' \
    'config — ⚙️ User settings & presets' \
    'launcher-tips — 💡 Multi-file selection & keybindings' \
  )

  while true; do
    local choice
    choice=$(echo "$topics" | fzf \
      --prompt='mytools guide > ' \
      --header='💡 Select a tool or topic to view detailed guide & launch wizard ([Esc] exit)' \
      --height=85% \
      --layout=reverse \
      --border \
      --preview="bash \"$SOURCE_PATH\" preview {1}" \
      --preview-window=right:60%:wrap || true)
    
    [ -n "$choice" ] || exit 0
    local tool="${choice%% *}"
    show_tool_help "$tool"
    echo ""

    if [ -t 0 ]; then
      case "$tool" in
        img2webp|vidglue|vidglitch|vidcuts|videoeffects|videorandfram|vidrandfram)
          local next_act
          next_act=$(printf '%s\n' \
            "wizard — 🧙 Launch '$tool -i' interactive wizard right now" \
            "back — 🔙 Back to guide browser" \
            "exit — 👋 Exit guide" | fzf --prompt="$tool > " --height=30% --layout=reverse --border || true)
          case "${next_act%% *}" in
            wizard) exec "$SCRIPT_DIR/$tool" -i ;;
            back) continue ;;
            *) exit 0 ;;
          esac
          ;;
        doctor|config)
          local next_act
          next_act=$(printf '%s\n' \
            "run — 🚀 Run 'mytools $tool' now" \
            "back — 🔙 Back to guide browser" \
            "exit — 👋 Exit guide" | fzf --prompt="$tool > " --height=30% --layout=reverse --border || true)
          case "${next_act%% *}" in
            run) exec "$SCRIPT_DIR/mytools-$tool" ;;
            back) continue ;;
            *) exit 0 ;;
          esac
          ;;
        *)
          local next_act
          next_act=$(printf '%s\n' \
            "back — 🔙 Back to guide browser" \
            "launcher — 🧰 Open 'mytools' interactive launcher" \
            "exit — 👋 Exit guide" | fzf --prompt="guide > " --height=30% --layout=reverse --border || true)
          case "${next_act%% *}" in
            back) continue ;;
            launcher) exec "$SCRIPT_DIR/mytools" ;;
            *) exit 0 ;;
          esac
          ;;
      esac
    else
      break
    fi
  done
}

case "${1:-}" in
  preview)
    show_tool_help "${2:-overview}"
    ;;
  -i|--interactive|guide)
    interactive_guide
    ;;
  -h|--help)
    show_overview
    ;;
  "")
    show_overview
    ;;
  *)
    show_tool_help "$1"
    ;;
esac
