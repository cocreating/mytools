#!/usr/bin/env bash
set -euo pipefail
SOURCE_PATH="${BASH_SOURCE[0]}"; while [ -h "$SOURCE_PATH" ]; do SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; SOURCE_LINK="$(readlink "$SOURCE_PATH")"; case "$SOURCE_LINK" in /*) SOURCE_PATH="$SOURCE_LINK";; *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_LINK";; esac; done; SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; source "$SCRIPT_DIR/lib/common.sh"

show_overview() {
  cat <<'EOF'
🧰 MYTOOLS — YOUR TERMINAL MEDIA SWISS ARMY KNIFE 🛠️

⚡ QUICK ACCESS COMMANDS
  mytools                Open interactive fzf launcher (with live ffprobe preview) 🎯
  mytools guide          Interactive guide browser, recipe copier & wizard launcher 📖
  mytools cs [topic]     Print short code sheets (all | video | audio | image | recipes) 📋
  mytools help <tool>    Show detailed flag reference & examples for any tool 🔍
  <tool> -i              Launch step-by-step interactive wizard for a tool 🧙

📸 IMAGE TOOLS 🪄
  img2webp          Convert JPEG, PNG, GIF, HEIC to WebP (shrink size, keep quality) ⚡

📥 WEB DOWNLOADS 🌐
  ytdl              Grab video/audio from web URLs via yt-dlp (auto-reads clipboard) 🌐

🎞️ VIDEO TOOLS 🎬
  vidglue           Glue, crossfade & collage MP4 files (copy, --fit blur, xfade, --bounce, --layout)
  vid2webm          Convert video to modern VP9/Opus WebM 🌐
  vid2gif           Convert video clips to palette-optimized animated GIFs 👾
  videoWithoutAudio Create a muted video (optionally preserve audio tracks as .mka) 🔇
  vidoptim          Re-encode videos for web, social, or archive presets 🚀
  vidglitch         Apply 11 glitch, CRT, VHS, datamosh, nightvision & audio glitch FX ⚡
  vidcuts           Cut film, BPM beat cuts, freeze-cuts & auto-silence jump-cuts ✂️
  videoeffects      Cinematic color grading, speed/slow-mo, optics, mirror & framing FX (alias: vidfx) 🎬
  videorandfram     Randomize frame order, temporal stutter & micro-jitter (alias: vidrandfram) 🎲

🎵 AUDIO & WAV/MP3 TOOLS 🎧  (All wav* tools support -m/--mp3 & -b <kbps>!)
  vid2audio         Extract crisp audio streams from video (WAV / MP3) 🔊
  wav2mp3           Convert heavy WAV audio to lightweight MP3 🎶
  wav2tempo         Retime WAV tempo to a target BPM using aubio (WAV / MP3) 🥁
  wavreverse        Reverse WAV audio sample-accurately (WAV / MP3) 🔄
  wavpitch          Shift WAV pitch by semitones or tape varispeed (WAV / MP3) 🎼
  wavnorm           Normalize WAV volume (-14 LUFS or Peak dBFS, WAV / MP3) 🎚️
  wavfade           Apply smooth fade-in and fade-out volume envelopes (WAV / MP3) 📈
  wavtrim           Strip leading and trailing silence from WAV audio (WAV / MP3) ✂️
  wavfx             Apply DSP audio effects: reverb, delay, low/high-pass EQ (WAV / MP3) 🎛️

🕵️ MEDIA INSPECTION & FINDER BOOKMARKS 🔍
  media-info        Inspect video/audio codecs, duration, bitrate, resolution 🔍
  thumloc           Generate Finder thumbnail previews for .webloc files 🖼️
  webloc2md         Create a structured Markdown index of bookmark URLs 📝

⚙️ HEALTH & CONFIGURATION 🩺
  doctor            Check & auto-install missing dependencies (mytools doctor --install) 🩺
  config            Show/edit user configuration presets (~/.config/mytools/config) 🛠️

🔑 UNIVERSAL FLAGS CHEAT-SHEET
  -i, --interactive Launch guided step-by-step wizard (prints Equivalent Command + copies to clipboard)
  -n, --dry-run     Preview planned output filenames & settings safely without modifying disk
  -f, --force       Overwrite existing output files (all tools are non-destructive by default)
  -o, --output-dir  Write output files into a dedicated directory (e.g. -o ./out)
  -m, --mp3         Output directly as MP3 instead of WAV (supported on all wav* tools + -b <kbps>)

🧭 3-STEP QUICK START
  1. cd ~/Pictures/MyMedia          # Go to your media folder (Tip: type 'cd ' + drag folder from Finder)
  2. img2webp --width 1200 -q 90 -a # Run any tool directly by name (no 'mytools' prefix needed!)
  3. videoeffects -i                # Or use '-i' wizard mode to build commands interactively
EOF
}

show_cheatsheet() {
  local section="${1:-all}"
  case "$section" in
    video|cheatsheet-video)
      cat <<'EOF'
🎬 SHORT CODE SHEET — VIDEO EDITING, FX & TRANSCODING
═══════════════════════════════════════════════════════════════════════════════
TOOL / ALIAS         ONE-LINER COMMAND                                  WHAT IT DOES
───────────────────────────────────────────────────────────────────────────────
vidglue              vidglue part1.mp4 part2.mp4                        Lossless instant merge (-c copy)
vidglue              vidglue -t fade --transition-duration 0.8 a.mp4 b.mp4  Smooth 0.8s crossfade merge
vidglue              vidglue --reencode --fit blur horiz.mp4 vert.mp4   Join mixed aspect ratios w/ blur pad
vidglue              vidglue --bounce -l 3 clip.mp4                     Boomerang forward+reverse loop (3x)
vidglue              vidglue --layout hstack left.mp4 right.mp4         Side-by-side split-screen (or 2x2)
videoeffects (vidfx) vidfx -p cinema --letterbox 2.35 clip.mp4          Teal & orange + 2.35:1 CinemaScope
videoeffects (vidfx) vidfx --speed 0.5 --smooth-slowmo action.mp4       Silky 2x optical-flow slow motion
videoeffects (vidfx) vidfx --mirror quad -p synthwave dance.mp4         4-way neon kaleidoscope mirror
videoeffects (vidfx) vidfx --reverse --bloom --trails 6 clip.mp4        Reversed dreamy phosphor trails
vidglitch            vidglitch -p vhs -A --osd clip.mp4                 VHS tape + audio flutter + REC HUD
vidglitch            vidglitch -p cyberpunk --organic-burst clip.mp4    Erratic neon glitch bursts
vidglitch            vidglitch -p datamosh -I high dance.mp4            Heavy motion pixel smear trails
vidcuts              vidcuts --mode silence interview.mp4               Auto-cut silent pauses (vlog editor)
vidcuts              vidcuts --mode beat --bpm 128 --flash dance.mp4    Cut rhythmically on 128 BPM beats
vidcuts              vidcuts -p 35 --mode freeze --film-burn clip.mp4   Freeze-cuts (keeps original audio!)
videorandfram        vidrandfram -p jitter --rgb-split 8 clip.mp4       4-frame shutter tremor + RGB split
videorandfram        vidrandfram -p stutter --fps 12 dance.mp4          12fps stop-motion breakbeat skip
videorandfram        vidrandfram -p vortex --trails 5 promo.mp4         120-frame surreal time-warp loop
vidoptim             vidoptim -p social *.mov                           Optimize for social (H.264, 720p)
vid2webm             vid2webm -q 24 -w 1280 --from 00:05 --to 00:20 a.mp4  Trim & encode 720p VP9 WebM
vid2gif              vid2gif -w 540 -r 15 --from 2 --to 7 demo.mov      2-pass palette-optimized 15fps GIF
videoWithoutAudio    videoWithoutAudio --extract-audio clip.mp4         Mute video & save audio as .mka
EOF
      ;;
    audio|cheatsheet-audio)
      cat <<'EOF'
🎧 SHORT CODE SHEET — AUDIO, WAV DSP & MP3 WORKFLOWS
═══════════════════════════════════════════════════════════════════════════════
💡 Every wav* tool outputs WAV by default, or MP3 with '-m' / '--mp3' and '-b <kbps>'!

TOOL                 ONE-LINER COMMAND                                  WHAT IT DOES
───────────────────────────────────────────────────────────────────────────────
vid2audio            vid2audio -f mp3 -b 256 video.mp4                  Extract 256kbps MP3 from video
vid2audio            vid2audio video.mov                                Extract lossless 16-bit PCM WAV
wav2mp3              wav2mp3 -b 320 *.wav                               Batch convert WAVs to 320kbps MP3
wavnorm              wavnorm podcast.wav                                Normalize loudness to -14 LUFS
wavnorm              wavnorm -m -l -16 interview.wav                    Normalize to -16 LUFS & save MP3
wavnorm              wavnorm --peak -1 master.wav                       Sample-peak normalize to -1 dBFS
wavtrim              wavtrim recording.wav                              Strip start & end silence (<-50dB)
wavtrim              wavtrim -m -t -40 --start-only kick.wav            Trim leading silence & output MP3
wavfade              wavfade -i 0.1 -o 0.2 sample.wav                   De-click sample edges (100ms/200ms)
wavfade              wavfade -m -i 0.5 -o 1.5 -c qsin pad.wav           Smooth quarter-sine fade to MP3
wavpitch             wavpitch -s +2 vocal.wav                           Shift up 2 semitones (keeps tempo)
wavpitch             wavpitch -m --varispeed -s -4 loop.wav             Slow tape-drop pitch+speed to MP3
wav2tempo            wav2tempo -t 128 drumloop.wav                      Auto-detect BPM & retime to 128 BPM
wav2tempo            wav2tempo -m --bpm 95 -t 120 loop.wav              Retime 95->120 BPM & save as MP3
wavreverse           wavreverse riser.wav                               Sample-accurate backwards WAV
wavreverse           wavreverse -m -b 256 cymbal.wav                    Reverse audio directly to MP3
wavfx                wavfx --reverb hall vocal.wav                      Spacious concert hall reverb
wavfx                wavfx -m --lowpass 800 --delay 250 loop.wav        Lo-fi 800Hz filter + echo to MP3
EOF
      ;;
    image|web|cheatsheet-image)
      cat <<'EOF'
📸 SHORT CODE SHEET — IMAGE, WEB DOWNLOADS, INSPECT & FINDER
═══════════════════════════════════════════════════════════════════════════════
TOOL                 ONE-LINER COMMAND                                  WHAT IT DOES
───────────────────────────────────────────────────────────────────────────────
img2webp             img2webp -a                                        Convert all images in current folder
img2webp             img2webp --width 1200 -q 90 -a                     Resize to max 1200px & 90% quality
img2webp             img2webp -l diagram.png                            Lossless pixel-perfect WebP
img2webp             img2webp -R -j 4 -o ./webp ~/Pictures              Recursive 4-thread batch conversion
img2webp             img2webp -i                                        Interactive guided WebP wizard
ytdl                 ytdl                                               Download URL from macOS clipboard
ytdl                 ytdl -f mp3 'https://youtu.be/...'                 Download audio directly as MP3
ytdl                 ytdl -f mp4 --subtitles 'https://...'              Download MP4 with embedded subs
media-info           media-info *.mp4 *.wav                             Inspect codecs, bitrate, duration
thumloc              thumloc ~/Downloads/Bookmarks                      Render Finder icons for .webloc
webloc2md            webloc2md ~/Downloads/Bookmarks links.md           Export .webloc folder to Markdown
mytools doctor       mytools doctor --install                           Check & install missing brew deps
mytools config       mytools config --init                              Create ~/.config/mytools/config
EOF
      ;;
    recipes|pipelines)
      cat <<'EOF'
🧪 SHORT CODE SHEET — POWER RECIPES & MULTI-STEP PIPELINES
═══════════════════════════════════════════════════════════════════════════════
1. 🎙️ Podcast / Voiceover Polish Pipeline (Trim Silence → Normalize -16 LUFS → MP3)
   wavtrim -t -45 raw-voice.wav && wavnorm -m -b 192 -l -16 raw-voice-trimmed.wav

2. 🎬 Hollywood Trailer Look (Cinema Grade + 2.35:1 Bars + Smooth Fade In/Out)
   vidfx -p cinema --letterbox 2.35 --fade-in 0.8 --fade-out 1.2 raw-cut.mp4

3. 📼 Authentic 90s Camcorder Found-Footage (VHS Glitch + Audio Flutter + Super-8 Cuts)
   vidglitch -p vhs -A --osd --tracking clip.mp4 && vidcuts -p 15 --super8 --scratches clip-glitched.mp4

4. 📱 Social Vertical Collage from Mixed Clips (Blurred Backdrop + Crossfade)
   vidglue --reencode --fit blur --resolution vertical -t fade clip1.mp4 clip2.mp4

5. 🌐 Full Website Media Diet (Batch 1200px WebP Images + 720p VP9 WebM Videos)
   img2webp --width 1200 -q 85 -a -o ./web-assets && vid2webm -q 28 -w 1280 -o ./web-assets *.mp4

6. 🥁 Sample Pack Prep (De-click Fade + Normalize Peak 0dB + Retime to 128 BPM)
   wavfade -i 0.05 -o 0.1 loop.wav && wavnorm --peak 0 loop-faded.wav && wav2tempo -t 128 loop-faded-norm-0dB-peak.wav
EOF
      ;;
    *)
      show_cheatsheet video
      echo ""
      show_cheatsheet audio
      echo ""
      show_cheatsheet image
      echo ""
      show_cheatsheet recipes
      ;;
  esac
}

get_tool_recipes() {
  local tool="$1"
  case "$tool" in
    img2webp|img2web)
      cat <<'EOF'
img2webp -a	Convert all images in current folder (default q85)
img2webp --width 1200 -q 90 -a	Resize all images in folder to 1200px wide at 90% quality
img2webp -l artwork.png	Lossless WebP conversion for graphics/screenshots
img2webp -R -j 4 -o ./webp .	Recursive 4-core parallel conversion into ./webp
img2webp --width 1200 -q 85 -a -n	Dry-run preview without creating files
img2webp -i	Launch interactive step-by-step wizard
EOF
      ;;
    vidglue|videoglue)
      cat <<'EOF'
vidglue clip1.mp4 clip2.mp4	Fast lossless stream-copy merge
vidglue -t fade --transition-duration 0.8 a.mp4 b.mp4	Smooth 0.8s crossfade transition between clips
vidglue --reencode --fit blur horiz.mp4 vert.mp4	Join mixed aspect ratios with blurred background fill
vidglue --bounce -l 3 clip.mp4	Boomerang forward + reverse loop repeated 3 times
vidglue --layout hstack left.mp4 right.mp4	Side-by-side split-screen collage
vidglue --layout 2x2 a.mp4 b.mp4 c.mp4 d.mp4	2x2 quad video wall grid
vidglue -i	Launch interactive vidglue wizard
EOF
      ;;
    vidglitch|videoglitch)
      cat <<'EOF'
vidglitch --preset vhs --audio-glitch --osd clip.mp4	VHS tape look + audio wow/flutter + camcorder REC HUD
vidglitch --preset cyberpunk --organic-burst clip.mp4	Cyberpunk neon split with erratic hardware bursts
vidglitch --preset datamosh -I high dance.mp4	High-intensity motion pixel smear & ghosting
vidglitch --preset crt --scanlines clip.mp4	Retro arcade CRT monitor scanlines
vidglitch --preset nightvision --osd clip.mp4	Tactical green phosphor nightvision + HUD
vidglitch -i	Launch interactive vidglitch wizard
EOF
      ;;
    vidcuts|videocuts)
      cat <<'EOF'
vidcuts --mode silence interview.mp4	Auto-remove silent pauses from talking-head video
vidcuts --mode beat --bpm 128 --flash dance.mp4	Cut rhythmically on 128 BPM beats with white flashes
vidcuts -p 35 --mode freeze --film-burn musicvideo.mp4	Freeze-cuts keeping original duration & song intact
vidcuts -p 25 --mode jumps clip.mp4	Excise 25% of video as kinetic ~0.2s jump cuts
vidcuts -p 20 --jitter --grain --scratches --super8 clip.mp4	Damaged 16mm/Super-8 archival film projector look
vidcuts -i	Launch interactive vidcuts wizard
EOF
      ;;
    videoeffects|vidfx)
      cat <<'EOF'
videoeffects --preset cinema --letterbox 2.35 clip.mp4	Blockbuster teal & orange grade + 2.35:1 CinemaScope bars
videoeffects --speed 0.5 --smooth-slowmo action.mp4	Silky 2x slow-motion using optical flow interpolation
videoeffects --mirror quad --preset synthwave dance.mp4	4-way neon synthwave kaleidoscope mirror
videoeffects --reverse --bloom --trails 6 dream.mov	Reversed playback with highlight glow & phosphor trails
videoeffects --preset noir --vignette --grain scene.mp4	Classic high-contrast B&W film noir look
videoeffects -i	Launch interactive videoeffects wizard
EOF
      ;;
    videorandfram|vidrandfram)
      cat <<'EOF'
videorandfram -p jitter --rgb-split 8 clip.mp4	Micro-window shutter tremor + chromatic aberration
videorandfram -p stutter --fps 12 dance.mp4	12fps stop-motion breakbeat frame skip
videorandfram -p vortex --trails 5 promo.mp4	Surreal 120-frame time-warp loop with ghost trails
videorandfram -p burst --audio stutter action.mp4	Intermittent scramble bursts with stuttered audio
videorandfram -i	Launch interactive videorandfram wizard
EOF
      ;;
    vidoptim)
      cat <<'EOF'
vidoptim video.mov	Optimize for web (H.264, CRF 23, max 1080p)
vidoptim --preset social -o ./social *.mov	Batch optimize for social media (H.264, CRF 25, max 720p)
vidoptim --preset archive master.mp4	Archival HEVC H.265 compression at native resolution
EOF
      ;;
    vid2webm)
      cat <<'EOF'
vid2webm clip.mov	Convert video to VP9/Opus WebM (default CRF 30)
vid2webm -q 24 -w 1280 clip.mp4	High-quality 720p WebM encoding
vid2webm --from 00:00:05 --to 00:00:20 recording.mp4	Trim 15s clip and encode to WebM
EOF
      ;;
    vid2gif)
      cat <<'EOF'
vid2gif demo.mov	Convert video to 480px 12fps palette-optimized GIF
vid2gif -w 600 -r 15 --from 2 --to 7 demo.mp4	Smooth 600px 15fps GIF from 2s to 7s
EOF
      ;;
    videoWithoutAudio)
      cat <<'EOF'
videoWithoutAudio clip.mp4	Create muted video copy (stream copy, zero quality loss)
videoWithoutAudio --extract-audio recording.mov	Mute video and save original audio streams as .mka
EOF
      ;;
    vid2audio)
      cat <<'EOF'
vid2audio video.mp4	Extract uncompressed 16-bit PCM WAV from video
vid2audio -f mp3 -b 256 video.mp4	Extract high-quality 256kbps MP3 from video
vid2audio -f mp3 -o ./audio *.mp4	Batch extract MP3 audio from all MP4s into ./audio
EOF
      ;;
    wav2mp3)
      cat <<'EOF'
wav2mp3 track.wav	Convert WAV to 192kbps MP3
wav2mp3 -b 320 *.wav	Batch convert all WAVs in folder to 320kbps MP3
wav2mp3 -b 256 -o ./mp3 *.wav	Convert all WAVs into ./mp3 folder at 256kbps
EOF
      ;;
    wav2tempo)
      cat <<'EOF'
wav2tempo -t 128 loop.wav	Auto-detect BPM and retime WAV to 128 BPM
wav2tempo -m -t 128 loop.wav	Retime WAV to 128 BPM and save directly as MP3
wav2tempo --bpm 92 -t 120 -m -b 256 song.wav	Retime known 92 BPM WAV to 120 BPM as 256kbps MP3
EOF
      ;;
    wavreverse)
      cat <<'EOF'
wavreverse riser.wav	Create sample-accurate reversed WAV (riser-reversed.wav)
wavreverse -m riser.wav	Reverse WAV and output directly as MP3 (riser-reversed.mp3)
wavreverse -m -b 320 -o ./reversed *.wav	Batch reverse all WAVs into ./reversed as 320kbps MP3s
EOF
      ;;
    wavpitch)
      cat <<'EOF'
wavpitch -s +2 vocal.wav	Shift pitch up 2 semitones while preserving tempo
wavpitch -m -s -3 vocal.wav	Shift pitch down 3 semitones and output as MP3
wavpitch --varispeed -s -4 track.wav	Analog tape slowdown effect (links pitch & playback speed)
wavpitch -m -b 256 --varispeed -s -5 loop.wav	Tape slowdown effect exported directly as 256kbps MP3
EOF
      ;;
    wavnorm)
      cat <<'EOF'
wavnorm podcast.wav	Normalize loudness to broadcast standard -14 LUFS
wavnorm -m -l -16 interview.wav	Normalize to -16 LUFS (podcast standard) & output MP3
wavnorm --peak 0 master.wav	Peak-normalize sample ceiling to 0 dBFS
wavnorm -m -b 320 --peak -1 *.wav	Batch peak-normalize to -1 dBFS and save as 320kbps MP3
EOF
      ;;
    wavfade)
      cat <<'EOF'
wavfade -i 0.1 -o 0.2 sample.wav	Fast 100ms fade-in & 200ms fade-out to eliminate clicks
wavfade -m -i 0.5 -o 1.5 -c qsin pad.wav	Smooth quarter-sine fade envelope exported as MP3
wavfade -i 1.5 -o 2.0 -c esin -d ./faded *.wav	Cinematic swell fade on all WAVs into ./faded
EOF
      ;;
    wavtrim)
      cat <<'EOF'
wavtrim recording.wav	Strip leading & trailing silence below -50dB
wavtrim -m -t -40 vocal.wav	Trim silence below -40dB and save directly as MP3
wavtrim --start-only kick.wav	Strip leading silence only for tight transient start
EOF
      ;;
    wavfx)
      cat <<'EOF'
wavfx --reverb room loop.wav	Apply warm studio room reverb
wavfx -m --reverb hall vocal.wav	Apply spacious concert hall reverb and output as MP3
wavfx --delay 250 guitar.wav	Add 250ms slapback echo delay
wavfx -m --lowpass 800 --reverb space pad.wav	Underwater lo-fi filter + cosmic reverb exported to MP3
EOF
      ;;
    ytdl)
      cat <<'EOF'
ytdl	Download video URL currently in macOS clipboard
ytdl -f mp3	Extract audio as MP3 from clipboard URL
ytdl -f mp4 --subtitles 'https://...'	Download MP4 video with embedded subtitles
EOF
      ;;
    media-info)
      cat <<'EOF'
media-info clip.mp4	Inspect codec, resolution, frame rate, bitrate & duration
media-info *.mp4 *.wav *.mp3	Batch inspect all media files in current directory
EOF
      ;;
    *)
      cat <<'EOF'
img2webp --width 1200 -q 90 -a	Resize & convert all images in folder to WebP
vidglue -t fade a.mp4 b.mp4	Crossfade two videos seamlessly
videoeffects --preset cinema --letterbox 2.35 clip.mp4	Cinema grade + 2.35:1 widescreen bars
vidglitch --preset vhs --audio-glitch --osd clip.mp4	VHS glitch + tape flutter + camcorder HUD
vidcuts --mode silence interview.mp4	Auto-strip silent pauses from video
wavnorm -m -l -16 podcast.wav	Normalize WAV to -16 LUFS and output MP3
wavtrim -m -t -45 recording.wav	Trim silence from WAV and output MP3
EOF
      ;;
  esac
}

show_tool_help() {
  local tool="$1"
  case "$tool" in
    cheatsheet|cs|sheets)
      show_cheatsheet "${2:-all}"
      ;;
    cheatsheet-video|video-sheet)
      show_cheatsheet video
      ;;
    cheatsheet-audio|audio-sheet)
      show_cheatsheet audio
      ;;
    cheatsheet-image|image-sheet)
      show_cheatsheet image
      ;;
    recipes|pipelines)
      show_cheatsheet recipes
      ;;
    vidglue|videoglue|mp4glue)
      cat <<'EOF'
🎞️ vidglue — Glue, Crossfade & Collage MP4 Video Files 🧲

Usage:
  vidglue [options] <video1> <video2...>
  vidglue --bounce [options] <video>

Description:
  Fuses multiple video files into a single seamless MP4 output file! 🎬
  Uses lightning-fast stream copy (-c copy) by default, or auto-normalizes mixed
  resolutions/aspect ratios (--fit pad|crop|blur) and missing audio tracks.
  Supports smooth xfade transitions (-t), spatial split-screen collages (--layout),
  and instant Boomerang forward-and-rewind loops (--bounce / --loop)! 🪃

Options:
  -i, --interactive            Interactive guided wizard 🧙
  -o, --output <file>          Output MP4 file path (default: <first-video>-glued.mp4) 💾
  -b, --bounce                 Play 1st video forward and 2nd reversed (or forward + reversed for 1 video) 🪃
  -r, --reencode               Force stream re-encoding & smart resolution/audio normalization ⚙️
  --fit <pad|crop|blur>        How to fit mixed aspect ratios (pad, crop, or blurred background) 🖼️
  --resolution <res>           Target resolution (auto, 1080p, 720p, vertical, square, or WxH) 📐
  -t, --transition <type>      Crossfade transition (fade, fadeblack, fadewhite, dissolve, wipeleft, pixelize, radial...) ✨
  --transition-duration <sec>  Transition duration in seconds (default: 0.5) ⏱️
  --layout, --grid <mode>      Spatial collage layout: hstack (side-by-side), vstack (top/bottom), 2x2 (quad) ◫
  -l, --loop <N>               Repeat the glued sequence N times 🔁
  --mute                       Discard audio from the output video 🔇
  -f, --force                  Overwrite existing output file ⚡
  -n, --dry-run                Preview planned output without running FFmpeg 📝

Short Code Sheet:
  vidglue -i                                         # launch interactive wizard
  vidglue clip1.mp4 clip2.mp4                        # fast stream copy
  vidglue --bounce -l 3 clip.mp4                     # 🪃 bounce loop repeated 3x
  vidglue --reencode --fit blur horiz.mp4 vert.mp4   # mix horizontal & vertical with blurred background
  vidglue -t fade --transition-duration 0.8 a.mp4 b.mp4
  vidglue --layout hstack left.mp4 right.mp4         # side-by-side split screen
EOF
      ;;
    img2webp|img2web)
      cat <<'EOF'
📸 img2webp — Image to WebP Converter 🪄

Usage:
  img2webp [options] [image... or directory]

Description:
  Converts JPEG, PNG, GIF, TIFF, HEIC to lightweight, ultra-optimized WebP images! ⚡
  ⚠️ Note: Run 'img2webp' directly (no 'mytools' prefix needed, and note the 'p' at the end — not 'img2web').

Options:
  -i, --interactive      Interactive wizard (prompts for settings & files) 🧙
  -a, --all              Process all images in current directory 📂
  -q, --quality <0-100>  Quality factor (default: 85) 🎯
  -w, --width <px>       Downscale image to maximum width 📐
  -H, --height <px>      Downscale image to maximum height 📐
  -r, --resize <WxH>     Exact resize dimensions 📐
  -l, --lossless         Lossless encoding 💎
  -R, --recursive        Search directories recursively 📁
  -j, --jobs <N>         Number of parallel conversion jobs 🚀
  -o, --output-dir <d>   Write output files to directory 📂
  -f, --force            Overwrite existing output ⚡
  -d, --delete-original  Delete original after conversion 🗑️
