Description:
  Applies spatial reverb presets, slapback/echo delays, and low-pass / high-pass EQ filters!
  Combine multiple DSP flags in a single pass and export to WAV or MP3.

Options:
  --reverb <preset>       Spatial reverb: room, hall, or space (default: room) 🏛️
  --delay <ms>            Echo delay time in milliseconds (e.g. 250) 🔁
  --lowpass <Hz>          Low-pass filter cutoff frequency in Hz (e.g. 800 for warm lo-fi) 📻
  --highpass <Hz>         High-pass filter cutoff frequency in Hz (e.g. 120 to cut rumble) 🎙️
  -m, --mp3               Output as MP3 instead of WAV 🎧
  --format <wav|mp3>      Explicit output format (default: wav) 🎵
  -b, --bitrate <kbps>    MP3 bitrate in kbps (default: 192; implies MP3 output) 🎚️
  -o, --output-dir <dir>  Write output files to this directory 📂
  -f, --force             Overwrite existing output files ⚡
  -n, --dry-run           Show planned output files only 📝

Short Code Sheet:
  wavfx --reverb room loop.wav                  # warm studio room reverb (.wav)
  wavfx -m --reverb hall vocal.wav              # spacious hall reverb saved as .mp3
  wavfx --delay 250 guitar.wav                  # 250ms echo delay
  wavfx -m --lowpass 800 --reverb space pad.wav # lo-fi filter + cosmic reverb to MP3
EOF
      ;;
    media-info)
      cat <<'EOF'
🕵️ media-info — Inspect Media File Metadata 🔍

Usage:
  media-info <file...>

Description:
  Inspects video/audio codecs, resolution, frame rate, duration, bitrate, and size via ffprobe! 📊

Short Code Sheet:
  media-info recording.mov song.mp3
  media-info *.mp4 *.wav
EOF
      ;;
    ytdl)
      cat <<'EOF'
📥 ytdl — Web Media Grabber (yt-dlp + Clipboard) 🌐

Usage:
  ytdl [options] [URL]

Description:
  Downloads video or audio from web links using yt-dlp.
  If URL is omitted, automatically checks your macOS clipboard (pbpaste)! 📋

Options:
  -f, --format <mp4|webm|mp3|wav>  Select output format without prompt 🎬
  -o, --output-dir <dir>           Destination folder (default: ~/Downloads) 📂
  --playlist                       Download entire playlist 📚
  --subtitles                      Embed subtitles into video 💬
  -n, --dry-run                    Simulate download only 📝

Short Code Sheet:
  ytdl                                          # grab URL from clipboard & pick format
  ytdl -f mp3 'https://youtu.be/...'            # download audio directly as MP3
  ytdl -f mp4 --subtitles 'https://...'         # download MP4 with embedded subtitles
EOF
      ;;
    thumloc|webloc2md)
      cat <<'EOF'
📂 Finder & Bookmarks Tools (thumloc & webloc2md) 📑

Usage:
  thumloc [--force] [--dry-run] <directory>
  webloc2md [--force] [--dry-run] <directory> [output.md]

Description:
  🖼️ thumloc    Fetches website previews and sets custom Finder icons on .webloc files
  📝 webloc2md  Scans a folder of .webloc files and builds a clean Markdown index

Short Code Sheet:
  thumloc ~/Downloads/Bookmarks
  thumloc --force ~/Downloads/Bookmarks
  webloc2md ~/Downloads/Bookmarks bookmarks.md
EOF
      ;;
    doctor|config)
      case "$tool" in
        doctor)
          cat <<'EOF'
🩺 doctor — Dependency Check & Auto-Install 🛠️

Usage:
  mytools doctor [--install]

Description:
  Checks required Homebrew packages (ffmpeg, webp, aubio, yt-dlp, fzf, setweblocthumb).
  Pass --install to automatically install any missing packages via Homebrew! 💊

Short Code Sheet:
  mytools doctor
  mytools doctor --install
EOF
          ;;
        config)
          cat <<'EOF'
⚙️ config — Presets Configuration Lab 🛠️

Usage:
  mytools config [--init|--path|--list]

Description:
  Manages your user configuration file (~/.config/mytools/config) for vidoptim presets. 📝

Short Code Sheet:
  mytools config --init
  mytools config --list
  mytools config --path
EOF
          ;;
      esac
      ;;
    custom-commands|how-to-apply|launcher-tips)
      cat <<'EOF'
🧭 Step-by-Step: Custom Commands, Short Code Recipes & Launcher Tips 🎯

⚠️ Two Golden Rules When Running Commands:
  1. No 'mytools' prefix needed for individual tools!
     • Each tool ('img2webp', 'vidglue', 'vidfx', 'wavnorm', etc.) runs directly by its own name.
     • ('mytools <tool> [options]' also forwards automatically if you type it by habit.)
  2. Watch the exact tool name:
     • The image converter ends with a 'p': 'img2webp' (not 'img2web').

⚡ 3 Ways to Use Any Tool:
  1. Direct One-Liner (Fastest once you know flags):
     cd ~/Pictures/MyPhotos && img2webp --width 1200 -q 90 -a
  2. Guided Wizard Mode (-i) (Builds the command for you & copies to clipboard):
     img2webp -i  |  vidglue -i  |  vidglitch -i  |  vidcuts -i  |  videoeffects -i  |  videorandfram -i
  3. Interactive Launcher & Recipe Copier:
     mytools          # pick tool -> mark multiple files with [Tab] -> press [Enter]
     mytools guide    # browse docs, pick any one-liner recipe & copy to clipboard!
     mytools cs       # print instant short code sheets in terminal (video, audio, image, recipes)
EOF
      ;;
    *)
      if [ -f "$SCRIPT_DIR/$tool" ]; then
        bash "$SCRIPT_DIR/$tool" --help
      else
        echo "❓ Unknown tool or topic: $tool" >&2
        echo "💡 Run 'mytools help' or 'mytools cs' for available commands and code sheets." >&2
        exit 1
      fi
      ;;
  esac
}

copy_recipe_menu() {
  local tool="$1"
  local recipes
  recipes="$(get_tool_recipes "$tool")"
  [ -n "$recipes" ] || return 0

  local picked
  picked=$(printf '%s\n' "$recipes" | awk -F'\t' '{ printf "%-52s  # %s\n", $1, $2 }' | fzf \
    --no-mouse \
    --prompt="copy $tool recipe > " \
    --header="📋 Press [Enter] to copy command to clipboard (pbcopy) • Mouse drag selects text • [Esc] cancel" \
    --height=50% \
    --layout=reverse \
    --border=horizontal || true)

  [ -n "$picked" ] || return 0
  local cmd="${picked%%  # *}"
  cmd="$(printf '%s' "$cmd" | sed 's/[[:space:]]*$//')"
  if command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$cmd" | pbcopy
    echo "✅ Copied to clipboard: $cmd"
  else
    echo "📋 Command: $cmd"
  fi
}

copy_full_guide() {
  local tool="$1"
  if command -v pbcopy >/dev/null 2>&1; then
    show_tool_help "$tool" | pbcopy
    echo "✅ Full '$tool' explanation & Short Code Sheet copied to clipboard (pbcopy)!"
  else
    show_tool_help "$tool"
  fi
}

interactive_guide() {
  command -v fzf >/dev/null 2>&1 || {
    show_overview
    exit 0
  }

  local topics
  topics=$(printf '%s\n' \
    'cheatsheet — ⚡ Complete Short Code Sheet (All tools & one-liners)' \
    'cheatsheet-video — 🎬 Video FX, Cuts, Glitch & Merging Code Sheet' \
    'cheatsheet-audio — 🎧 Audio WAV/MP3 DSP & Mastering Code Sheet' \
    'cheatsheet-image — 📸 Image WebP, Web Downloads & Finder Code Sheet' \
    'recipes — 🧪 Multi-Step Production Pipelines & Power Recipes' \
    'custom-commands — 🧭 Step-by-step: How to apply tools & golden rules' \
    'img2webp — 📸 Convert images to WebP (wizard: img2webp -i)' \
    'vidglue — 🎞️ Glue, crossfade & collage MP4 videos (wizard: vidglue -i)' \
    'videoeffects — 🎬 Cinematic color grading, speed & optical FX (wizard: videoeffects -i)' \
    'vidglitch — ⚡ Glitch, CRT, VHS, datamosh & retro FX (wizard: vidglitch -i)' \
    'vidcuts — ✂️ Cut film, BPM beat cuts & silence remover (wizard: vidcuts -i)' \
    'videorandfram — 🎲 Randomize frame order & temporal glitch (wizard: videorandfram -i)' \
    'vidoptim — 🚀 Web/social/archive video optimization' \
    'vid2webm — 🌐 Convert videos to VP9/Opus WebM' \
    'vid2gif — 👾 Create palette-optimized animated GIFs' \
    'videoWithoutAudio — 🔇 Remove audio (optionally preserve tracks)' \
    'vid2audio — 🔊 Extract WAV or MP3 audio from video' \
    'wav2mp3 — 🎧 Convert WAV audio to MP3' \
    'wav2tempo — 🥁 Retime WAV by BPM (outputs WAV or MP3)' \
    'wavreverse — 🔄 Reverse WAV audio (outputs WAV or MP3)' \
    'wavpitch — 🎼 Shift WAV pitch / varispeed (outputs WAV or MP3)' \
    'wavnorm — 🎚️ Normalize WAV loudness or peak (outputs WAV or MP3)' \
    'wavfade — 📈 Apply fade-in & fade-out envelopes (outputs WAV or MP3)' \
    'wavtrim — ✂️ Strip leading & trailing silence (outputs WAV or MP3)' \
    'wavfx — 🎛️ Apply reverb, delay & EQ filters (outputs WAV or MP3)' \
    'ytdl — 📥 Download web media (yt-dlp + clipboard)' \
    'media-info — 🕵️ Inspect media codec & details' \
    'thumloc — 🖼️ Finder bookmark thumbnails' \
    'webloc2md — 📑 Bookmark Markdown index' \
    'doctor — 🩺 Dependency check & auto-installer' \
    'config — ⚙️ User settings & presets' \
  )

  while true; do
    local choice
    choice=$(echo "$topics" | fzf \
      --no-mouse \
      --prompt='mytools guide > ' \
      --header='📖 Drag mouse to select & copy text (⌘C) • [Enter] actions & recipe copier • [Ctrl-Y] copy full guide • [?] toggle layout • [Esc] exit' \
      --height=92% \
      --layout=reverse \
      --border=horizontal \
      --bind="?:change-preview-window(right:60%:wrap:border-left|down:65%:wrap:border-top)" \
      --bind="ctrl-y:execute-silent(bash \"$SOURCE_PATH\" preview {1} | pbcopy)" \
      --preview="bash \"$SOURCE_PATH\" preview {1}" \
      --preview-window=down:65%:wrap:border-top || true)

    [ -n "$choice" ] || exit 0
    local tool="${choice%% *}"
    show_tool_help "$tool"
    echo ""
    echo "💡 Tip: You can highlight any explanation or command above with your mouse to copy (⌘C)."

    if [ -t 0 ]; then
      case "$tool" in
        img2webp|vidglue|vidglitch|vidcuts|videoeffects|videorandfram|vidrandfram)
          local next_act
          next_act=$(printf '%s\n' \
            "copy — 📋 Pick & copy a ready-made '$tool' one-liner to clipboard (pbcopy)" \
            "copy-guide — 📄 Copy entire '$tool' explanation & code sheet to clipboard" \
            "wizard — 🧙 Launch '$tool -i' interactive wizard right now" \
            "print — 🖨️ Keep explanation on screen & exit to shell prompt" \
            "back — 🔙 Back to guide browser" | fzf --no-mouse --prompt="$tool > " --height=35% --layout=reverse --border=horizontal || true)
          case "${next_act%% *}" in
            wizard) exec "$SCRIPT_DIR/$tool" -i ;;
            copy) copy_recipe_menu "$tool" ;;
            copy-guide) copy_full_guide "$tool" ;;
            back) continue ;;
            *) exit 0 ;;
          esac
          ;;
        doctor|config)
          local next_act
          next_act=$(printf '%s\n' \
            "run — 🚀 Run 'mytools $tool' now" \
            "copy-guide — 📄 Copy entire '$tool' explanation to clipboard" \
            "print — 🖨️ Keep explanation on screen & exit to shell prompt" \
            "back — 🔙 Back to guide browser" | fzf --no-mouse --prompt="$tool > " --height=30% --layout=reverse --border=horizontal || true)
          case "${next_act%% *}" in
            run) exec "$SCRIPT_DIR/mytools-$tool" ;;
            copy-guide) copy_full_guide "$tool" ;;
            back) continue ;;
            *) exit 0 ;;
          esac
          ;;
        *)
          local next_act
          next_act=$(printf '%s\n' \
            "copy — 📋 Pick & copy a ready-made command recipe to clipboard (pbcopy)" \
            "copy-guide — 📄 Copy entire '$tool' explanation & code sheet to clipboard" \
            "print — 🖨️ Keep explanation on screen & exit to shell prompt" \
            "launcher — 🧰 Open 'mytools' interactive file launcher" \
            "back — 🔙 Back to guide browser" | fzf --no-mouse --prompt="$tool > " --height=35% --layout=reverse --border=horizontal || true)
          case "${next_act%% *}" in
            copy) copy_recipe_menu "$tool" ;;
            copy-guide) copy_full_guide "$tool" ;;
            back) continue ;;
            launcher) exec "$SCRIPT_DIR/mytools" ;;
            *) exit 0 ;;
          esac
          ;;
      esac
    else
      break
    fi
  done
}

case "${1:-}" in
  preview)
    show_tool_help "${2:-overview}"
    ;;
  cheatsheet|cs|sheets)
    show_cheatsheet "${2:-all}"
    ;;
  -i|--interactive|guide)
    interactive_guide
    ;;
  -h|--help)
    show_overview
    ;;
  "")
    show_overview
    ;;
  *)
    show_tool_help "$1" "${2:-}"
    ;;
esac
