#!/usr/bin/env bash
set -euo pipefail
SOURCE_PATH="${BASH_SOURCE[0]}"; while [ -h "$SOURCE_PATH" ]; do SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; SOURCE_LINK="$(readlink "$SOURCE_PATH")"; case "$SOURCE_LINK" in /*) SOURCE_PATH="$SOURCE_LINK";; *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_LINK";; esac; done; SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"

PRESET="web"; OUTPUT_DIR=""; FORCE=0; DRY_RUN=0; FILES=()
usage() { cat <<'EOF'
Usage: media-optimize [options] <video...>

Presets: web (H.264 MP4, 1080p), social (H.264 MP4, 720p), archive (H.265 MP4).
Options: -p, --preset <name>  -o, --output-dir <dir>  -f, --force  -n, --dry-run
EOF
}
while [ "$#" -gt 0 ]; do case "$1" in
  -p|--preset) PRESET="${2:?$1 requires a value}"; shift 2;;
  -o|--output-dir) OUTPUT_DIR="${2:?$1 requires a value}"; shift 2;;
  -f|--force) FORCE=1; shift;; -n|--dry-run) DRY_RUN=1; shift;;
  -h|--help) usage; exit 0;; -*) echo "Unknown option: $1" >&2; exit 1;; *) FILES+=("$1"); shift;; esac; done
[ "${#FILES[@]}" -gt 0 ] || { usage >&2; exit 1; }
require_commands ffmpeg
case "$PRESET" in
  web) CODEC=libx264; CRF=23; SCALE=1920;;
  social) CODEC=libx264; CRF=25; SCALE=1280;;
  archive) CODEC=libx265; CRF=26; SCALE=0;;
  *) echo "Unknown preset '$PRESET'. Use web, social, or archive." >&2; exit 1;; esac
while IFS='=' read -r key value; do
  case "$key" in codec) CODEC="$value";; crf) CRF="$value";; width) SCALE="$value";; esac
done < <(load_preset "$PRESET" || true)
[[ "$CRF" =~ ^[0-9]+$ && "$SCALE" =~ ^[0-9]+$ ]] || { echo "Preset values must use numeric crf and width." >&2; exit 1; }
[ -z "$OUTPUT_DIR" ] || OUTPUT_DIR="$(ensure_output_dir "$OUTPUT_DIR")"
for input in "${FILES[@]}"; do
  [ -f "$input" ] || { echo "⚠️  Not a file: $input" >&2; continue; }
  base="$(basename "${input%.*}")"; out="${OUTPUT_DIR:-$(dirname "$input")}/${base}-${PRESET}.mp4"
  if [ "$DRY_RUN" -eq 1 ]; then echo "📝 Would create: $out"; continue; fi
  output_is_safe "$out" "$FORCE" || continue
  filters=(); [ "$SCALE" -gt 0 ] && filters=(-vf "scale='min($SCALE,iw)':-2")
  echo "▶️  $input → $out ($PRESET)"
  ffmpeg -hide_banner -loglevel error -stats -i "$input" "${filters[@]}" -c:v "$CODEC" -crf "$CRF" -preset medium -c:a aac -b:a 160k "$out"
done
notify "Optimization complete." "media-optimize"
