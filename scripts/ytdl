#!/usr/bin/env bash
set -euo pipefail
SOURCE_PATH="${BASH_SOURCE[0]}"; while [ -h "$SOURCE_PATH" ]; do SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; SOURCE_LINK="$(readlink "$SOURCE_PATH")"; case "$SOURCE_LINK" in /*) SOURCE_PATH="$SOURCE_LINK";; *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_LINK";; esac; done; SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; source "$SCRIPT_DIR/lib/common.sh"
FORMAT=""; DEST=""; PLAYLIST=0; SUBS=0; URL=""
usage() { cat <<'EOF'
Usage: ytdl [options] [url]
  -f, --format <mp4|webm|mp3|wav>  Select format without prompts
  -o, --output-dir <dir>            Download directory
  --playlist                        Allow a playlist (default: single item)
  --subtitles                       Download subtitles when available
EOF
}
while [ "$#" -gt 0 ]; do case "$1" in -f|--format) FORMAT="${2:?$1 requires a value}"; shift 2;; -o|--output-dir) DEST="${2:?$1 requires a value}"; shift 2;; --playlist) PLAYLIST=1; shift;; --subtitles) SUBS=1; shift;; -h|--help) usage; exit 0;; -*) echo "Unknown option: $1" >&2; exit 1;; *) [ -z "$URL" ] || { echo 'Only one URL can be supplied.' >&2; exit 1; }; URL="$1"; shift;; esac; done
require_commands yt-dlp
[ -n "$URL" ] || { URL="$(pbpaste 2>/dev/null || true)"; [[ "$URL" =~ ^https?:// ]] || read -r -p 'URL: ' URL; }
[[ "$URL" =~ ^https?:// ]] || { echo 'A valid http(s) URL is required.' >&2; exit 1; }
if [ -z "$FORMAT" ]; then FORMAT=$(printf '%s\n' mp4 webm mp3 wav | { command -v fzf >/dev/null && fzf --prompt='Format > ' || head -n 1; }); fi
[[ "$FORMAT" =~ ^(mp4|webm|mp3|wav)$ ]] || { echo 'Format must be mp4, webm, mp3, or wav.' >&2; exit 1; }
DEST="${DEST:-$PWD}"; DEST="$(ensure_output_dir "$DEST")"
ARGS=(--no-playlist -P "$DEST" --restrict-filenames); [ "$PLAYLIST" -eq 1 ] && ARGS=(--yes-playlist -P "$DEST" --restrict-filenames); [ "$SUBS" -eq 1 ] && ARGS+=(--write-subs --write-auto-subs)
case "$FORMAT" in mp4) ARGS+=(-f 'bv*+ba/b' --merge-output-format mp4);; webm) ARGS+=(-f 'bv*+ba/b' --merge-output-format webm);; mp3|wav) ARGS+=(-x --audio-format "$FORMAT");; esac
echo "🚀 Downloading $FORMAT to $DEST"; yt-dlp "${ARGS[@]}" "$URL"; notify 'Download completed.' 'ytdl'
