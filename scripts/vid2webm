#!/usr/bin/env bash
set -euo pipefail
SOURCE_PATH="${BASH_SOURCE[0]}"; while [ -h "$SOURCE_PATH" ]; do SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; SOURCE_LINK="$(readlink "$SOURCE_PATH")"; case "$SOURCE_LINK" in /*) SOURCE_PATH="$SOURCE_LINK";; *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_LINK";; esac; done; SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; source "$SCRIPT_DIR/lib/common.sh"
QUALITY=30; WIDTH=0; OUTPUT_DIR=""; FORCE=0; DRY_RUN=0; START=""; END=""; FILES=()
usage() { cat <<EOF
Usage: vid2webm [options] <video...>
Convert videos to VP9/Opus WebM.
  -q, --quality <0-63>  VP9 CRF (default: $QUALITY; lower is better)
  -w, --width <px>      Downscale to this maximum width
  -o, --output-dir <d>  Write files here
  --from <time>         Start at HH:MM:SS or seconds
  --to <time>           Stop at HH:MM:SS or seconds
  -f, --force           Overwrite existing output
  -n, --dry-run         Show planned outputs only
EOF
}
while [ "$#" -gt 0 ]; do case "$1" in
 -q|--quality) QUALITY="${2:?$1 requires a value}"; shift 2;; -w|--width) WIDTH="${2:?$1 requires a value}"; shift 2;;
 -o|--output-dir) OUTPUT_DIR="${2:?$1 requires a value}"; shift 2;; --from) START="${2:?$1 requires a value}"; shift 2;; --to) END="${2:?$1 requires a value}"; shift 2;;
 -f|--force) FORCE=1; shift;; -n|--dry-run) DRY_RUN=1; shift;; -h|--help) usage; exit 0;; -*) echo "Unknown option: $1" >&2; exit 1;; *) FILES+=("$1"); shift;; esac; done
[ "${#FILES[@]}" -gt 0 ] || { usage >&2; exit 1; }; [[ "$QUALITY" =~ ^[0-9]+$ ]] && [ "$QUALITY" -le 63 ] || { echo "Quality must be 0–63." >&2; exit 1; }
require_commands ffmpeg; [ -z "$OUTPUT_DIR" ] || OUTPUT_DIR="$(ensure_output_dir "$OUTPUT_DIR")"
for input in "${FILES[@]}"; do
 [ -f "$input" ] || { echo "⚠️  Not a file: $input" >&2; continue; }; out="${OUTPUT_DIR:-$(dirname "$input")}/$(basename "${input%.*}").webm"
 [ "$DRY_RUN" -eq 1 ] && { echo "📝 Would create: $out"; continue; }; output_is_safe "$out" "$FORCE" || continue
 args=(-hide_banner -loglevel error -stats); [ -n "$START" ] && args+=(-ss "$START"); args+=(-i "$input"); [ -n "$END" ] && args+=(-to "$END")
 [ "$WIDTH" -gt 0 ] && args+=(-vf "scale='min($WIDTH,iw)':-2"); args+=(-c:v libvpx-vp9 -crf "$QUALITY" -b:v 0 -c:a libopus "$out")
 echo "▶️  $input → $out"; ffmpeg "${args[@]}"
done
notify "WebM conversion complete." "vid2webm"
