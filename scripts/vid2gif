#!/bin/bash
set -euo pipefail

# ───────────────────────────────────────────────
# vid2gif — Convert video to optimized GIF
# ───────────────────────────────────────────────

WIDTH=800
FPS=15
OUTPUT_FILE=""
INPUT_FILE=""

usage() {
    cat <<EOF
Usage: vid2gif [options] <video_file>

Options:
  -w, --width <px>     GIF width in pixels, aspect ratio preserved (default: 800)
  -r, --fps <num>      Frame rate for the GIF (default: 15)
  -o, --output <file>  Custom output GIF file path
  -h, --help           Show this help

Examples:
  vid2gif screen_recording.mp4
  vid2gif -w 480 -r 10 demo.mov
  vid2gif -o optimized.gif demo.mov
EOF
}

# Parse arguments
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        -w|--width)
            if [[ "$2" =~ ^[0-9]+$ ]] && [ "$2" -gt 0 ]; then
                WIDTH="$2"
            else
                echo "❌ Error: width must be a positive number" >&2; exit 1
            fi
            shift 2 ;;
        -r|--fps)
            if [[ "$2" =~ ^[0-9]+$ ]] && [ "$2" -gt 0 ]; then
                FPS="$2"
            else
                echo "❌ Error: FPS must be a positive number" >&2; exit 1
            fi
            shift 2 ;;
        -o|--output)
            [[ -n "${2:-}" ]] || { echo "❌ Error: $1 requires an output file" >&2; exit 1; }
            OUTPUT_FILE="$2"
            shift 2 ;;
        -h|--help) usage; exit 0 ;;
        -*) echo "❌ Error: unknown option $1" >&2; usage >&2; exit 1 ;;
        *)
            if [ -n "$INPUT_FILE" ]; then
                echo "❌ Error: vid2gif only supports converting one video at a time." >&2; exit 1
            fi
            INPUT_FILE="$1"
            shift ;;
    esac
done

if [ -z "$INPUT_FILE" ]; then
    echo "❌ Error: No input video file specified." >&2
    usage >&2
    exit 1
fi

if [ ! -f "$INPUT_FILE" ]; then
    echo "❌ Error: Input video file not found: $INPUT_FILE" >&2
    exit 1
fi

# Resolve output path
if [ -z "$OUTPUT_FILE" ]; then
    OUTPUT_FILE="${INPUT_FILE%.*}.gif"
fi

echo "🎬 Converting video to optimized GIF..."
echo "   Input:  $INPUT_FILE"
echo "   Output: $OUTPUT_FILE"
echo "   Width:  ${WIDTH}px | FPS: $FPS"
echo ""

# Two-pass high quality palette generation & application
ffmpeg -hide_banner -loglevel error -stats -y -i "$INPUT_FILE" \
    -filter_complex "fps=$FPS,scale=$WIDTH:-1:flags=lanczos[x];[x]split[a][b];[a]palettegen[p];[b][p]paletteuse" \
    "$OUTPUT_FILE"

if [ $? -eq 0 ]; then
    echo ""
    echo "✅ Success: $OUTPUT_FILE"
    # Show output size
    if command -v du &>/dev/null; then
        echo "   Size: $(du -sh "$OUTPUT_FILE" | awk '{print $1}')"
    fi
    osascript -e "display notification \"Created GIF: $(basename "$OUTPUT_FILE")\" with title \"vid2gif Complete\"" 2>/dev/null || true
else
    echo ""
    echo "❌ Error: GIF conversion failed." >&2
    exit 1
fi
