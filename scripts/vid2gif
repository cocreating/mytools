#!/usr/bin/env bash
set -euo pipefail
SOURCE_PATH="${BASH_SOURCE[0]}"; while [ -h "$SOURCE_PATH" ]; do SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; SOURCE_LINK="$(readlink "$SOURCE_PATH")"; case "$SOURCE_LINK" in /*) SOURCE_PATH="$SOURCE_LINK";; *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_LINK";; esac; done; SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; source "$SCRIPT_DIR/lib/common.sh"
WIDTH=800; FPS=15; OUTPUT_DIR=""; FORCE=0; DRY_RUN=0; START=""; END=""; FILES=()
usage() { cat <<EOF
Usage: vid2gif [options] <video...>
  -w, --width <px>       Width (default: $WIDTH)
  -r, --fps <fps>        Frame rate (default: $FPS)
  -o, --output-dir <d>   Write files here
  --from <time> --to <time>  Trim the source
  -f, --force  -n, --dry-run
EOF
}
while [ "$#" -gt 0 ]; do case "$1" in -w|--width) WIDTH="${2:?$1 requires a value}"; shift 2;; -r|--fps) FPS="${2:?$1 requires a value}"; shift 2;; -o|--output-dir) OUTPUT_DIR="${2:?$1 requires a value}"; shift 2;; --from) START="${2:?$1 requires a value}"; shift 2;; --to) END="${2:?$1 requires a value}"; shift 2;; -f|--force) FORCE=1; shift;; -n|--dry-run) DRY_RUN=1; shift;; -h|--help) usage; exit 0;; -*) echo "Unknown option: $1" >&2; exit 1;; *) FILES+=("$1"); shift;; esac; done
[[ "$WIDTH" =~ ^[1-9][0-9]*$ && "$FPS" =~ ^[1-9][0-9]*$ ]] || { echo "Width and FPS must be positive integers." >&2; exit 1; }; [ "${#FILES[@]}" -gt 0 ] || { usage >&2; exit 1; }; require_commands ffmpeg
[ -z "$OUTPUT_DIR" ] || OUTPUT_DIR="$(ensure_output_dir "$OUTPUT_DIR")"
for input in "${FILES[@]}"; do [ -f "$input" ] || { echo "⚠️  Not a file: $input" >&2; continue; }; out="${OUTPUT_DIR:-$(dirname "$input")}/$(basename "${input%.*}").gif"; [ "$DRY_RUN" -eq 1 ] && { echo "📝 Would create: $out"; continue; }; output_is_safe "$out" "$FORCE" || continue; args=(-hide_banner -loglevel error -stats); [ -n "$START" ] && args+=(-ss "$START"); args+=(-i "$input"); [ -n "$END" ] && args+=(-to "$END"); args+=(-filter_complex "fps=$FPS,scale=$WIDTH:-1:flags=lanczos[x];[x]split[a][b];[a]palettegen[p];[b][p]paletteuse" "$out"); echo "▶️  $input → $out"; ffmpeg "${args[@]}"; done
notify "GIF creation complete." "vid2gif"
