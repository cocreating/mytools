#!/usr/bin/env bash
set -euo pipefail
SOURCE_PATH="${BASH_SOURCE[0]}"; while [ -h "$SOURCE_PATH" ]; do SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; SOURCE_LINK="$(readlink "$SOURCE_PATH")"; case "$SOURCE_LINK" in /*) SOURCE_PATH="$SOURCE_LINK";; *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_LINK";; esac; done; SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; source "$SCRIPT_DIR/lib/common.sh"

PERCENT=20; MODE="frames"; SEED=""; JITTER=0; GRAIN=0; FLASH=0; FILM_BURN=0; SCRATCHES=0; SUPER8=0
BPM=""; SILENCE_DB="-38"; KEEP_AUDIO=0; MUTE=0
OUTPUT_DIR=""; FORCE=0; DRY_RUN=0; START=""; END=""; FILES=(); INTERACTIVE=0

usage() { cat <<'EOF'
Usage: vidcuts [options] <video...>

Erase random frames, rhythmic beats, or silent pauses to create cut-film,
French New Wave jump-cut, or stop-motion aesthetics.

Options:
  -p, --percent <N>       Percentage of frames to cut out (1-90, default: 20)
  -m, --mode <mode>       Cut mode (default: frames):
                          • frames:  Erase random single frames (missing celluloid frames)
                          • jumps:   Excise micro-chunks (~0.2s jump cuts)
                          • stutter: Rapid 2-frame skips (projector chatter)
                          • freeze:  Drop frames & freeze-hold survivors (preserves original duration & audio!)
                          • beat:    Cut rhythmically in sync with BPM (--bpm or aubio auto-detect)
                          • silence: Auto-strip silent pauses (vlog / podcast jump-cut editor)
  -i, --interactive       Interactive wizard (guided mode) 🧙
  --bpm <N>               Target BPM for '--mode beat' (auto-detected if omitted)
  --threshold <dB>        Silence threshold in dB for '--mode silence' (default: -38)
  --seed <int>            Seed for random cut pattern (reproducible cuts)
  --keep-audio            Keep continuous original audio without cutting it (uses freeze-frame timing)

Celluloid & Analog Extras:
  --jitter                Add mechanical film projector gate weave/jitter
  --grain                 Add analog 16mm/35mm film grain
  --flash                 Add occasional white splice tape flashes
  --film-burn             Add warm orange/amber celluloid light-leak burn flashes
  --scratches             Add vertical 16mm film scratches
  --super8                Add dark Super-8 film gate border & optical vignette
  --mute                  Discard audio track from output

Trimming & Output:
  --from <time>           Start timestamp (e.g. 00:00:02)
  --to <time>             End timestamp (e.g. 00:00:10)
  -o, --output-dir <dir>  Write output files to this directory
  -f, --force             Overwrite existing output files
  -n, --dry-run           Show planned output files only
  -h, --help              Show help

Examples:
  vidcuts clip.mp4                                         # 20% random frame drops
  vidcuts -p 35 --mode jumps recording.mov                 # 35% shorter with chunk jump cuts
  vidcuts -p 40 --mode freeze --film-burn musicvideo.mp4   # stutter freeze-cuts keeping original song intact
  vidcuts --mode beat --bpm 128 --flash dance.mp4          # rhythmic cuts synced to 128 BPM
  vidcuts --mode silence interview.mp4                     # auto-remove dead air from talking head video
  vidcuts -p 20 --jitter --grain --scratches --super8 v.mp4 # full 16mm/Super-8 damaged film look
  vidcuts -i                                               # interactive guided wizard
EOF
}

interactive_wizard() {
  echo "🎞️ Welcome to the vidcuts interactive wizard!"
  echo "────────────────────────────────────────────"

  # Step 1: Input files with live ffprobe preview
  wizard_select_files "vidcuts" '\.(mp4|mov|avi|mkv|webm|m4v)$' "💡 [Tab] mark multiple video files • [Enter] confirm"

  # Step 2: Cut Style
  if command -v fzf &>/dev/null; then
    local m_choice
    m_choice=$(printf '%s\n' \
      'frames — ✂️ Random single-frame drops (missing celluloid frames)' \
      'jumps — 🎬 Micro-chunk jump cuts (~0.2s French New Wave cuts)' \
      'stutter — 📽️ 2-frame skips (mechanical projector chatter)' \
      'freeze — 🧊 Freeze-hold cuts (keeps original duration & continuous audio!)' \
      'beat — 🥁 BPM rhythmic cuts (synced to music tempo)' \
      'silence — 🎙️ Auto-strip silent pauses (vlogger / podcast jump cuts)' | fzf --prompt="Select cut mode > " --height=45% --layout=reverse --border || true)
    [ -n "$m_choice" ] && MODE="${m_choice%% *}"
  fi

  # Step 3: Mode-specific parameters
  if [ "$MODE" = "silence" ]; then
    if command -v fzf &>/dev/null; then
      local th_choice
      th_choice=$(printf '%s\n' \
        '-38 — 🎙️ Balanced speech threshold (-38dB, default)' \
        '-32 — ⚡ Aggressive pause removal (-32dB, loud studio)' \
        '-45 — 🤫 Gentle silence removal (-45dB, quiet room)' | fzf --prompt="Select silence threshold > " --height=35% --layout=reverse --border || true)
      [ -n "$th_choice" ] && SILENCE_DB="${th_choice%% *}"
    fi
  else
    if command -v fzf &>/dev/null; then
      local p_choice
      p_choice=$(printf '%s\n' \
        '20% — ✂️ Balanced cut film (default)' \
        '10% — 🎞️ Subtle missing frames' \
        '30% — 🎬 Energetic jump cuts' \
        '40% — 🔥 Heavy kinetic cuts' \
        '50% — ⚡ Frantic staccato cuts' \
        'Custom — ✍️ Enter custom percentage' | fzf --prompt="Select cut percentage > " --height=42% --layout=reverse --border || true)
      case "${p_choice%% *}" in
        10%) PERCENT=10;;
        20%) PERCENT=20;;
        30%) PERCENT=30;;
        40%) PERCENT=40;;
        50%) PERCENT=50;;
        Custom)
          printf "Enter cut percentage (1-90) [20]: "
          read -r custom_p
          PERCENT="${custom_p:-20}"
          ;;
      esac
    else
      printf "Enter percentage of frames to erase (1-90) [20]: "
      read -r p_in
      PERCENT="${p_in:-20}"
    fi
  fi

  if [ "$MODE" = "beat" ]; then
    if command -v fzf &>/dev/null; then
      local bpm_choice
      bpm_choice=$(printf '%s\n' \
        'auto — 🥁 Auto-detect BPM from audio track (aubio)' \
        '120 — 🎵 120 BPM (House / Pop standard)' \
        '128 — ⚡ 128 BPM (Club / Electro / Techno)' \
        '140 — 🔥 140 BPM (Trap / Dubstep / Fast)' \
        '90 — 🎧 90 BPM (Boom-bap / Lo-Fi Hip-Hop)' \
        'custom — ✍️ Enter custom BPM' | fzf --prompt="Select BPM > " --height=42% --layout=reverse --border || true)
      case "${bpm_choice%% *}" in
        auto|"") BPM="" ;;
        120|128|140|90) BPM="${bpm_choice%% *}" ;;
        custom)
          printf "Enter custom BPM: "
          read -r bpm_in
          [ -n "$bpm_in" ] && BPM="$bpm_in"
          ;;
      esac
    else
      printf "Enter BPM (or press Enter to auto-detect): "
      read -r bpm_in
      [ -n "$bpm_in" ] && BPM="$bpm_in"
    fi
  fi

  # Step 4: Multi-select Celluloid & Analog Extras via fzf
  if command -v fzf &>/dev/null; then
    local cell_extras
    cell_extras=$(printf '%s\n' \
      'none — ✅ Clean digital cuts (no film overlays)' \
      'jitter — 📽️ Mechanical film projector gate weave (--jitter)' \
      'grain — 🎞️ Analog 16mm/35mm film grain (--grain)' \
      'film-burn — 🔥 Warm orange/amber celluloid light-leak flashes (--film-burn)' \
      'flash — ⚡ White splice tape flashes (--flash)' \
      'scratches — 🎞️ Vertical 16mm film scratches (--scratches)' \
      'super8 — 🎥 Dark Super-8 film gate border & vignette (--super8)' \
      'keep-audio — 🎵 Keep continuous original audio (--keep-audio)' \
      'mute — 🔇 Mute audio track (--mute)' \
      'trim — ✂️ Trim start/end timestamps (--from / --to)' \
      'force — ⚡ Overwrite existing output (--force)' | fzf -m --prompt="Celluloid & audio extras ([Tab] multi-select) > " --height=55% --layout=reverse --border || true)
    if [ -n "$cell_extras" ]; then
      while IFS= read -r line; do
        case "${line%% *}" in
          jitter) JITTER=1 ;;
          grain) GRAIN=1 ;;
          film-burn) FILM_BURN=1 ;;
          flash) FLASH=1 ;;
          scratches) SCRATCHES=1 ;;
          super8) SUPER8=1 ;;
          keep-audio) KEEP_AUDIO=1 ;;
          mute) MUTE=1 ;;
          force) FORCE=1 ;;
          trim)
            printf "Start time (e.g. 00:00:02, or Enter for start): "
            read -r st_in; [ -n "$st_in" ] && START="$st_in"
            printf "End time (e.g. 00:00:10, or Enter for end): "
            read -r et_in; [ -n "$et_in" ] && END="$et_in"
            ;;
        esac
      done <<< "$cell_extras"
    fi
  fi

  local eq_cmd="vidcuts --mode $MODE"
  [ "$MODE" != "silence" ] && eq_cmd+=" -p $PERCENT"
  [ "$MODE" = "silence" ] && [ "$SILENCE_DB" != "-38" ] && eq_cmd+=" --threshold ${SILENCE_DB}dB"
  [ -n "$BPM" ] && eq_cmd+=" --bpm $BPM"
  [ "$KEEP_AUDIO" -eq 1 ] && [ "$MODE" != "freeze" ] && eq_cmd+=" --keep-audio"
  [ "$JITTER" -eq 1 ] && eq_cmd+=" --jitter"
  [ "$GRAIN" -eq 1 ] && eq_cmd+=" --grain"
  [ "$FLASH" -eq 1 ] && eq_cmd+=" --flash"
  [ "$FILM_BURN" -eq 1 ] && eq_cmd+=" --film-burn"
  [ "$SCRATCHES" -eq 1 ] && eq_cmd+=" --scratches"
  [ "$SUPER8" -eq 1 ] && eq_cmd+=" --super8"
  [ "$MUTE" -eq 1 ] && eq_cmd+=" --mute"
  [ -n "$START" ] && eq_cmd+=" --from $START"
  [ -n "$END" ] && eq_cmd+=" --to $END"
  [ "$FORCE" -eq 1 ] && eq_cmd+=" --force"
  [ -n "$OUTPUT_DIR" ] && eq_cmd+=" -o \"$OUTPUT_DIR\""
  for f in "${FILES[@]}"; do eq_cmd+=" \"$f\""; done

  wizard_confirm_and_run "vidcuts" "$eq_cmd" \
    "Files (${#FILES[@]})   : ${FILES[*]}" \
    "Cut Mode      : $MODE ($([ "$MODE" = "silence" ] && echo "threshold: ${SILENCE_DB}dB" || echo "${PERCENT}% erased"))" \
    "Celluloid FX  : jitter=$JITTER, grain=$GRAIN, film-burn=$FILM_BURN, scratches=$SCRATCHES, super8=$SUPER8" \
    "Audio         : $([ "$MUTE" -eq 1 ] && echo "Muted" || ([ "$KEEP_AUDIO" -eq 1 ] || [ "$MODE" = "freeze" ] && echo "Continuous (freeze-hold)" || echo "Trimmed in lockstep"))"
}

while [ "$#" -gt 0 ]; do case "$1" in
  -i|--interactive) INTERACTIVE=1; shift;;
  -p|--percent|--cut) PERCENT="${2:?$1 requires a value}"; shift 2;;
  -m|--mode) MODE="${2:?$1 requires a value}"; shift 2;;
  --bpm) BPM="${2:?$1 requires a value}"; shift 2;;
  --threshold) SILENCE_DB="${2:?$1 requires a value}"; SILENCE_DB="${SILENCE_DB%dB}"; shift 2;;
  --seed) SEED="${2:?$1 requires a value}"; shift 2;;
  --keep-audio|--preserve-duration) KEEP_AUDIO=1; shift;;
  --jitter) JITTER=1; shift;;
  --grain) GRAIN=1; shift;;
  --flash) FLASH=1; shift;;
  --film-burn|--burn) FILM_BURN=1; shift;;
  --scratches) SCRATCHES=1; shift;;
  --super8|--frame-border) SUPER8=1; shift;;
  --mute) MUTE=1; shift;;
  --from) START="${2:?$1 requires a value}"; shift 2;;
  --to) END="${2:?$1 requires a value}"; shift 2;;
  -o|--output-dir) OUTPUT_DIR="${2:?$1 requires a value}"; shift 2;;
  -f|--force) FORCE=1; shift;;
  -n|--dry-run) DRY_RUN=1; shift;;
  -h|--help) usage; exit 0;;
  -*) echo "Unknown option: $1" >&2; usage >&2; exit 1;;
  *) FILES+=("$1"); shift;;
esac; done

if [ "$INTERACTIVE" -eq 1 ] || { [ "${#FILES[@]}" -eq 0 ] && [ -t 0 ]; }; then
  interactive_wizard
fi

[ "${#FILES[@]}" -gt 0 ] || { usage >&2; exit 1; }
[[ "$PERCENT" =~ ^[0-9]+$ && "$PERCENT" -ge 1 && "$PERCENT" -le 90 ]] || {
  echo "Error: Cut percentage must be an integer between 1 and 90." >&2
  exit 1
}

require_commands ffmpeg ffprobe

# Set base frequency based on mode
case "$MODE" in
  frames)  FREQ=25 ;;
  jumps)   FREQ=6  ;;
  stutter) FREQ=12 ;;
  freeze)  FREQ=10; KEEP_AUDIO=1 ;;
  beat)    FREQ=8  ;;
  silence) FREQ=6  ;;
  *) echo "Unknown mode '$MODE'. Choose from: frames, jumps, stutter, freeze, beat, silence." >&2; exit 1 ;;
esac

# Generate reproducible or random seed
if [ -z "$SEED" ]; then
  SEED=$(( (RANDOM % 800) + 101 ))
fi

[ -z "$OUTPUT_DIR" ] || OUTPUT_DIR="$(ensure_output_dir "$OUTPUT_DIR")"

SUCCESS=0; FAILED=0; SKIPPED=0
for input in "${FILES[@]}"; do
  if [ ! -f "$input" ]; then
    echo "⚠️  Not a file: $input" >&2
    FAILED=$((FAILED + 1))
    continue
  fi

  base="$(basename "${input%.*}")"
  if [ "$MODE" = "silence" ]; then
    out="${OUTPUT_DIR:-$(dirname "$input")}/${base}-nosilence.mp4"
  elif [ "$MODE" = "freeze" ] || [ "$KEEP_AUDIO" -eq 1 ]; then
    out="${OUTPUT_DIR:-$(dirname "$input")}/${base}-freezecut${PERCENT}.mp4"
  else
    out="${OUTPUT_DIR:-$(dirname "$input")}/${base}-cut${PERCENT}.mp4"
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    echo "📝 Would create: $out (${PERCENT}% cut, mode: ${MODE})"
    continue
  fi

  if ! output_is_safe "$out" "$FORCE"; then
    SKIPPED=$((SKIPPED + 1))
    continue
  fi

  # Detect if input has an audio stream
  HAS_AUDIO=0
  if [ "$MUTE" -eq 0 ]; then
    AUDIO_STREAM=$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_type -of default=nw=1:nk=1 "$input" 2>/dev/null | head -n1 || true)
    [ "$AUDIO_STREAM" = "audio" ] && HAS_AUDIO=1
  fi

  # Determine effective FREQ for beat mode
  FILE_FREQ="$FREQ"
  if [ "$MODE" = "beat" ]; then
    DET_BPM="$BPM"
    if [ -z "$DET_BPM" ] && command -v aubio &>/dev/null && [ "$HAS_AUDIO" -eq 1 ]; then
      DET_BPM=$(aubio tempo "$input" 2>/dev/null | awk '{printf "%d", $1}' || true)
    fi
    [[ "$DET_BPM" =~ ^[0-9]+$ && "$DET_BPM" -gt 20 ]] || DET_BPM=120
    # Subdivide beat (4 cuts per beat)
    FILE_FREQ=$(awk -v b="$DET_BPM" 'BEGIN { f = int((b / 60.0) * 4.0 + 0.5); if (f < 2) f = 2; print f }')
    echo "🥁 Rhythm mode: ${DET_BPM} BPM (cut grid: ${FILE_FREQ} Hz)"
  fi

  SELECT_EXPR="gte(mod(floor(t*${FILE_FREQ})*${SEED}\\,100)\\,${PERCENT})"

  if [ "$MODE" = "silence" ] && [ "$HAS_AUDIO" -eq 1 ]; then
    echo "🎙️  Analyzing speech vs. silence in $input (threshold: ${SILENCE_DB}dB)..."
    orig_dur_probe=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$input" 2>/dev/null | head -n1 || echo "0")
    SIL_LOG=$(ffmpeg -hide_banner -i "$input" -af "silencedetect=n=${SILENCE_DB}dB:d=0.35" -f null - 2>&1 || true)
    BETWEEN_EXPR=$(printf '%s\n' "$SIL_LOG" | awk -v tot="$orig_dur_probe" '
      BEGIN { cur = 0.0; count = 0; expr = "" }
      /silence_start:/ {
        for (i=1; i<=NF; i++) if ($i == "silence_start:") s = $(i+1) + 0.0;
        if (s - cur > 0.08) {
          if (count > 0) expr = expr "+";
          expr = expr sprintf("between(t\\,%.3f\\,%.3f)", cur, s);
          count++;
        }
      }
      /silence_end:/ {
        for (i=1; i<=NF; i++) if ($i == "silence_end:") cur = $(i+1) + 0.0;
      }
      END {
        if (tot + 0.0 > cur + 0.08 && count > 0) {
          expr = expr sprintf("+between(t\\,%.3f\\,%.3f)", cur, tot);
        }
        if (count > 0 && length(expr) < 3500) print expr;
      }
    ')
    if [ -n "$BETWEEN_EXPR" ]; then
      SELECT_EXPR="$BETWEEN_EXPR"
    else
      echo "ℹ️  No distinct silent pauses detected (or clip is continuous); applying micro jump-cuts."
    fi
  fi

  # Build video filter chain
  if [ "$KEEP_AUDIO" -eq 1 ]; then
    # Freeze-cut mode: drop frames but preserve PTS timeline and resample back to smooth container FPS
    VF="select=${SELECT_EXPR},fps=30"
  else
    VF="select=${SELECT_EXPR},setpts=N/FRAME_RATE/TB"
  fi

  if [ "$FLASH" -eq 1 ]; then
    VF="${VF},drawbox=t=fill:c=white@0.85:enable=gt(random(2)\\,0.96)"
  fi
  if [ "$FILM_BURN" -eq 1 ]; then
    VF="${VF},drawbox=t=fill:c=0xFF6A00@0.58:enable=gt(random(3)\\,0.94)"
  fi
  if [ "$SCRATCHES" -eq 1 ]; then
    VF="${VF},drawbox=x=mod(floor(t*43)*137\\,iw):y=0:w=2:h=ih:c=white@0.42:t=fill:enable=gt(random(1)\\,0.62)"
  fi
  if [ "$JITTER" -eq 1 ]; then
    VF="${VF},pad=in_w:in_h+8:0:4:black,crop=in_w:in_h-8:0:trunc(abs(sin(n*1.3))*4)"
  fi
  if [ "$GRAIN" -eq 1 ]; then
    VF="${VF},noise=alls=10:allf=t+u"
  fi
  if [ "$SUPER8" -eq 1 ]; then
    VF="${VF},vignette=PI/3.5,drawbox=x=0:y=0:w=iw:h=ih:c=black:t=12"
  fi
  VF="${VF},format=yuv420p"

  args=(-hide_banner -loglevel error -stats)
  [ -n "$START" ] && args+=(-ss "$START")
  args+=(-i "$input")
  [ -n "$END" ] && args+=(-to "$END")

  if [ "$HAS_AUDIO" -eq 1 ]; then
    if [ "$KEEP_AUDIO" -eq 1 ]; then
      args+=(-vf "$VF" -c:v libx264 -crf 20 -preset medium -c:a aac -b:a 192k)
    else
      AF="aselect=${SELECT_EXPR},asetpts=N/SR/TB"
      args+=(-filter_complex "[0:v]${VF}[v];[0:a]${AF}[a]" -map "[v]" -map "[a]" -c:v libx264 -crf 20 -preset medium -c:a aac -b:a 192k)
    fi
  else
    args+=(-vf "$VF" -c:v libx264 -crf 20 -preset medium -an)
  fi
  args+=("$out")

  echo "▶️  $input → $out (mode: ${MODE})"
  if ffmpeg "${args[@]}"; then
    orig_dur=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$input" 2>/dev/null || true)
    new_dur=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$out" 2>/dev/null || true)
    if [ -n "$orig_dur" ] && [ -n "$new_dur" ]; then
      printf "   ⏱️  Duration: %.1fs → %.1fs\n" "$orig_dur" "$new_dur"
    fi
    SUCCESS=$((SUCCESS + 1))
  else
    FAILED=$((FAILED + 1))
  fi
done

if [ "$DRY_RUN" -eq 0 ]; then
  echo "✅ Done: $SUCCESS video(s) cut, $FAILED failed, $SKIPPED skipped"
  [ "$SUCCESS" -eq 0 ] || notify "Cut $SUCCESS video(s) ($MODE)." "vidcuts"
fi
exit "$FAILED"
