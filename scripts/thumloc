#!/bin/bash
set -euo pipefail

TARGET_PATH=""
FORCE=0
TIMEOUT_SECONDS="${SETWEBLOCTHUMB_TIMEOUT_SECONDS:-90}"

usage() {
    cat <<EOF
Usage: thumloc [options] [path]

Recursively generates Finder thumbnails for macOS .webloc internet bookmarks.

Options:
  -f, --force            Regenerate all thumbnails, even if they already exist
  --timeout <seconds>    Set process timeout (default: 90)
  -h, --help             Show this help message

Examples:
  thumloc
  thumloc -f
  thumloc ~/Downloads
EOF
}

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        -f|--force)
            FORCE=1
            shift
            ;;
        --timeout)
            if [[ "${2:-}" == "" ]]; then
                echo "error: --timeout requires seconds" >&2
                exit 1
            fi
            TIMEOUT_SECONDS="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "error: unknown option $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            if [ -n "$TARGET_PATH" ]; then
                echo "error: only one path can be provided." >&2
                exit 1
            fi
            TARGET_PATH="$1"
            shift
            ;;
    esac
done

# Default to current directory
TARGET_PATH="${TARGET_PATH:-$PWD}"

if [[ ! -d "$TARGET_PATH" ]]; then
    echo "error: path does not exist or is not a directory: $TARGET_PATH" >&2
    exit 1
fi

if ! command -v setWeblocThumb &>/dev/null; then
    echo "error: setWeblocThumb is not installed or available in PATH" >&2
    echo "Install it with: brew install setweblocthumb" >&2
    exit 1
fi

THUMBLOC_RUNNER="$HOME/Library/Application Support/setWeblocThumb/bin/thumbnail-weblocs-recursive.sh"
if [[ ! -x "$THUMBLOC_RUNNER" ]]; then
    echo "error: recursive Webloc runner not found: $THUMBLOC_RUNNER" >&2
    echo "Run the setWeblocThumb repair script first." >&2
    exit 1
fi

STATE_DIR="$HOME/Library/Application Support/setWeblocThumb/state/manual-cache"

echo "Running thumloc on: $TARGET_PATH"
SETWEBLOCTHUMB_FORCE="$FORCE" \
SETWEBLOCTHUMB_TIMEOUT_SECONDS="$TIMEOUT_SECONDS" \
SETWEBLOCTHUMB_STATE_DIR="$STATE_DIR" \
"$THUMBLOC_RUNNER" "$TARGET_PATH"
