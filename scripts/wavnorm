#!/usr/bin/env bash
set -euo pipefail
SOURCE_PATH="${BASH_SOURCE[0]}"; while [ -h "$SOURCE_PATH" ]; do SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; SOURCE_LINK="$(readlink "$SOURCE_PATH")"; case "$SOURCE_LINK" in /*) SOURCE_PATH="$SOURCE_LINK";; *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_LINK";; esac; done; SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"; source "$SCRIPT_DIR/lib/common.sh"

LUFS="-14"; PEAK=""; OUTPUT_DIR=""; FORCE=0; DRY_RUN=0; FILES=()
FORMAT="wav"; BITRATE=192; FORMAT_SET=0
usage() { cat <<'EOF'
Usage: wavnorm [options] <file.wav> [file.wav ...]

Normalize the volume of one or more WAV files using LUFS loudness or Peak dBFS.

  -l, --lufs <n>          Target integrated LUFS (default: -14)
  -p, --peak <n>          Peak normalize to peak dBFS (e.g. 0, -1)
  -m, --mp3               Output as MP3 instead of WAV
  --format <wav|mp3>      Output format (default: wav)
  -b, --bitrate <kbps>    MP3 bitrate in kbps (default: 192)
  -o, --output-dir <dir>  Write output files to this directory
  -f, --force             Overwrite existing output files
  -n, --dry-run           Show planned output files only
  -h, --help              Show help

Examples:
  wavnorm podcast.wav
  wavnorm -m podcast.wav
  wavnorm --lufs -16 interview.wav
  wavnorm --peak 0 master.wav
  wavnorm -l -14 -o ./normalized *.wav
EOF
}
while [ "$#" -gt 0 ]; do case "$1" in
  -l|--lufs) LUFS="${2:?$1 requires a value}"; shift 2;;
  -p|--peak) PEAK="${2:?$1 requires a value}"; shift 2;;
  -m|--mp3) FORMAT="mp3"; FORMAT_SET=1; shift;;
  --format) FORMAT="${2:?$1 requires a value}"; FORMAT_SET=1; shift 2;;
  -b|--bitrate) BITRATE="${2:?$1 requires a value}"; [ "$FORMAT_SET" -eq 0 ] && FORMAT="mp3"; shift 2;;
  -o|--output-dir) OUTPUT_DIR="${2:?$1 requires a value}"; shift 2;;
  -f|--force) FORCE=1; shift;; -n|--dry-run) DRY_RUN=1; shift;;
  -h|--help) usage; exit 0;; -*) echo "Unknown option: $1" >&2; usage >&2; exit 1;;
  *) FILES+=("$1"); shift;;
esac; done
[ "${#FILES[@]}" -gt 0 ] || { usage >&2; exit 1; }
[[ "$FORMAT" =~ ^(wav|mp3)$ ]] || { echo "Format must be wav or mp3." >&2; exit 1; }
[[ "$BITRATE" =~ ^[0-9]+$ ]] || { echo "Bitrate must be numeric." >&2; exit 1; }
LUFS="${LUFS//,/.}"
[ -z "$PEAK" ] || PEAK="${PEAK//,/.}"
require_commands ffmpeg

[ -z "$OUTPUT_DIR" ] || OUTPUT_DIR="$(ensure_output_dir "$OUTPUT_DIR")"
SUCCESS=0; FAILED=0; SKIPPED=0
for input in "${FILES[@]}"; do
  if [ ! -f "$input" ]; then echo "⚠️  Not a file: $input" >&2; FAILED=$((FAILED + 1)); continue; fi
  [[ "${input##*.}" =~ ^([Ww][Aa][Vv])$ ]] || { echo "⚠️  Not a WAV file: $input" >&2; FAILED=$((FAILED + 1)); continue; }

  if [ -n "$PEAK" ]; then
    MAX_VOL="$(ffmpeg -hide_banner -i "$input" -af volumedetect -f null /dev/null 2>&1 | awk '/max_volume:/ { print $5 }' || echo "0")"
    GAIN="$(awk -v peak="$PEAK" -v maxvol="$MAX_VOL" 'BEGIN { printf "%.2f", peak - maxvol }')"
    FILTERS="volume=${GAIN}dB"
    TAG="norm-${PEAK}dB-peak"
    DESC="Peak normalization (${GAIN} dB adjustment to ${PEAK} dBFS)"
  else
    FILTERS="loudnorm=I=${LUFS}:LRA=11:TP=-1.5"
    TAG="norm-${LUFS}lufs"
    DESC="Loudness normalization (${LUFS} LUFS)"
  fi

  output="${OUTPUT_DIR:-$(dirname "$input")}/$(basename "${input%.*}")-${TAG}.$FORMAT"
  if [ "$DRY_RUN" -eq 1 ]; then echo "📝 Would create: $output ($DESC)"; continue; fi
  if ! output_is_safe "$output" "$FORCE"; then SKIPPED=$((SKIPPED + 1)); continue; fi
  echo "▶️  $input → $output ($DESC)"
  if [ "$FORMAT" = "mp3" ]; then
    if ffmpeg -hide_banner -loglevel error -stats -i "$input" -af "$FILTERS" -c:a libmp3lame -b:a "${BITRATE}k" "$output"; then SUCCESS=$((SUCCESS + 1)); else FAILED=$((FAILED + 1)); fi
  else
    if ffmpeg -hide_banner -loglevel error -stats -i "$input" -af "$FILTERS" -c:a pcm_s16le "$output"; then SUCCESS=$((SUCCESS + 1)); else FAILED=$((FAILED + 1)); fi
  fi
done
echo "✅ Done: $SUCCESS normalized, $FAILED failed, $SKIPPED skipped"
[ "$SUCCESS" -eq 0 ] || notify "Normalized $SUCCESS file(s)." 'wavnorm'
exit "$FAILED"
